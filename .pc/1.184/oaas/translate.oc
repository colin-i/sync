function translate_two(ss start,ss in)
	ss oa;set oa spcfull(in)
	ss cursor;ss pointer
	ss ?chr;set chr oa#
	if chr=(postpone_char)
		return start
	end
	if chr=(b_low)
		inc oa
		set cursor translate_buttonmode(start,oa)
		if cursor!=start;return cursor;end
	elseif chr=(arracc_char)
		set cursor translate_childbyname(start)
		if cursor!=start
			inc oa
			set cursor translate_two_switch(oa,cursor)
			if cursor!=oa
				return cursor
			end
		end
	elseif chr=(evfunc_char)
		set cursor translate_eparam(start)
		if cursor!=start
			inc oa
			set cursor translate_two_switch(oa,cursor)
			if cursor!=oa
				return cursor
			end
		end
	elseif chr=(func_char)
		set cursor translate_function(start)
		if cursor!=start
			inc oa
			set cursor translate_two_switch(oa,cursor)
			if cursor!=oa
				return cursor
			end
		end
	elseif chr=(vartype_char)
		set pointer translate_two_switchBefore(#oa)
		set cursor translate_give(start,oa)
		set cursor translate_two_switchAfter(cursor,oa,pointer) #here is not required the comparison, is inside
		if cursor!=oa
			return cursor
		end
	elseif chr=(alpha_char)
		set cursor translate_alpha(start)
		if cursor!=start
			inc oa
			set cursor translate_two_switch(oa,cursor)
			if cursor!=oa
				return cursor
			end
		end
	elseif chr=(childcast_char)
		set cursor translate_childcast(start)
		if cursor!=start
			inc oa
			set cursor translate_two_switch(oa,cursor)
			if cursor!=oa
				return cursor
			end
		end
	elseif chr=(align_char)
		set cursor translate_textformat(start)
		if cursor!=start
			inc oa
			set cursor translate_two_switch(oa,cursor)
			if cursor!=oa
				return cursor
			end
		end
	elseif chr=(compare_char)
		set cursor translate_compare(start)
		if cursor!=start
			inc oa
			set cursor translate_two_switch(oa,cursor)
			if cursor!=oa
				return cursor
			end
		end
	elseif chr=(fill_char)
		set pointer translate_two_switchBefore_orZero(#oa)
		set cursor translate_fill(start,oa)
		set cursor translate_two_switchAfter_orZero(cursor,oa,pointer) #here is not required the comparison, is inside
		if cursor!=oa
			return cursor
		end
	elseif chr=(bitmap_char)
		set pointer translate_two_switchBefore_orZero(#oa)
		set cursor translate_bitmap(start,oa)
		set cursor translate_two_switchAfter_orZero(cursor,oa,pointer) #here is not required the comparison, is inside
		if cursor!=oa
			return cursor
		end
	elseif chr=(new_char)
		set cursor translate_new(start)
		if cursor!=start
			inc oa
			set cursor translate_two_switch(oa,cursor)
			if cursor!=oa
				return cursor
			end
		end
	elseif chr=(onev_char)
		set pointer translate_two_switchBefore_orZero(#oa)
		set cursor translate_oneve(start,oa) #here is not required the comparison, is inside
		set cursor translate_two_switchAfter_orZero(cursor,oa,pointer)
		if cursor!=oa
			return cursor
		end
	elseif chr=(oreplace_char)
		set pointer translate_two_switchBefore_orZero(#oa)
		set cursor translate_object(start,oa) #here is not required the comparison, is inside
		set cursor translate_two_switchAfter_orZero(cursor,oa,pointer)
		if cursor!=oa
			return cursor
		end
	elseif chr=(rect_char)
		set pointer translate_two_switchBefore_orZero(#oa)
		set cursor translate_rect(start,oa)
		set cursor translate_two_switchAfter_orZero(cursor,oa,pointer) #here is not required the comparison, is inside
		if cursor!=oa
			return cursor
		end
	elseif chr=(search_char)
		inc oa
		set cursor translate_srch(start,oa)
		if cursor!=oa;return cursor;end
	elseif chr=(text_char)
		set cursor translate_textfield(start)
		if cursor!=start
			inc oa
			set cursor translate_two_switch(oa,cursor)
			if cursor!=oa
				return cursor
			end
		end
	elseif chr=(arrconstr_char)
		set pointer translate_two_switchBefore_orZero(#oa)
		set cursor translate_arrayconstructor_full(start,oa)
		set cursor translate_two_switchAfter_orZero(cursor,oa,pointer) #here is not required the comparison, is inside
		if cursor!=oa
			return cursor
		end
	elseif chr=(var_char)
		set pointer translate_two_switchBefore_orZero(#oa)
		set cursor translate_var_full(start,oa,(var_char))
		set cursor translate_two_switchAfter_orZero(cursor,oa,pointer) #here is not required the comparison, is inside
		if cursor!=oa
			return cursor
		end
	elseif chr=(Var_char)
		set pointer translate_two_switchBefore_orZero(#oa)
		set cursor translate_var_full(start,oa,(Var_char))
		set cursor translate_two_switchAfter_orZero(cursor,oa,pointer) #here is not required the comparison, is inside
		if cursor!=oa
			return cursor
		end
	elseif chr=(nvar_char)
		set pointer translate_two_switchBefore_orZero(#oa)
		set cursor translate_var_full(start,oa,(nvar_char))
		set cursor translate_two_switchAfter_orZero(cursor,oa,pointer) #here is not required the comparison, is inside
		if cursor!=oa
			return cursor
		end
	elseif chr=(nVar_char)
		set pointer translate_two_switchBefore_orZero(#oa)
		set cursor translate_var_full(start,oa,(nVar_char))
		set cursor translate_two_switchAfter_orZero(cursor,oa,pointer) #here is not required the comparison, is inside
		if cursor!=oa
			return cursor
		end
	elseif chr=(x_low)
		set cursor translate_unshift(start,globalt.sttic,"Static")
		if cursor!=start
			inc oa
			set cursor translate_two_switch(oa,cursor)
			if cursor!=oa
				return cursor
			end
		end
	elseif chr=(insert_char)
		set pointer translate_two_switchBefore(#oa)
		set cursor translate_insert(start,oa) #here is not required the comparison, is inside
		set cursor translate_two_switchAfter(cursor,oa,pointer)
		if cursor!=oa
			return cursor
		end
	elseif chr=(Nullchar)
		ss mem;set mem strdup(start) #must remember that start is touched in calls #set cursor fn(mem,oa) is not yet through otoc

set cursor translate_buttonmode(mem,(NULL))
if cursor=mem

call strcpy(mem,start)
set cursor translate_childbyname(mem)
if cursor=mem

call strcpy(mem,start)
set cursor translate_function(mem)
if cursor=mem

call strcpy(mem,start)
set cursor translate_alpha(mem)
if cursor=mem

call strcpy(mem,start)
set cursor translate_childcast(mem)
if cursor=mem

call strcpy(mem,start)
set cursor translate_fill(mem,#globalt.blank)
if cursor=#globalt.blank

call strcpy(mem,start)
set cursor translate_eparam(mem) #conflict: translate_fill
if cursor=mem

call strcpy(mem,start)
set cursor translate_textformat(mem)
if cursor=mem

call strcpy(mem,start)
set cursor translate_oneve(mem,#globalt.blank)
if cursor=#globalt.blank

call strcpy(mem,start)
set cursor translate_rect(mem,#globalt.blank)
if cursor=#globalt.blank

call strcpy(mem,start)
set cursor translate_srch_all(mem)
if cursor=mem

call strcpy(mem,start)
set cursor translate_textfield(mem)
if cursor=mem

call strcpy(mem,start)
set cursor translate_arrayconstructor_full(mem,#globalt.blank)
if cursor=#globalt.blank

call strcpy(mem,start)
set cursor translate_bitmap(mem,#globalt.blank) #conflicts: u(translate_arrayconstructor)
if cursor=#globalt.blank

call strcpy(mem,start)
set cursor translate_var_simple(mem,(var_char))
if cursor=mem

call strcpy(mem,start)
set cursor translate_compare(mem) #conflicts at test: t(translate_textfield), w(translate_var_simple)
if cursor=mem

call strcpy(mem,start)
set cursor translate_new(mem) #conflicts: all

end;end;end;end;end;end;end;end;end;end;end;end;end;end;end;end

		call free(mem)
		if cursor!=mem;return cursor;end
	end
	return in
end
function translate_two_switch(ss oa,ss cursor)
	if oa#=(Nullchar)
		return cursor
	end
	if oa#=(switch_char)
		callret translate_two_switcher(oa)
	end
	return oa
end
function translate_two_switcher(ss oa)
	inc oa
	ss page;set page switch_page()
	set page translate_two(page,oa)
	if page!=oa
		return page
	end
	dec oa
	return oa
end
function translate_two_switchBefore(sv _oa)
	ss oa
	set oa _oa#
	inc oa
	set oa spcfull(oa)
	ss pointer
	set pointer pluson(oa)
	if pointer!=oa
		set pointer# (Nullchar)
	end
	set _oa# oa
	return pointer
end
function translate_two_switchAfter(ss cursor,ss oa,ss pointer)
	if pointer!=oa
		if cursor!=oa
			set cursor translate_two_switcher(pointer)
			if cursor!=pointer
				return cursor
			end
		end
		set pointer# (switch_char) #this was set short time outside of this function
	else
		if cursor!=oa
			return cursor
		end
	end
	return oa
end
function translate_two_switchBefore_orZero(sv _oa)
	ss oa
	set oa _oa#
	inc oa
	set oa spcfull(oa)
	ss pointer
	set pointer strchr(oa,(Plus))
	if pointer!=(Nullchar)
		set pointer# (Nullchar)
	end
	set _oa# oa
	return pointer
end
function translate_two_switchAfter_orZero(ss cursor,ss oa,ss pointer)
	if pointer!=(Nullchar)
		if cursor!=oa
			set cursor translate_two_switcher(pointer)
			if cursor!=pointer
				return cursor
			end
		end
		set pointer# (switch_char)
	else
		if cursor!=oa
			return cursor
		end
	end
	return oa
end
function translate_unshift(ss start,ss value,ss onOk)
	ss cursor
	set cursor spcfull(start)
	ss ?reminder
	set reminder cursor#
	char a#2;ss b^a
	if reminder!=(Nullchar)
		set cursor# (Nullchar)
		inc cursor
		set b# reminder
		inc b
	end
	set b# (Nullchar)
	sd ?len;set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s %s%s",start,value,#a,cursor)
	if len>0
		if len<(a_page_size)
			call translated(onOk)
			return globalt.a_page_switch
		end
	end
	return start
end

function translate_arrayconstructor_full(ss start,ss oa)
	char predefined="=new Array(";
	ss cursor
	set cursor strstr(start,#predefined)
	if cursor!=(NULL)
		ss pointer
		set pointer cursor
		add pointer \.predefined-1
		ss end
		set end strrchr(pointer,(Closeparenthesis))
		if end!=(NULL)
			set cursor# (Nullchar)
			set end# (Nullchar)
			inc end
			ss more1;ss more2
			if oa#!=(Nullchar)
			#:Array<Dynamic>? only when: 2: Arrays of mixed types are only allowed if the type is forced to Array<Dynamic>
				set more1 ":Array<"
				set more2 ">"
			else
				set more1 #globalt.blank
				set more2 #globalt.blank
			end
			sd ?len
			set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s%s%s=[%s]%s",start,more1,oa,more2,pointer,end)
			if len>0
				if len<(a_page_size)
					call translated("ArrayConstructor")
					return globalt.a_page_switch
				end
			end
		end
	end
	return oa
end

function translate_buttonmode(ss indents,ss oa) #cannot postpone when no error
	ss cursor;set cursor spcfull(indents)
	sd ?c
	char against="useHandCursor="
	set c strncmp(cursor,#against,14)
	if c=0
		set cursor# (Nullchar)
		add cursor 14
		ss pointer
		sd ?len
		set pointer globalt.a_page_switch
		sd ?size;set size (a_page_size)
		set len snprintf(pointer,size,"%sbuttonMode=%s%s%s",indents,cursor,#against,cursor)
		if len>0
			if len<(a_page_size)
				ss ok="ButtonMode"
				whiletrue
					if oa=(NULL)
						break
					end
					if oa#=(Nullchar)
						break
					end
					#here is not always wanted to be if there are no children inside, or if disabling the button
					if oa#=(m_low) #is set once to make it look like a button
						inc oa
						add pointer len
						sub size len
						set len snprintf(pointer,size,"mouseChildren=false;")
						if len<0
							return indents
						end
						if len>=size
							return indents
						end
					end
					if oa#=(switch_char)
						call translated(ok)
						set cursor translate_two_switcher(oa)
						if cursor!=oa
							return cursor
						end
						return indents
					end
					break
				end
				call translated(ok)
				return globalt.a_page_switch
			end
		end
	end
	return indents
end

function translate_childbyname(ss start)
	ss cursor
	set cursor bracketoon(start)
	if cursor!=start
		ss pointer
		set pointer bracketcon(cursor)
		if pointer!=cursor
			set cursor# (Nullchar)
			set pointer# (Nullchar)
			inc cursor
			inc pointer
			sd ?len
			set len snprintf(globalt.a_page_switch,(a_page_size),"%s.%s(%s)%s",start,globalt.getChildByName,cursor,pointer)
			if len>0
				if len<(a_page_size)
					call translated("ChildByName")
					return globalt.a_page_switch
				end
			end
		end
	end
	return start
end

function translate_eparam(ss start)
	ss str="()"
	ss p;set p strstr(start,str)
	if p!=(NULL)
		set p# (Nullchar)
		inc p
		sd ?len;set len snprintf(globalt.a_page_switch,(a_page_size),"%s(e%s",start,p)
		#set p# '('
		if len>0
			if len<(a_page_size)
				call translated("Event")
				return globalt.a_page_switch
			end
		end
	end
	return start
end

function translate_function(ss indents)
	ss cursor
	set cursor spcfull(indents)
	sd ?c
	set c strncmp(cursor,#globalt.func,\globalt.func-1)
	if c=0
		set cursor# (Nullchar)
		add cursor \globalt.func-1
		ss pointer
		set pointer spcfull(cursor)
		if pointer!=cursor
			ss ?a
			set a var_advance(pointer,#cursor)
			sd ?len
			svu ?sz;set sz cursor
			sub sz pointer
			whiletrue
				if sz=\globalt.nw-1
					set c memcmp(pointer,#globalt.nw,\globalt.nw-1)
					if c=0
						set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s %s %s%s",indents,globalt.public,#globalt.func,pointer,globalt.super)
						break
					end
				end
				if a!=(Nullchar)
					set cursor# (Nullchar)
					inc cursor
					set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s %s{%s %s %s%c%s",indents,globalt.class,pointer,globalt.public,#globalt.func,#globalt.nw,a,cursor)
				else
					set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s %s{%s %s %s",indents,globalt.class,pointer,globalt.public,#globalt.func,#globalt.nw)
				end
				break
			end
			if len>0
				if len<(a_page_size)
					call translated("FunctionMorph")
					return globalt.a_page_switch
				end
			end
		end
	end
	return indents
end

function translate_give(ss indents,ss name) #cannot postpone when no error
	if name#!=(Nullchar)
		ss cursor
		set cursor semicolon(indents)
		if cursor!=indents
			set cursor# (Nullchar)
			inc cursor
			char ar="Array"
			sd ?c
			set c strcmp(name,#ar,\.ar)
			sd ?len
			ss type
			if c=0
				set type "<Dynamic>"
			else
				set type #globalt.blank
			end
			set len snprintf(globalt.a_page_switch,(a_page_size),"%s:%s%s%c%s",indents,name,type,(Semicolon),cursor)
			if len>0
				if len<(a_page_size)
					call translated("Give")
					return globalt.a_page_switch
				end
			end
		end
	end
	return name
end

function translate_alpha(ss indents)
	ss cursor;set cursor spcfull(indents)
	set cursor# (Nullchar)
	inc cursor
	sd ?c
	ss sizer=6
	char against="alpha="^
	set c strncmp(cursor,#against,sizer)
	if c=0
		add sizer cursor
		ss pointer
		set pointer semicolon(sizer)
		if pointer!=sizer
			set pointer# (Nullchar)
			inc pointer
			sd ?len
			set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s/100;%s",indents,cursor,pointer)
			if len>0
				if len<(a_page_size)
					call translated("Alpha")
					return globalt.a_page_switch
				end
			end
		end
	end
	return indents
end

function translate_childcast(ss indents)
	ss cursor;set cursor spcfull(indents)
	whiletrue
		ss pointer
		set pointer strstr(cursor,globalt.getChildByName)
		if pointer=(NULL)
			set pointer strstr(cursor,globalt.addChild)
			if pointer=(NULL)
				break
			end
		end
		dec pointer
		if pointer#=(Period)
			ss ?rem
			set rem cursor#
			set cursor# (Nullchar)
			inc cursor
			set pointer# (Nullchar)
			inc pointer
			sd ?len
			set len snprintf(globalt.a_page_switch,(a_page_size),"%scast(%c%s,flash.display.DisplayObjectContainer).%s",indents,rem,cursor,pointer)
			if len>0
				if len<(a_page_size)
					call translated("ChildCast")
					return globalt.a_page_switch
				end
			end
		end
		break
	end
	return indents
end

function translate_compare(ss start)
	ss cursor
	set cursor pareoafter(start)
	if cursor!=start
		ss end
		set end strchr(cursor,(Nullchar))
		whiletrue
			dec end
			if end=cursor
				break
			end
			if end#=(Closeparenthesis)
				set end# (Nullchar)
				inc end
				sd ?len
				if cursor#=(Exclamationmark)
					set cursor# (Nullchar)
					inc cursor
					set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s==0%c%s",start,cursor,(Closeparenthesis),end)
				else
					set len snprintf(globalt.a_page_switch,(a_page_size),"%s!=0%c%s",start,(Closeparenthesis),end)
				end
				if len>0
					if len<(a_page_size)
						call translated("Compare")
						return globalt.a_page_switch
					end
				end
				break
			end
		end
	end
	return start
end

function translate_fill(ss indents,ss name)
	ss cursor;set cursor spcfull(indents)
	if name#=(Nullchar)
		whiletrue
			ss pointer
			set pointer pareoon(cursor)
			if pointer!=cursor
				ss dotp
				set dotp dotbackafter(cursor,pointer)
				if dotp!=pointer
					set cursor dotp
				end
				break
			end
			return name
		end
	end
	ss ?chr;set chr cursor#
	whiletrue
		if chr!=(b_low)
			if chr!=(e_low)
				break
			end
		end
		set cursor# (Nullchar)
		inc cursor
		sd ?len
		if name#=(Nullchar)
			set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s%c%s",indents,globalt.graphics,chr,cursor)
		else
			set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s.%s%c%s",indents,name,globalt.graphics,chr,cursor)
		end
		if len>0
			if len<(a_page_size)
				call translated("Fill")
				return globalt.a_page_switch
			end
		end
	end
	return name
end

function translate_bitmap(ss start,ss value)
	ss cursor
	ss name
	char loa="loadBitmap";vstr lo^loa
	set cursor equalon(start)
	if cursor!=start
		set name strstr(cursor,lo)
	else
		set name strstr(start,lo)
	end
	if name!=(NULL)
		add name \.loa-1
		if name#=(Openparenthesis)
			inc name
			ss pointer
			set pointer parecon(name)
			if pointer!=name
				ss texture
				char remind={0,0};vstr reminder^remind
				if cursor!=start
					set texture spcfullback(start,cursor)
					if texture=cursor
						return value
					end
					set reminder# texture#
					set texture# (Nullchar);inc texture
					set cursor# (Nullchar)
					set cursor "="
				else
					set texture spcfull(start)
					set reminder# (Nullchar)
					set texture# (Nullchar);set texture #globalt.blank
					set cursor #globalt.blank
				end
				set pointer# (Nullchar)
				if value#=(Nullchar)
					set pointer "[0,0]"
				else
					set pointer value
				end
				sd ?len
				set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s%s%sType.createInstance(Type.resolveClass(%s),%s);",start,reminder,texture,cursor,name,pointer)
				if len>0
					if len<(a_page_size)
						call translated("BitmapMorph")
						return globalt.a_page_switch
					end
				end
			end
		end
	end
	return value
end

function translate_oneve(ss start,ss name)
	ss cursor
	set cursor equalon(start)
	if cursor!=start
		ss pointer;set pointer cursor
		ss ?stage_required=FALSE
		while start!=pointer
			dec pointer
			sd ?c
			set c memcmp(pointer,#globalt.on_string,\globalt.on_string) #on is to short for strncmp
			if c=0
				if globalt.mainmod_bool=(TRUE)# test if stage is required
					ss test
					set test spcfull(start)
					if test=pointer
						set stage_required (TRUE)
					end
				end

				add pointer \globalt.on_string
				set c strncmp(pointer,#globalt.enterframe_string,\globalt.enterframe_string) #strncmp is defined to compare the first 10 bytes
				if c=0
					set cursor translate_on(start,#globalt.blank,"ENTER_FRAME",cursor,stage_required,name)
				else
					vstr mous="Mouse"
					set c strncmp(pointer,#globalt.press_string,\globalt.press_string)
					if c=0
						set cursor translate_on(start,mous,"CLICK",cursor,stage_required,name)
					else
						set c strncmp(pointer,#globalt.mousedown_string,\globalt.mousedown_string)
						if c=0
							set cursor translate_on(start,mous,"MOUSE_DOWN",cursor,stage_required,name)
						else
							set c strncmp(pointer,#globalt.mousemove_string,\globalt.mousemove_string)
							if c=0
								set cursor translate_on(start,mous,"MOUSE_MOVE",cursor,stage_required,name)
							else
								set c strncmp(pointer,#globalt.rollover_string,\globalt.rollover_string)
								if c=0
									set cursor translate_on(start,mous,"MOUSE_OVER",cursor,stage_required,name)
								else
									set c strncmp(pointer,#globalt.rollout_string,\globalt.rollout_string)
									if c=0
										set cursor translate_on(start,mous,"MOUSE_OUT",cursor,stage_required,name)
									else
										set c strncmp(pointer,#globalt.mouseup_string,\globalt.mouseup_string)
										if c=0
											set cursor translate_on(start,mous,"MOUSE_UP",cursor,stage_required,name)
										end
									end
								end
							end
						end
					end
				end
				if c=0
					if cursor!=start
						call translated("On")
						return cursor
					end
				end
				break # on is unique at the moment
			end
		end
	end
	return name
end
function translate_on(ss start,ss type,ss ev,ss value,ss ?stage_required,ss name)
	ss pointer
	set pointer spcfull(start)
	set pointer# (Nullchar)
	ss s1;ss s2
	if stage_required=(TRUE)
		set s1 globalt.stage
		set s2 globalt.dot
	else
		set s1 #globalt.blank
		set s2 #globalt.blank
	end
	inc value

	sd ?len
	ss cursor
	set cursor semicolon(value)
	ss ending
	if cursor!=value
		set cursor# (Nullchar)
		set ending ");"
	else #going at inner functions
		set ending #globalt.blank
	end
	ss kind
	if name#!=(Nullchar)
		set value name ## cursor# null is extra
		set kind "remove"
	else
		set kind "add"
	end
	set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s%s%sEventListener(flash.events.%sEvent.%s,%s%s",start,s1,s2,kind,type,ev,value,ending)
	if len>0
		if len<(a_page_size)
			return globalt.a_page_switch
		end
	end
	return start
end

function translate_object(ss start,ss oa)
	ss cursor
	if oa#=(Nullchar)
		set cursor translate_unshift(start,globalt.public,"Public")
		if cursor!=start
			return cursor
		end
		return oa
	end

	vstr a="Object"
	set cursor strstr(start,a)
	if cursor!=(NULL)
		ss pointer
		set pointer pareoon(cursor)
		if pointer!=cursor
			set cursor# (Nullchar)
			sd ?len;set len snprintf(globalt.a_page_switch,(a_page_size),globalt.triple_s,start,oa,pointer)
			if len>0
				if len<(a_page_size)
					call translated(a) #RePlace
					return globalt.a_page_switch
				end
			end
		end
	end
	return oa
end

function translate_rect(ss indents,ss name)
	ss cursor;set cursor spcfull(indents)
	if name#=(Nullchar)
		whiletrue
			ss pointer
			set pointer pareoon(cursor)
			if pointer!=cursor
				ss dotp
				set dotp dotbackafter(cursor,pointer)
				if dotp!=pointer
					set cursor dotp
				end
				break
			end
			return name
		end
	end
	set cursor# (Nullchar) #on lineTo...
	inc cursor
	ss width
	set width pareoafter(cursor)
	if width!=cursor
		ss width_end
		set width_end commaon(width) #(width,
		if width_end!=width
			ss y=1;add y width_end
			ss y_end
			set y_end parecon(y)   #,y)
			if y_end!=y
				set cursor y_end
				inc cursor
				ss height
				set height commaon(cursor)
				if height!=cursor
					ss height_end
					set height_end parecafter(height)    #,height)
					if height_end!=height
						set cursor height_end
						inc cursor
						ss x;set x pareoon(cursor)
						if x!=cursor
							ss x_end
							set x_end commaafter(x) #(x,
							if x_end!=x
								set cursor semicolon(x_end)
								if cursor!=x_end
									set x_end# (Nullchar)
									set y_end# (Nullchar)
									set width_end# (Nullchar)
									set height_end# (Nullchar)
									sd ?len
									if name#=(Nullchar)
										set len snprintf(globalt.a_page_switch,(a_page_size),"%s%sdrawRect%s%s,%s%s%s",indents,globalt.graphics,x,y,width,height,cursor)
									else
										set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s.%sdrawRect%s%s,%s%s%s",indents,name,globalt.graphics,x,y,width,height,cursor)
									end
									if len>0
										if len<(a_page_size)
											call translated("Rect")
											return globalt.a_page_switch
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
	return name
end

function translate_srch(ss start,ss oa)
	ss cursor
	whiletrue
		if oa#!=(Nullchar)
			if oa#!=(switch_char)
				break
			end
		end
		set cursor translate_srch_all(start)
		if cursor!=start
			call translated("SearchAll")
			if oa#=(switch_char)
				set cursor translate_two_switcher(oa)
				if cursor=oa
					return oa
				end
			end
			return cursor
		end
		return oa
	end
	set cursor translate_search(start,oa)
	if cursor!=oa
		return cursor
	end
	return oa
end
function translate_srch_all(ss start)
	ss ?t=0xf
	ss cursor
	set cursor translate_search_base(start,#t)
	if t=0
		return start
	end
	return cursor
end
function translate_search(ss start,ss oa)
	ss cursor
	#set cursor spcfull(oa) #at py there is a comparison that is not spcfull there
	set cursor oa
	ss ?types=0
	while cursor#!=(Nullchar)
		if cursor#=(_)
			or types 1
			inc cursor
			continue
		end
		if cursor#=(w_low)
			or types 2
			inc cursor
			continue
		end
		if cursor#=(h_low)
			or types 4
			inc cursor
			continue
		end
		if cursor#=(this_char)
			or types 8
			inc cursor
			continue
		end
		if cursor#=(switch_char)
			break
		end
		return oa
	end
	ss ?t;set t types
	ss pointer
	set pointer translate_search_base(start,#types)
	if types=t
		call translated("Search")
		if cursor#=(switch_char)
			set pointer translate_two_switcher(cursor)
			if pointer=cursor
				return cursor
			end
		end
		return pointer
	end
	return oa
end
function search_replace(ss ?t,svu p_start,ss cursor,ss ptypes,ss from,ss to)
	and t ptypes#
	if t!=0
		ss start
		set start p_start#
		ss pointer
		set pointer start
		if cursor!=start
			set pointer strdup(start) #else will be a collision
		end
		ss str
		set str replace(pointer,from,to,globalt.a_page_switch,(a_page_size))
		if cursor!=start
			call free(pointer)
		end
		if str!=pointer ##is ok to compare even if is free
			set p_start# str
		else
			xor ptypes# 2
		end
	end
end
function translate_search_base(ss start,ss ptypes)
	ss cursor;set cursor start
	ss str
	ss ?t=1
	and t ptypes#
	if t!=0
		set str strip(start,globalt.a_page_switch,(a_page_size)) #can't recognize at search all if is good or bad without different buffer
		if str!=start
			set start str
		else
			xor ptypes# 1
		end
	end
	call search_replace(2,#start,cursor,ptypes,"Stage.w","stage.stageW")
	call search_replace(4,#start,cursor,ptypes,"Stage.h","stage.stageH")
	call search_replace(8,#start,cursor,ptypes,"this",globalt.stage)
	return start
end

function translate_textfield(ss start)
	ss cursor
	set cursor translate_label(start)
	if cursor!=start
		call translated("Text")
		return cursor
	end
	return start
end
function translate_label(ss indents)
	ss cursor;set cursor spcfull(indents)
	set cursor# (Nullchar) #on create...
	ss name
	inc cursor
	set name quotafter(cursor)
	if name!=cursor
		set cursor quoton(name)
		if cursor!=name
			ss buffer;set buffer globalt.a_page_switch
			sd ?size
			set size object_make(indents,name,cursor,"flash.text.TextField",#buffer,(a_page_size))
			if size!=0
				inc cursor
				ss pointer
				set pointer commaafter(cursor)
				if pointer!=cursor
					set cursor commaafter(pointer)
					if cursor!=pointer
						set pointer commaon(cursor)
						if pointer!=cursor
							sd ?len
							set len object_com(name,"x",cursor,pointer,#buffer,size)
							if len!=0
								inc pointer
								set cursor commaon(pointer)
								if cursor!=pointer
									set size object_com(name,"y",pointer,cursor,#buffer,len)
									if size!=0
										inc cursor
										set pointer commaon(cursor)
										set len object_com(name,"width",cursor,pointer,#buffer,size)
										if len!=0
											inc pointer
											set cursor parecon(pointer)
											set size object_com(name,"height",pointer,cursor,#buffer,len)
											if size!=0
												#inc cursor
												#set pointer semicolafter(cursor) # this for + case
												#if pointer!=cursor
												#	set len snprintf(buffer,size,"%s",pointer) #strncat or strncpy are not good here
												#	if len>=0
												#		if len<size
												return globalt.a_page_switch
												#		end
												#	end
												#end
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
	return indents
end

function translate_var_full(ss start,ss oa,ss ?type)
	whiletrue
		ss pointer
		if oa#!=(Nullchar)
			if oa#!=(switch_char)
				set pointer spcfullafters(oa)
				if pointer=oa ##else is translate_one
					#v class
					ss afterindents;ss atarguments;ss cls
					set cls translate_var_helper(start,#afterindents,#atarguments,#pointer)
					if cls!=start
						ss ?store;set store afterindents#;set afterindents# (Nullchar)
						sd ?len
						!xor len len ## o problem
						ss cursor
						set cursor translate_leftright_full(globalt.var_translate,start,#globalt.blank,cls,oa,globalt.a_page_switch,#len)
						if cursor!=#globalt.blank
							callret translate_var_by_type(type,cursor,len,cls,pointer,afterindents,store,atarguments,"VarCreateClass","VarCreateClassNamed","VarCreateClassAdded","VarCreateClassAddedNamed",start)
						end
					end
				end
				return oa
			end
		end
		set pointer translate_var_simple(start,type)
		if pointer!=start
			return pointer
		end
		return oa
	end
end
function translate_var_simple(ss indents,ss ?type)
	ss cls;ss afterindents;ss atarguments;ss delim
	set cls translate_var_helper(indents,#afterindents,#atarguments,#delim)
	if cls!=indents
		ss cursor
		ss ?store
		sd ?len
		ss name
		set name quotafter(delim)
		if name!=delim ##going on attachMovie
			set cursor quoton(name)
			if cursor!=cls
				set store afterindents#;set afterindents# (Nullchar)
				set cursor# (Nullchar)
				set len snprintf(globalt.a_page_switch,(a_page_size),"%svar %s=new %s(",indents,name,cls)
				if len>0
					if len<(a_page_size)
						inc cursor
						ss pointer
						set pointer semicolafter(cursor)
						if pointer!=cursor
							ss args
							set args translate_var_arguments(pointer,globalt.a_page_switch,#len)
							if args=pointer
								return indents
							end
						end
						sd ?size=a_page_size
						sub size len
						if size>=3
							set pointer globalt.a_page_switch
							add pointer len
							set pointer# (Closeparenthesis)
							inc pointer
							set pointer# (Semicolon)

							inc pointer
							set pointer# (Nullchar)
							add len 2

							callret translate_var_by_type(type,globalt.a_page_switch,len,name,cursor,afterindents,store,atarguments,"VarAttach","VarAttachNamed","VarAttachAdded","VarAttachAddedNamed",indents)
						end
					end
				end
			end
		else #going on createEmptyMovieClip
			set store afterindents#;set afterindents# (Nullchar)
			!xor len len ## o problem
			# DisplayObjectContainer will be with problems at html5, it's constructor is private, and claude says maybe will also break at flash runtime
			set cursor translate_leftright_full(globalt.var_translate,indents,#globalt.blank,cls,"flash.display.Sprite",globalt.a_page_switch,#len)
			if cursor!=#globalt.blank
				callret translate_var_by_type(type,cursor,len,cls,delim,afterindents,store,atarguments,"VarCreate","VarCreateNamed","VarCreateAdded","VarCreateAddedNamed",indents)
			end
		end
	end
	return indents
end
function translate_var_by_type(ss ?type,ss cursor,sd ?len,ss name,ss pointer,ss afterindents,ss ?store,ss atarguments,ss ok1,ss ok2,ss ok3,ss ok4,ss start)
	if type=(var_char)
		call translated(ok1)
		return cursor
	end
	if type=(nvar_char)
		callret translate_var_named(cursor,len,name,pointer,ok2,start)
	end
	ss has_dot
	set has_dot strchr_reverse(atarguments,(Period))
	ss d
	if has_dot!=(NULL)
		set afterindents# store
		set has_dot# (Nullchar)
		set d globalt.dot
	else
		if globalt.mainmod_bool=(TRUE)
			set afterindents globalt.stage
			set d globalt.dot
		else
			set afterindents #globalt.blank
			set d #globalt.blank
		end
	end
	ss extra;set extra cursor
	add extra len
	sd ?size=a_page_size
	sub size len
	sd ?ln
	set ln snprintf(extra,size,"%s%s%s(%s);",afterindents,d,globalt.addChild,name)
	if ln>0
		if ln<size
			if type=(Var_char)
				call translated(ok3)
				return cursor
			end
			# nVar_char
			add len ln
			callret translate_var_named(cursor,len,name,pointer,ok4,start)
		end
	end
	return start
end
function translate_var_helper(ss indents,sv p_afterindents,sv p_atarguments,sv p_cursor)
	ss cursor;set cursor spcfull(indents)
	set p_afterindents# cursor
	ss cls
	inc cursor
	set cls quoton(cursor)
	if cls!=cursor
		set p_atarguments# cls
		inc cls
		set cursor quoton(cls)
		if cursor!=cls
			set cursor# (Nullchar)
			inc cursor
			set p_cursor# cursor
			return cls
		end
	end
	return indents
end
function translate_var_arguments(ss start,ss out,sd p_len)
	ss cursor
	ss first;set first out
	sd ?len
	sd ?size=a_page_size
	ss pointer
	set pointer start
	whiletrue
		set cursor equalafter(pointer)
		if cursor!=pointer
			set pointer semicolon(cursor)
			if pointer!=cursor
				set pointer# (Nullchar)
				ss c
				if out=first
					add out p_len#
					sub size p_len#
					set c #globalt.blank
				else
					add out len
					sub size len
					set c ","
				end
				set len snprintf(out,p_len#,globalt.double_s,c,cursor)
				if len>0
					if len<size
						add p_len# len
						inc pointer
						continue
					end
				end
				return start
			end
		end
		break
	end
	return out
end
function translate_var_named(ss cursor,sd ?len,ss oa,ss pointer,ss ok,ss bad_return)
	ss end
	set end commaon(pointer)
	set end# (Nullchar)
	ss extra;set extra cursor
	add extra len
	sd ?size=a_page_size
	sub size len
	set len snprintf(extra,size,"%s.name='%s'%s;",oa,oa,pointer)
	if len>0
		if len<size
			call translated(ok)
			return cursor
		end
	end
	return bad_return
end

function translate_textformat(ss start)
	ss cursor
	set cursor equalafter(start)
	if cursor!=start
		if cursor#=(Singlequote) #enforcing this for no name translations?
			ss type=1
			add type cursor
			ss pointer
			set pointer quoton(type)
			if pointer!=type
				call to_upper(type,pointer)
				set cursor# (Nullchar)
				set pointer# (Nullchar)
				inc pointer
				sd ?len;set len snprintf(globalt.a_page_switch,(a_page_size),"%sflash.text.TextFormatAlign.%s%s",start,type,pointer)
				if len>0
					if len<(a_page_size)
						call translated("TextFormat")
						return globalt.a_page_switch
					end
				end
			end
		end
	end
	return start
end

function translate_new(ss start)
	callret translate_unshift(start,#globalt.nw,"New")
end

function translate_insert(ss start,ss oa)
	ss cursor
	set cursor spcfullafters(oa)
	if cursor!=oa
		ss pointer
		set pointer spcfull(cursor)
		ss ?reminder
		set reminder cursor#;set cursor# (Nullchar)

		ss walker;set walker start
		ss mover;set mover globalt.a_page_switch
		sd ?len
		sd ?sz=a_page_size
		svu ?p2sz;set p2sz strlen(pointer)
		whiletrue
			ss pos
			set pos strstr(walker,pointer)
			if pos!=(NULL)
				set pos# (Nullchar)
				set len snprintf(mover,sz,globalt.triple_s,walker,oa,pointer)
				if len>0
					if len<sz
						add pos p2sz
						set walker pos
						add mover len
						sub sz len
						continue
					end
				end
				set walker start
				break
			end
			break
		end
		if walker!=start
			set len snprintf(mover,sz,"%s",walker)
			if len>=0
				if len<sz
					call translated("Replace")
					return globalt.a_page_switch
				end
			end
		end

		set cursor# reminder
	end
	return oa
end

function _postpone_char()
	return (postpone_char)
end
function mainmod_boolset(ss ?b)
	set globalt.mainmod_bool b
end

entryraw globalt()
