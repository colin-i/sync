 								if not solved:
 									unresolved=True
 				if resolved:
--- /dev/null
+++ actionswf-1/tests/as3/asd
@@ -0,0 +1 @@
+go_to_another_launcher=d ./as
--- /dev/null
+++ actionswf-1/tests/as3/bd
@@ -0,0 +1,2 @@
+
+LD_PRELOAD=$(gcc -print-file-name=libasan.so):$(gcc -print-file-name=libubsan.so) PYTHONMALLOC=malloc compiler=`pwd`/hax ffdec=`pwd`/ffde ./b
--- actionswf-1.orig/tests/as3/d
+++ actionswf-1/tests/as3/d
@@ -1,5 +1,6 @@
 
-pid=`ps -C python3 -o pid,cmd | grep oaas3 | tr -s ' ' | cut -d' ' -f2`
+if [ -z "$p" ]; then p=python3; fi
+pid=`ps -C $p -o pid,cmd | grep oaas3 | tr -s ' ' | cut -d' ' -f2`
 if [ -z "${nosudo}" ]; then s=sudo; fi
 if [ -n "$1" ]; then
 	$s gdb -p ${pid} -ex "source /home/bc/a/Desktop/gef/gef.py"
--- actionswf-1.orig/tests/as3/osrc/a
+++ actionswf-1/tests/as3/osrc/a
@@ -1,5 +1,7 @@
 #!/bin/sh
-if [ ! -e a.oc ]; then
+if [ ! -e ./a.oc ]; then
+	echo edor
 	edor --save-exit ../a.oc.oac
 fi
+stat -c '%a' a.oc
 inter=../../ ${RUN__SHELL} ../../a${s} # interext=.oac
