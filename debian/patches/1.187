--- actionswf-1.orig/oaas/main.oc
+++ actionswf-1/oaas/main.oc
@@ -22,6 +22,7 @@ import "_postpone_char" _postpone_char
 
 import "_resolve" _resolve
 ^import "_firstline" _firstline
+^import "_secondlinerequired" _secondlinerequired
 ^import "offset_get_p" offset_get_p
 ^import "offsetsize_get" offsetsize_get
 
@@ -103,9 +104,9 @@ functionx solve1(ss value)
 	set s solver1(value)
 	callret solver(value,s)
 end
-functionx solve2(ss value)
+functionx solve2(ss value) #,ss after)
 	ss s
-	set s solver2(value)
+	set s solver2(value) #,after)
 	callret solver(value,s)
 end
 functionx solve4(ss value)
@@ -127,6 +128,12 @@ functionx firstline()
 	ss ?b;set b a#
 	set a# (FALSE)
 	return b
+end
+functionx secondlinerequired()
+	ss a;set a _secondlinerequired()
+	ss ?b;set b a#
+	set a# (FALSE)
+	return b
 end
 functionx offset()
 	sv offs#1
--- actionswf-1.orig/oaas/solve.oc
+++ actionswf-1/oaas/solve.oc
