-			set globals.firstline (TRUE)
-			call sprintf(#globals.outvalue,"%c",(compare_char)) #this is only for !comp side
-			return #globals.outvalue
-		end
-		return (NULL)
+		#whiletrue
+		#	if after#!=(Closeparenthesis)
+		#		if after#!=(Nullchar) #more at oaas3
+		#			break
+		#		end
+		#	end
+		set globals.firstline (TRUE)
+		call sprintf(#globals.outvalue,"%c",(compare_char)) #this is only for !comp side
+		return #globals.outvalue
+		#end
+		#return (NULL)
 	end
 	char notenough_string="Not enough arguments, expected "^
 	set c strncmp(value,#notenough_string,\.notenough_string)
@@ -210,6 +219,7 @@ function solver2(ss value,ss after)
 				call sprintf(#globals.outvalue,"%c",(Evfunc_char))
 				return #globals.outvalue
 			end
+			set globals.secondlinerequired (TRUE)
 			set globals.offset offset_marker2
 			sub globals.offset offset_marker
 			set globals.offsetsize value
