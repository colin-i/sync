--- ocompiler-1.orig/otoc/loop.oc
+++ ocompiler-1/otoc/loop.oc
@@ -650,9 +650,9 @@ function unsigned(sd outfile)
 end
 function unsigned_type(sd outfile,sd type,sd sign)
 	if sign=(Xfile_declext_no)
-		if type<=(Xfile_decltype_longByte) #char is already unsigned
-			ret
-		end
+		#the problem with char is that it is signed char on arm and unsigned char on x86
+		#if type<=(Xfile_decltype_longByte); ret; end
+
 		callg write(outfile,#unsigned.a,\unsigned.a)
 		ret
 	end
--- ocompiler-1.orig/tests/a
+++ ocompiler-1/tests/a
@@ -19,7 +19,8 @@ comp () {
 	if [ "${edb}" = "0" ]; then
 		edb --run ${OCOMP} ${n} ${OFLAGS} || exit 1
 	else
-		LD_LIBRARY_PATH=${LD_LIBRARY_PATH} ${OCOMP} ${n} ${OFLAGS} || exit 1
+		#LD_LIBRARY_PATH=${LD_LIBRARY_PATH} this only if was at source ./inits
+		${OCOMP} ${n} ${OFLAGS} || exit 1
 	fi
 	if [ -n "${write_to_expected}" ]; then
 		copy ${n}.log
