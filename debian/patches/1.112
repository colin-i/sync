 const _frame_text_allocpart_=~frame_text_allocpart_
 import "text_after_nlines" text_after_nlines
+import "memnlcr" memnlcr
 
 importx "memcpy" memcpy
 
 function frame_text_add(valueu fr,svu _text,valueu lines)
 	valueu starttext#1;set starttext _text#
-	valueu endtext#1;set endtext text_after_nlines(starttext,lines)
-	set _text# endtext
-	sub endtext starttext
+	valueu number_of_crnl#1;set number_of_crnl 0
+	valueu endtext#1;set endtext text_after_nlines(starttext,lines,#number_of_crnl)
+	valueu size#1;set size endtext
+	sub size starttext
+	sub size number_of_crnl
 
 	valueu test#1;set test (_frame_text_allocpart_)
 	and test fr#:frame.size
 	valueu test3#1;set test3 fr#:frame.size
-	add test3 endtext
+	add test3 size
 	valueu test2#1;set test2 (_frame_text_allocpart_)
 	and test2 test3
-	valueu mem#1
+	ss mem
 	if test!=test2
 		add test2 (frame_text_allocpart)
 		#only drawback: if on edge will still go one more part
@@ -323,9 +329,22 @@ function frame_text_add(valueu fr,svu _t
 	else
 		set mem fr#:frame.text
 	end
+
+	#out text will be with nl
 	add mem fr#:frame.size
-	call memcpy(mem,starttext,endtext)
-	add fr#:frame.size endtext
+	ss next;valueu p#1
+	while starttext!=endtext
+		set p memnlcr(starttext,#next,(NULL))
+		sub p starttext
+		call memcpy(mem,starttext,p)
+		add mem p
+		set mem# (NewLine)
+		inc mem
+		set starttext next
+	end
+
+	set _text# endtext
+	add fr#:frame.size size
 	return (EXIT_SUCCESS)
 end
 
--- actionswf-1.orig/oad/intern.oc
+++ actionswf-1/oad/intern.oc
@@ -35,7 +35,38 @@ function fcontent(sd path,sv psize)
 	return (NULL)
 end
 
-function memnl(ss log,sv pnext)
+#at these memnl the last row is ending in nl from src
+function memnlcr(ss log,sv pnext,sv _cr) #here is moving through text, an example with cr: ffdec action output is \r\n
+	set pnext# 1
+	if log#!=(NewLine) #empty row / last row
+		whiletrue
+			if log#=(NewLine)
+				add pnext# log
+				dec log
+				if log#!=(CReturn)
+					inc log
+				end
+				break
+			end
+			if log#=(CReturn)
+				add pnext# log
+				ss next;set next pnext#
+				if next#=(NewLine)
+					add pnext# 1
+					if _cr!=(NULL)
+						add _cr# 1
+					end
+				end
+				break
+			end
+			inc log
+		end
+	else
+		add pnext# log
+	end
+	return log
+end
+function memnl(ss log,sv pnext) #here is moving only on nl from src
 	set pnext# 1
 	if log#!=(NewLine) #emptyrow
 		inc log
@@ -43,10 +74,6 @@ function memnl(ss log,sv pnext)
 			inc log
 		end
 		add pnext# log
-		dec log
-		if log#!=(CReturn)  #an example: ffdec action output is \r\n
-			inc log
-		end
 	else
 		add pnext# log
 	end
@@ -210,10 +237,10 @@ function actionrow(ss log,sd end,sv px,s
 	return (EXIT_FAILURE)
 end
 
-function text_after_nlines(ss inlog,valueu linesnr)
+function text_after_nlines(ss inlog,valueu linesnr,valueu crs)
 	ss next
 	while linesnr>^0
-		call memnl(inlog,#next)
+		call memnlcr(inlog,#next,crs)
 		set inlog next
 		dec linesnr
 	end
@@ -275,7 +302,7 @@ function loop(ss log,sv x,sd xx,sd logsi
 				end
 
 				valueu text#1;set text log
-				set log text_after_nlines(log,linesnr)
+				set log text_after_nlines(log,linesnr,(NULL))
 
 				sv pf;sv f;set f get_nframe(ppresprites#,psprites#,preid,ainit,#pf) #and from sprites since total lines sum, but will be needed at more, anyway
 
@@ -290,6 +317,7 @@ function loop(ss log,sv x,sd xx,sd logsi
 				valueu xcode#1;set xcode x
 				add x xcode_size
