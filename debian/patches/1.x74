--- edor-1.orig/Makefile.old
+++ edor-1/Makefile.old
@@ -3,13 +3,20 @@
 
 prefix = /usr
 
-DEFS =  -DUSE_FS=1 -DPLATFORM64=1\
-	 -DHAVE_CURSES_H=1 -DHAVE_DIRENT_H=1 -DHAVE_ERRNO_H=1 -DHAVE_FCNTL_H=1 -DHAVE_POLL_H=1 -DHAVE_STDIO_H=1 -DHAVE_STDLIB_H=1 -DHAVE_STRING_H=1 -DHAVE_UNISTD_H=1 -DHAVE_TIME_H=1 -DHAVE_SYS_STAT_H=1\
-	 -DHAVE_STDBOOL_H=1 -DHAVE_STDDEF_H=1
+DEFS =  -DUSE_FS=1\
+	 -DHAVE_FCNTL_H=1 -DHAVE_STDLIB_H=1 -DHAVE_TIME_H=1 -DHAVE_UNISTD_H=1\
+	 -DHAVE_CURSES_H=1\
+	 -DHAVE_ERRNO_H=1 -DHAVE_ERRNO_LOCATION=1\
+	 -DHAVE_STDIO_H=1\
+	 -DHAVE_STRING_H=1 -DHAVE_MEMMEM=1\
+	 -DHAVE_SYS_STAT_H=1\
+	 -DHAVE_STDBOOL_H=1 -DHAVE_STDDEF_H=1\
+	 -DSIZEOF_INT_P=8 -DSIZEOF_LONG=8\
 # -DHAVE_DLFCN_H=1
 # -DHAVE_SIGNAL_H=1
 #
-# -DUSE__FS=1
+# -DOTHER_CURSES=1 -DHAVE__GETREENT=1 -D_KEY_BACKSPACE=0x7f
+# -DUSE__FS -DMKDIR_1ARG=1
 
 all: s/edor
 
--- edor-1.orig/configure.ac
+++ edor-1/configure.ac
@@ -8,12 +8,12 @@ AC_INIT([edor], [0.1])
 AC_CONFIG_SRCDIR([s/main.c])
 
 AC_CONFIG_AUX_DIR([build-aux])
+
 # compile with -x c++
 AC_ARG_ENABLE(cpp,
   AS_HELP_STRING([--enable-cpp],[enable cpp, default: yes]),
   [case "${enableval}" in yes) cpp=true ;; no) cpp=false ;; *) AC_MSG_ERROR([bad value ${enableval} for --enable-cpp]) ;; esac],
   [cpp=true])
-
 AM_CONDITIONAL(CPP, test x"${cpp}" = x"true")
 
 # Check for CFLAGS
@@ -24,16 +24,103 @@ else
 enable_cflags_setting=yes
 fi
 AC_MSG_RESULT($enable_cflags_setting)
+
+#AC_SUBST(__KEY_BACKSPACE, "")
+AC_ARG_VAR([_KEY_BACKSPACE],[set KEY_BACKSPACE value])
+AC_MSG_CHECKING([if redefining KEY_BACKSPACE])
+if test "x${_KEY_BACKSPACE+set}" = xset; then
+AC_MSG_RESULT([yes])
+AC_SUBST(__KEY_BACKSPACE, "-D_KEY_BACKSPACE=")
+else
+AC_MSG_RESULT([no])
+fi
+
 # Checks for programs.
 AC_PROG_CC
 
 # Checks for header files. Checks for libraries.
 
+AC_CHECK_HEADERS(fcntl.h stdlib.h unistd.h time.h)
+AC_CHECK_HEADERS(curses.h, [
+		AC_SUBST(CSS, "")
+		AC_SEARCH_LIBS([nc_getmouse],[pdcurses],[AC_DEFINE(OTHER_CURSES,1,[is pdcurses])],[
+			AC_SEARCH_LIBS([getmouse],[ncurses])
+		])
+	], [
+		AC_SUBST(CSS, "-Wno-padded")
+	])
 AC_CHECK_HEADERS(stddef.h)
-AC_CHECK_HEADERS(dirent.h errno.h fcntl.h poll.h stdio.h stdlib.h string.h unistd.h time.h sys/stat.h)
-AC_CHECK_HEADERS(curses.h, [AC_SUBST(CSS, "")], [AC_SUBST(CSS, "-Wno-padded")])
-AC_SUBST(UNW, "")
 
+start_cflgs="$CFLAGS"
+CFLAGS="-Werror=implicit-function-declaration"
+AC_CHECK_HEADERS(errno.h, [
+	AC_MSG_CHECKING([function __errno_location])
+	AC_COMPILE_IFELSE(
+		[AC_LANG_SOURCE([[
+			#include <errno.h>
+			void main(){__errno_location();}
+		]])],
+		[
+			AC_MSG_RESULT([yes])
+			AC_DEFINE(HAVE_ERRNO_LOCATION, 1)
+		],
+		[
+			AC_MSG_RESULT([no])
+		]
+	)
+])
+AC_CHECK_HEADERS(stdio.h, [
+	AC_MSG_CHECKING([function __getreent])
+	AC_COMPILE_IFELSE(
+		[AC_LANG_SOURCE([[
+			#include <stdio.h>
+			void main(){__getreent();}
+		]])],
+		[
+			AC_MSG_RESULT([yes])
+			AC_DEFINE(HAVE__GETREENT, 1)
+		],
+		[
+			AC_MSG_RESULT([no])
+		]
+	)
+])
+AC_CHECK_HEADERS(string.h, [
+	AC_MSG_CHECKING([function memmem])
+	AC_COMPILE_IFELSE(
+		[AC_LANG_SOURCE([[
+			#include <string.h>
+			void main(){memmem("",1,"",1);}
+		]])],
+		[
+			AC_MSG_RESULT([yes])
+			AC_DEFINE(HAVE_MEMMEM, 1)
+		],
+		[
+			AC_MSG_RESULT([no])
+		]
+	)
+])
+AC_CHECK_HEADERS(sys/stat.h, [
+	AC_MSG_CHECKING([mkdir without mode_t])
+	AC_COMPILE_IFELSE(
+		[AC_LANG_SOURCE([[
+			#include <sys/stat.h>
+			void main(){mkdir("a");}
+		]])],
+		[
+			AC_MSG_RESULT([yes])
+			AC_DEFINE(MKDIR_1ARG, 1)
+			#to not write extra, also assume rest of windows definitions
+		],
+		[
+			AC_MSG_RESULT([no])
+		]
+	)
+])
+CFLAGS="$start_cflgs"
+
+#AC_SUBST(UNW, "")
 #arm32 unwind
 AC_CANONICAL_BUILD
 AC_MSG_CHECKING([build_cpu])
@@ -108,11 +195,13 @@ char a=std::filesystem::path::preferred_
 AC_CHECK_HEADERS(stdbool.h)
 ])
 
-AC_RUN_IFELSE([AC_LANG_SOURCE([
-int main(){
-return sizeof(long)==sizeof(int);//0 is true for ac_run
-}
-])], [AC_DEFINE(PLATFORM64, 1, "64")], [])
+AC_CHECK_SIZEOF([int *])
+AC_CHECK_SIZEOF([long])
+#AC_RUN_IFELSE([AC_LANG_SOURCE([ #this is not cross-compile ok
+#int main(){
+#return sizeof(long)==sizeof(int);//0 is true for ac_run
+#}
+#])], [AC_DEFINE(PLATFORM64, 1, "64")], [])
 
 #back at CFLAGS
 test "x${enable_cflags_setting}" = xyes && CFLAGS="-O3 -s"
--- edor-1.orig/readme.md
+++ edor-1/readme.md
@@ -24,13 +24,13 @@ sudo dnf install edor
 ```
 \
 On openSUSE, run the following as __root__:\
-From openSUSE Factory:
+For openSUSE Tumbleweed:
 ```sh
-zypper addrepo https://download.opensuse.org/repositories/home:costin/openSUSE_Factory/home:costin.repo
+zypper addrepo https://download.opensuse.org/repositories/home:costin/openSUSE_Tumbleweed/home:costin.repo
 ```
-From openSUSE Factory ARM:
+For openSUSE Leap:
 ```sh
-zypper addrepo https://download.opensuse.org/repositories/home:costin/openSUSE_Factory_ARM/home:costin.repo
+zypper addrepo https://download.opensuse.org/repositories/home:costin/openSUSE_Leap_15.6/home:costin.repo
 ```
 And:
 ```sh
@@ -38,7 +38,10 @@ zypper refresh
 zypper install edor
 ```
 \
-On linux distributions, <i>.AppImage</i> file from [releases](https://github.com/colin-i/edor/releases).
+On Windows, there is this **edor-\*-msys-\*.zst** pkg at [releases](https://github.com/colin-i/edor/releases) which is using [msys2](https://msys2.github.io).
+\
+\
+On other linux distributions, <i>.AppImage</i> file from [releases](https://github.com/colin-i/edor/releases).
 
 ## From source
 Debian example: Install autoconf automake make libncurses-dev bc g++(or gcc and --disable-cpp at configure); on armv7l(alias armhf) cpu, libunwind-dev. There is a "headless" build file as well.
--- edor-1.orig/s/Makefile.am
+++ edor-1/s/Makefile.am
@@ -2,11 +2,14 @@ AUTOMAKE_OPTIONS = subdir-objects
 
 bin_PROGRAMS = edor
 edor_SOURCES = main.c bar.c sep.c tw.c tit.c split.c
-edor_LDFLAGS = -rdynamic
-edor_LDADD = -lncurses
-edor_CFLAGS = @CSS@
+
+edor_LDFLAGS = -Wl,--export-dynamic
+#same as -rdynamic, maybe was about some undefined symbols between edor_SOURCES
+
+edor_CFLAGS = @CSS@ @__KEY_BACKSPACE@@_KEY_BACKSPACE@
 if CPP
-edor_CPPFLAGS = -x c++ -Wno-old-style-cast @UNW@
+edor_CPPFLAGS = -x c++ -Wno-old-style-cast
+# @UNW@
 # -Wno-c++98-compat
 endif
 
@@ -16,9 +19,14 @@ CLEANFILES += main.h
 
