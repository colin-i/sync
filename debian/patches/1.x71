+		return normalize(c,s,r,&normalize_clue);
 	}
 	return normalize_err;
 }
@@ -2531,7 +2531,8 @@ static void getfilebuf(char*cutbuf_file)
 			if(v!=nullptr){
 				lseek(f,0,SEEK_SET);
