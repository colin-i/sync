--- actionswf-1.orig/csrc/Makefile
+++ actionswf-1/csrc/Makefile
@@ -6,7 +6,7 @@ ifndef OCONV
 OCONV=otoc
 endif
 ifndef linkerflags
-linkerflags=-O3 -s
+linkerflags=-s #-O1..fast will break the test at bionic(at least)
 endif
 ifndef compilerflags
 compilerflags=${linkerflags}
--- actionswf-1.orig/oad/Makefile
+++ actionswf-1/oad/Makefile
@@ -9,7 +9,7 @@ ifndef OCONV
 OCONV=otoc
 endif
 ifndef linkerflags
-linkerflags=-O3 -s
+linkerflags=-O3 -s #Ofast is breaking the test
 endif
 ifndef compilerflags
 compilerflags=${linkerflags}
--- actionswf-1.orig/tests/a.py
+++ actionswf-1/tests/a.py
@@ -5,7 +5,7 @@ if os.environ.get('break'):
 	import pdb; pdb.set_trace()
 
 def text(name):
-	return open(name).read()
+	return open(name,encoding="utf-8").read()
 
 actionswf.xlog_pad_set(0x30)
 
