--- actionswf-1.orig/oaas3
+++ actionswf-1/oaas3
@@ -231,6 +231,8 @@ def exiting():
 	exiting_serv(server_pid)
 
 verbose=os.environ.get('verbose')
+if verbose:
+	print(sys.argv[1]+' '+sys.argv[2])
 
 skip_src='skip_src'
 if not os.environ.get(skip_src):
--- actionswf-1.orig/tests/as3/b
+++ actionswf-1/tests/as3/b
@@ -10,6 +10,7 @@ if [ -z "${OAPATH}" ]; then
 fi
 if [ -z "${verbose+x}" ]; then
 	verbose=x
+	echo verbose
 fi
 no_clean=x verbose=${verbose} header=550:400:12:ffFFff $p ../../oaas3 dest a.swf \
-&& ./df
+&& ${RUN__SHELL} ./df
