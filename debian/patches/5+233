+			end
+			sub bufptr newstart
+			sub pointer bufptr
+			sub end bufptr
+			add end (getline_increments)
+			set bufptr newstart
+			set lineptr# bufptr
+		end
+	end
+	sub pointer bufptr
+	return pointer
+end
