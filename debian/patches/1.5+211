--- ocompiler-1.orig/src/files/actions/main/index/function.oc
+++ ocompiler-1/src/files/actions/main/index/function.oc
@@ -14,7 +14,7 @@ ElseIf programentrypoint!=codesecReg
 	EndIf
 	Set errormsg allocerrormsg
 Else
-	sd varargs;set varargs subtype
+	set varargs subtype
 	and varargs (x_func_flag)
 	and subtype (~x_func_flag)
 
@@ -33,6 +33,6 @@ Else
 	EndElse
 	if errormsg=(noerror)
 		Data declarefn=declarefunction
-		SetCall errormsg parsefunction(pcontent,pcomsize,declarefn,subtype,el_or_e,varargs)
+		SetCall errormsg parsefunction(pcontent,pcomsize,declarefn,subtype,el_or_e)
 	endif
 EndElse
--- ocompiler-1.orig/src/files/functions/actions/fn.oc
+++ ocompiler-1/src/files/functions/actions/fn.oc
@@ -47,7 +47,7 @@ function func_xfile(sd subtype)
 	return subtype ##Xfile_function_traw Xfile_function_extern Xfile_function_entry
 endfunction
 #err
-Function parsefunction(data ptrcontent,data ptrsize,data is_declare,sd subtype,sd el_or_e,sd varargs)
+Function parsefunction(data ptrcontent,data ptrsize,data is_declare,sd subtype,sd el_or_e)
 	Data true=TRUE
 	#Data false=FALSE
 
@@ -187,7 +187,7 @@ Function parsefunction(data ptrcontent,d
 					call scope64_set((FALSE))
 				endelse
 			endelse
-			setcall err xfile_add_fndef_if(content,sz,subtype,varargs)
+			setcall err xfile_add_fndef_if(content,sz,subtype)
 			If err!=noerr
 				Return err
 			EndIf
@@ -235,7 +235,7 @@ Function parsefunction(data ptrcontent,d
 
 			sd b;setcall b scope64_get()
 			if b=(TRUE)
-				if varargs!=0
+				if main.varargs!=0
 					sd nr_of_args
 					setcall nr_of_args convdata((convdata_total))
 					setcall err function_start_64(nr_of_args)
--- ocompiler-1.orig/src/files/functions/xfile_details.oc
+++ ocompiler-1/src/files/functions/xfile_details.oc
@@ -81,7 +81,7 @@ function xfile_add_declare_if(sd decltyp
 endfunction
 
 #err
-function xfile_add_fndef_if(sd content,sd sz,sd fn,sd varargs)
+function xfile_add_fndef_if(sd content,sd sz,sd fn)
 	if main.xfile!=(openno)
 		sd err
 		setcall err xfile_add_char((Xfile_functiondef))
@@ -117,7 +117,7 @@ function xfile_add_fndef_if(sd content,s
 								break
 							endelse
 						endelse
-						if varargs=0
+						if main.varargs=0
 							setcall err xfile_add_char((Xfile_function_e_normal))
 						else
 							setcall err xfile_add_char((Xfile_function_e_varargs))
@@ -426,29 +426,31 @@ function xfile_recursive()
 	if main.xfile!=(openno)
 		if main.innerfunction=(TRUE)
 			if main.innerfunctionreturn=(FALSE)
-				#can add at pass_init on top of all
-				sv ptrfunctions%%ptr_functions
-				sd fns
-				call getcont(ptrfunctions,#fns)
-				sd pos;set pos 0
-				whiletrue
-					sd ibit;setcall ibit importbit(fns)
-					if ibit=0
-						if pos=main.functionTagIndex
-							break
+				if main.varargs=0  #will error on any varargs at c
+					#can add at pass_init on top of all
+					sv ptrfunctions%%ptr_functions
+					sd fns
+					call getcont(ptrfunctions,#fns)
+					sd pos;set pos 0
+					whiletrue
+						sd ibit;setcall ibit importbit(fns)
+						if ibit=0
+							if pos=main.functionTagIndex
+								break
+							endif
+							inc pos
 						endif
-						inc pos
-					endif
+						add fns (nameoffset)
+						addcall fns strlen(fns)
+						inc fns
+					endwhile
+					sd size
 					add fns (nameoffset)
-					addcall fns strlen(fns)
-					inc fns
-				endwhile
-				sd size
-				add fns (nameoffset)
-				setcall size strlen(fns)
-				sd err;setcall err xfile_add_base((Xfile_proto),fns,size)
-				set main.innerfunctionreturn (TRUE)
-				return err
+					setcall size strlen(fns)
+					sd err;setcall err xfile_add_base((Xfile_proto),fns,size)
+					set main.innerfunctionreturn (TRUE)
+					return err
+				endif
 			endif
 		endif
 	endif
