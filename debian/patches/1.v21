--- torra-1.orig/setup.py
+++ torra-1/setup.py
@@ -1,4 +1,4 @@
-ver="1.0.40"
+ver="1.0.39"
 README="""Torrent client.\\
 To remove configuration launch ```torra --remove-config```. There is also ```torra --debug```.\\
 To specify another torrent list at start, launch with an argument, e.g. ```torra ~/torrents.txt```, or ```torra f ~/torrents.txt```\\
--- torra-1.orig/torra/main.py
+++ torra-1/torra/main.py
@@ -41,15 +41,13 @@ def activate(app):
 	layout.layout(window)
 
 def main():
-	#appimage is not passing this on github test, local appimage test is ok
-	#if os.getenv("ENTRY_DEBUG"):
-	#	sys.stdout.write("ENTRY_DEBUG marker\n")
 	if len(sys.argv)>1:
 		if sys.argv[1]=="--remove-config":
 			cleanup()
 			return
 		if sys.argv[1]=="--debug":
 			sys.stdout.write("ENTRY_DEBUG marker\n")
+			sys.stdout.flush()
 		else:
 			fname=sys.argv[1]
 			if len(fname)==1:
