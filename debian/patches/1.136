--- actionswf-1.orig/src/debug.oc
+++ actionswf-1/src/debug.oc
@@ -137,6 +137,23 @@ function md_printf(sd c,sd format,sd val
 	return n
 end
 
+import "string_nl_print" string_nl_print
+
+function deprecation_init(sd flags)
+	charx bool#1
+	charx full#1
+	and flags (flag_deprecation_no|flag_deprecation_partial)
+	if flags=(flag_none)
+		set bool (TRUE)
+		set full (TRUE)
+	elseif flags=(flag_deprecation_partial)
+		set bool (TRUE)
+		set full (FALSE)
+	else #flag_deprecation_no
+		set bool (FALSE)
+	end
+end
+
 import "row_termination" row_termination
 import "brace_blocks_get_memblock" brace_blocks_get_memblock
 import "block_get_size" block_get_size
@@ -171,6 +188,7 @@ function flags_init(sd flags,sd path)
 
 	call frames_as_shows(flags)
 	call for_in(flags)
+	call deprecation_init(flags)
 endfunction
 
 function log_init(sd flags,sd path)
@@ -539,3 +557,14 @@ function debug_xlog_call()
 		callg debug_phase_code_add_one((xlog_call))
 	end
 end
+
+function deprecation()
+	if deprecation_init.bool=(TRUE)
+		vstr e="DBL tags are deprecated; use GIF/JPEG/PNG functions, flag_deprecation_partial, flag_deprecation_no"
+		if deprecation_init.full=(TRUE)
+			call error(e)
+		else
+			call string_nl_print(e)
+		end
+	end
+end
