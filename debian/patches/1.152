 	sd test=flags_x
 	and test flags
 	if test!=0
@@ -247,6 +254,13 @@ function debug_x_base(sd mem,sd size)
 	add x_data.size size
 end
 function debug_x(sd mem,sd nr)
+	sd vb;set vb verbose_get()
+	if vb!=(flag_none)
+		if nr>x_init.verb
+			set x_init.verb nr
+			call printf("action .x peak: %hu\n",x_init.verb) # totalvalues = 0xffFF
+		end
+	end
 	if x_data.f!=(NULL)
 		mult nr (action_code_values_unit)
 		call debug_x_base(mem,nr)
