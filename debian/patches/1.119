 importx "fputs" fputs
 importx "stdout" stdout
+importx "fputc" fputc
 
+function printn(sv s)
+	call fputc((NewLine),s)
+end
 function printt(ss str)
 	sv so^stdout  #isn't at c an extra step? who cares, at o, to put stdout an arg is like putting the pointer
 	call fputs(str,so#)
@@ -135,14 +139,15 @@ function prints_inline(ss format)
 	call printt(format)
 end
 function print_inline_done()
-	call putchar((NewLine))
+	sv so^stdout  #isn't at c an extra step? who cares, at o is not possible without this
+	call printn(so#)
 end
 
 import "memnl" memnl
 
 importx "fwrite" fwrite
 function print_text(ss a,valueu c)
-	sv so^stdout  #isn't at c an extra step? who cares, at o is not possible without this
+	sv so^stdout
 	ss b
 	valueu d#1
 	add c a
@@ -158,9 +163,21 @@ function print_text(ss a,valueu c)
 	end
 end
 
+importx "stderr" stderr
+function printe(ss er)
+	sv se^stderr
+	set se se#
+	call fputs(er,se)
+	call printn(se)
+end
+
 function print_hex_start(ss front,dataxu value)
 	call printf("%s=0x%X",front,value)
 end
+function print_hhex(ss front,wordxu value)
+	call putchar((Space))
+	call printf("%s=0x%hX",front,value)
+end
 function print_hex(ss front,dataxu value)
 	call putchar((Space))
 	call print_hex_start(front,value)
