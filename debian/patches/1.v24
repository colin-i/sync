--- torra-1.orig/README.md
+++ torra-1/README.md
@@ -31,7 +31,7 @@ zypper install python313-torra
 Will also install libgtk-4-1 if is not already installed.\
 \
 \
-On Fedora 42/43/44(x86_64 aarch64), run the following as __root__:
+On Fedora 43/44(x86_64 aarch64), run the following as __root__:
 ```sh
 dnf copr enable colin/project
 dnf install python3-torra
@@ -43,6 +43,14 @@ On Arch Linux, <i>.zst</i> file from [re
 ```sh
 yay -Sy python-torra
 ```
+<!--Or:
+```sh
+git clone --filter=blob:none --sparse https://github.com/colin-i/pkgbuilds.git
+cd pkgbuilds
+git sparse-checkout set python-torra
+cd python-torra
+makepkg -si
+```-->
 Will also install gtk4 if is not already installed.\
 \
 \
--- torra-1.orig/setup.py
+++ torra-1/setup.py
@@ -1,4 +1,4 @@
-ver="1.0.42"
+ver="1.0.43"
 README="""Torrent client.\\
 To remove configuration launch ```torra --remove-config```. There is also ```torra --debug```.\\
 To specify another torrent list at start, launch with an argument, e.g. ```torra ~/torrents.txt```, or ```torra f ~/torrents.txt```\\
--- torra-1.orig/torra/gtk.py
+++ torra-1/torra/gtk.py
@@ -22,6 +22,8 @@ class GtkSortType(IntEnum):
 	GTK_SORT_DESCENDING=1
 class GtkWrapMode(IntEnum):
 	GTK_WRAP_WORD_CHAR=3
+class GUserDirectory(IntEnum):
+	G_USER_DIRECTORY_DOWNLOAD=2
 
 G_TYPE_FUNDAMENTAL_SHIFT = 2
 G_TYPE_MAKE_FUNDAMENTAL=lambda x: x << G_TYPE_FUNDAMENTAL_SHIFT
@@ -76,6 +78,8 @@ def gtk_list_store_set5(a,b,i1,v1,i2,p2,
 	k.gtk_list_store_set(a,b,i1,v1,i2,p2,i3,p3,i4,p4,i5,p5,-1)
 
 k2.g_free.argtypes = [c_void_p]
+k2.g_get_user_special_dir.restype = c_char_p
+#k2.g_get_user_special_dir.argtypes = [c_int]
 k2.g_source_remove.argtypes = [c_void_p]
 k2.g_timeout_add.argtypes = [c_int,c_void_p,c_void_p]
 k3.g_object_unref.argtypes = [c_void_p]
--- torra-1.orig/torra/sets.py
+++ torra-1/torra/sets.py
@@ -6,9 +6,20 @@ from . import log
 from . import cons
 from . import slowban
 k=gtk.k
+k2=gtk.k2
 k3=gtk.k3
 
+import os
+
 fold_bf=k.gtk_entry_buffer_new(None,-1)
+# Alternatively with external dependency: platformdirs.user_downloads_dir()
+download_folder = k2.g_get_user_special_dir(gtk.GUserDirectory.G_USER_DIRECTORY_DOWNLOAD) #NULL if the logical id was not found
+#only G_USER_DIRECTORY_DESKTOP falls back to $HOME/Desktop, at minimal desktops XDG can be missing
+k.gtk_entry_buffer_set_text(
+	fold_bf,
+	download_folder if (download_folder and os.path.isdir(download_folder)) else b'',
+	-1
+)
 
 def labent(t,e):
 	t=k.gtk_label_new (t)
--- torra-1.orig/v2
+++ torra-1/v2
@@ -1 +1 @@
-1.0.42
\ No newline at end of file
+1.0.43
\ No newline at end of file
