+function capture_save()
+	ss location
+	import "stage_get_output_container" stage_get_output_container
+	setcall location stage_get_output_container()
+	call av_dialog_run(capture_save_run,location)
+end
+function capture_save_run(ss filename)
+	sd file
+	sd p_file^file
+	import "openfile" openfile
+	call openfile(p_file,filename,capture_direct_start.raw_method)
+	if file!=(NULL)
+		sd ebox
+		import "stage_nthwidgetFromcontainer" stage_nthwidgetFromcontainer
+		setcall ebox stage_nthwidgetFromcontainer(0) #isn't this thread unsafe? gtk_container_get_children? or is simple value get
+		import "object_get_dword_name" object_get_dword_name
+		sd pixbuf
+		setcall pixbuf object_get_dword_name(ebox) #no unref required
+
+		datax w#1
+		datax h#1
+		value wh^w
+		import "pixbuf_get_wh" pixbuf_get_wh
+		call pixbuf_get_wh(pixbuf,wh)
+		sd rgb_size
+		setcall rgb_size rgb_get_size(w,h)
+
+		sd er
+		setcall er file_write(wh,(DWORD+DWORD),file)
+		if er=(noerror)
+			sd position_total
+			import "stage_get_frames" stage_get_frames
+			setcall position_total stage_get_frames()
+			setcall er file_write(#position_total,(DWORD),file)
+			if er=(noerror)
+				setcall er file_write(#position_total,(DWORD),file)
+				if er=(noerror)
+					data nr_of_file=0
+					setcall er file_write(#nr_of_file,(DWORD),file)
+					if er=(noerror)
+						sd i=0
+						while i!=position_total
+							setcall ebox stage_nthwidgetFromcontainer(i)
+							setcall pixbuf object_get_dword_name(ebox)
+							sd bytes
+							setcall bytes gdk_pixbuf_get_pixels(pixbuf)
+							setcall er file_write(bytes,rgb_size,file)
+							if er!=(noerror)
+								break
+							end
+							sd len
+							import "stage_get_fr_length" stage_get_fr_length
+							set len stage_get_fr_length(ebox)
+							setcall er file_write(#len,(DWORD),file)
+							if er!=(noerror)
+								break
+							end
+							import "av_display_info_progress" av_display_info_progress
+							call av_display_info_progress(file,i)
+							inc i
+						end
+						if er=(noerror)
+							import "save_inform_saved_th" save_inform_saved_th
+							call save_inform_saved_th(filename)
+						end
+					end
+				end
+			end
+		end
+		call fclose(file)
+	endif
+	#if er!=(noerror) #err is texted already
+	#	call texter(er)
+	#end
+	call av_dialog_close()
+end
