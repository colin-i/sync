 			endif
 			sd imm;setcall imm getimm()
 			if imm=(TRUE) #if is FALSE, this is the only option for xfile. also allow(string) is no
@@ -312,7 +313,7 @@ Function getarg(sv ptrcontent,sd ptrsize
 			if sens=(FORWARD)
 				return (noerror)
 			endif
-			callret verify_syntax_end_and_restore(ptrcontent,ptrsize,argsize)
+			callret verify_syntax_end_and_restore(ptrcontent,ptrsize,argsize,"Unrecognized inner text at variable arg.")
 		endif
 	endelseif
 	If sens=(FORWARD)
