+			#callret verify_syntax_end_and_restore(ptrcontent,ptrsize,q_size) #is not error since comma/quotes error at quotes, is only for restore
 		endelse
 	elseif allowdata!=(allow_later)  #exclude pass_init, but even there jump over first arg
 		call arg_size(content,argsize,#argsize)  #spc,tab
@@ -192,7 +193,7 @@ Function getarg(sv ptrcontent,sd ptrsize
