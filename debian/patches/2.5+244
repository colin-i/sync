--- ocompiler-2.orig/localtest
+++ ocompiler-2/localtest
@@ -1 +1 @@
-2-5+243
+2-5+244
--- ocompiler-2.orig/src/files/functions/actions/enumcomma.oc
+++ ocompiler-2/src/files/functions/actions/enumcomma.oc
@@ -203,7 +203,7 @@ Function enumcommas(sv ptrcontent,sd ptr
 			endif
 
 			sd size_aux
-			sd mark
+			ss mark
 			if sz!=0
 				set argsize content
 				dec argsize
@@ -214,25 +214,37 @@ Function enumcommas(sv ptrcontent,sd ptr
 					sd last;set last content
 					sub last sz
 					dec argsize
-					while argsize!=last
+					whiletrue
 						if argsize#=d_quot
 							dec argsize
 							if argsize#!=(asciibs)
 								inc argsize
 								set last argsize
-							else
-								dec argsize
-							endelse
-						else
-							dec argsize
-						endelse
+								break
+							endif
+						elseif argsize#=(asciireturn) #and mac?
+							if typenumberOrparses!=(pass_calls) ##here is a multirow string #same
+								add main.totalnewlines (BACKWARD)
+							endif
+						endelseif
+						dec argsize
 					endwhile
+					if argsize<^main.textlinestart ##here is a multirow string
+						if typenumberOrparses!=(pass_calls) #there is a case where args are numbered and same step has multiple passes calls
+						#pass_init is not erroring here
+							call keep_textlinestart(argsize)
+						endif
+					endif
 					set mark argsize
 					sub argsize content
 					neg argsize
 					set size_aux sz
 					sub size_aux argsize
 					setcall size_aux valinmemsens(mark,size_aux,comma,sens)
+					ss another_quotes;set another_quotes valinmemsens(mark,size_aux,d_quot,sens)
+					if size_aux>^another_quotes
+						return "comma/quotes error at quotes"
+					endif
 
 					#and this to ensure no frontal inner_text
 					sub mark size_aux
@@ -242,6 +254,11 @@ Function enumcommas(sv ptrcontent,sd ptr
 					add argsize last
 				else
 					SetCall argsize valinmemsens(content,sz,comma,sens)
+					set another_quotes valinmemsens(content,sz,d_quot,sens)
+					if argsize>^another_quotes
+						return "comma/quotes error at values"
+					endif
+
 					#and don't let ( ) at getarg, there let only something(exlcuding spaces)/nothing like in all cases
 					set size_aux content
 					sub size_aux argsize
@@ -260,7 +277,8 @@ Function enumcommas(sv ptrcontent,sd ptr
 			sub ptrcontent# argsize
 			sub ptrsize# argsize
 			vData ptrargsize^argsize
-			if typenumberOrparses=(pass_init)
+			set main.not_this_case (TRUE)
+			if typenumberOrparses=(pass_init) #here only for string size, that is in a good condition, but size 0 will error
 				setcall err getarg(ptrcontent,ptrargsize,argsize,(allow_later),sens) #there are 4 more arguments but are not used
 				If err!=noerr
 					Return err
@@ -271,6 +289,7 @@ Function enumcommas(sv ptrcontent,sd ptr
 					Return err
 				EndIf
 			endelseif
+			set main.not_this_case (FALSE)
 			sub ptrcontent# size_aux
 			sub ptrsize# size_aux
 			add argsize size_aux
@@ -294,3 +313,14 @@ Function enumcommas(sv ptrcontent,sd ptr
 	EndIf
 	Return noerr
 EndFunction
+
+function keep_textlinestart(ss pointer)
+	while main.first_textlinestart!=pointer
+		dec pointer
+		if pointer#=(asciireturn) #and mac?
+			inc pointer
+			break
+		endif
+	endwhile
+	set main.textlinestart pointer
+endfunction
