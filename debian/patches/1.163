--- actionswf-1.orig/Makefile
+++ actionswf-1/Makefile
@@ -11,11 +11,12 @@ prefix=/usr
 endif
 
 ifeq ($(shell dpkg-architecture -qDEB_HOST_ARCH), i386)
-conv_64=1
+#let error if not dpkg-architecture to be visible for correction . or || uname -m , patsubst
+	conv_64=1
 else
-ifndef conv_64  #when there is no dpkg-architecture
-conv_64=0
-endif
+	ifndef conv_64
+		conv_64=0
+	endif
 endif
 
 $(TOPTARGETS): $(SUBDIRS)
@@ -24,15 +25,15 @@ $(ALLDIRS):
 	$(MAKE) -C $@ conv_64=${conv_64} $(MAKECMDGOALS)
 
 test:
-	RUN__SHELL=$(SHELL) . ./shl && cd tests && \
+	RUN__SHELL=$(SHELL) . ./shl && cd csrc && make && cd ../tests && \
 	conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./as && conv_64=${conv_64} $${RUN__SHELL} ./c 1 && \
-	src=x $${RUN__SHELL} ./apy && conv_64=${conv_64} $${RUN__SHELL} ./c 1 && \
+	$${RUN__SHELL} ./apy && conv_64=${conv_64} $${RUN__SHELL} ./c 1 && \
 	cd ffdec && conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./as && \
 	cd ../data && conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./test x && \
 	cd ../as3 && conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./as && \
 	echo tests ok
 clean:
-	RUN__SHELL=$(SHELL) . ./shl && cd tests && \
+	RUN__SHELL=$(SHELL) . ./shl && cd csrc && make clean && cd ../tests && \
 	$${RUN__SHELL} ./c && cd ffdec && $${RUN__SHELL} ./c && cd ../data && $${RUN__SHELL} ./c && cd ../as3 && $${RUN__SHELL} ./c
 install:
 	install -D oaalternative.sh $(DESTDIR)$(prefix)/bin/oaalternative.sh
--- actionswf-1.orig/cln
+++ actionswf-1/cln
@@ -1,2 +1,2 @@
 
-cd example && make clean && cd .. && make clean && cd csrc && make clean && cd .. && cd oaas && make clean && git status
+cd example && make clean && cd .. && make clean && cd csrc && make clean && cd .. && cd oaas && make clean && cd .. && git status
--- actionswf-1.orig/csrc/Makefile
+++ actionswf-1/csrc/Makefile
@@ -15,11 +15,19 @@ ifndef EXTRA_CFLAGS
 include ../oad/cflags
 endif
 
-items_prefix=../src/
-include ../src/items
+ifeq ($(shell dpkg-architecture -qDEB_HOST_ARCH), arm64)
+#let error if not dpkg-architecture to be visible for correction . or || uname -m , patsubst
+	OCONVFLAGS=-s
+endif
+
+backsrc=../src/
+
+logs_prefix=${backsrc}
+include ${backsrc}items
 exte=libexte.a
 proj=libactionswf.so
 
+items_prefix=${backsrc}
 $(eval xfiles = )
 $(foreach var,$(expitems),$(eval xfiles += ${items_prefix}${var}.e.oc.x))
 $(foreach var,$(items),$(eval xfiles += ${items_prefix}${var}.oc.x))
@@ -33,7 +41,7 @@ ifeq (${conv_64},1) #to cross compile
 	endif
 #else
 #	ifeq (${platform},win) #to long long
-#		OCONVFLAGS=-
+#		OCONVFLAGS - or plus l
 #	endif
 endif
 
@@ -43,18 +51,19 @@ all: headers ${proj}
 #can't put headers at proj, will phony libactionswf.so
 ${proj}: ${exte} ${eobs}
 	${OLINK} ${logs}
-	$(CC) ${model} ${linkerflags} -shared ${eobs} -o $@ -L. -l:${exte} -e DllMain -Wl,--exclude-libs=${exte}
+	$(CC) ${model} ${linkerflags} -shared ${eobs} -o $@ -L. -l:${exte} -Wl,--exclude-libs=${exte}
 ${exte}: ${obs}
 	$(AR) cr ${exte} $^
+# -e DllMain
 
 headers:
 	$(MAKE) -C ../include
 	$(MAKE) -C ../dev flags.h action_swf.h
 
-%.o: %.oc
+%.o: ${backsrc}%.oc
 	${OCOMP} $< ${OFLAGS} include_sec 1
 	${OCONV} ${OCONVFLAGS} $<.x import
-	$(CC) ${model} -c -w -fPIC ${compilerflags} ${EXTRA_CFLAGS} $*.c -o $@
+	$(CC) ${model} -c -w -fPIC ${compilerflags} ${EXTRA_CFLAGS} ${backsrc}$*.c -o $@
 
 clean:
 	$(MAKE) -C ../include clean
