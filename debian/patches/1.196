-    setcall wid gtk_event_box_new()
-    call packstart_default(box,wid)
-    return wid
+	sd wid
+	setcall wid ov_gtk_event_box_new() #gtk_event_box_new()
+	call packstart_default(box,wid)
+	return wid
 endfunction
 function eventboxfield_cnt(sd box)
