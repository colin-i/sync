--- ocompiler-1.orig/otoc/decl.oc
+++ ocompiler-1/otoc/decl.oc
@@ -1,6 +1,17 @@
 
 #aftercalli
 
+function functiondef_varargs(sd outfile,sd args,sd vargs)
+	if vargs=(Xfile_function_v_no)
+		call writer(outfile)
+	else #varargs
+		if args!=0
+			call writec(outfile)
+		endif
+		call varargs(outfile)
+		callg writer(outfile)
+	end
+end
 function functiondef_d(sv pbuffer,sd outfile)
 	datax args#1;call get_data(pbuffer,#args)
 	if args>=^1
@@ -24,55 +35,39 @@ function functiondef_r(sv pbuffer,sd out
 	end
 	call aftercallenable()
 end
-function functiondef_rw(sv pbuffer,sd outfile,sd pointer,sd sz)
-	call functiondef_r(pbuffer,outfile,pointer,sz)
-	callg writer(outfile)
-end
-function functiondef_ext(sv pbuffer,sd outfile,sd pointer,sd sz)
-	charx e#1;call get_char(pbuffer,#e)
+function functiondef_ext(sv pbuffer,sd outfile,sd pointer,sd sz,sd vargs)
 	sd args;set args functiondef_r(pbuffer,outfile,pointer,sz)
-	if e=(Xfile_function_e_normal)
-		call writer(outfile)
-	else #varargs
-		if args!=0
-			call writec(outfile)
-		endif
-		call varargs(outfile)
-		callg writer(outfile)
-	end
+	callg functiondef_varargs(outfile,args,vargs)
 end
 
-function functiondef_intern(sv pbuffer,sd outfile,sd pointer,sd sz)
+function functiondef_intern(sv pbuffer,sd outfile,sd pointer,sd sz,sd vargs)
 	charx s#1;call get_char(pbuffer,#s)
 	if s=(Xfile_function_t_normal)
-		call functiondef_rw(pbuffer,outfile,pointer,sz)
+		call functiondef_extern(pbuffer,outfile,pointer,sz,vargs)
 	else
 		char a="struct "^
 		call write(outfile,#a,\.a)
 		call write(outfile,pointer,sz)
 		call functiondef_d(pbuffer,outfile)
+		callg writecln(outfile)
 	end
-	callg writecln(outfile)
 end
-function functiondef_raw(sv pbuffer,sd outfile,sd pointer,sd sz)
+function functiondef_raw(sv pbuffer,sd outfile,sd pointer,sd sz,sd vargs)
 	charx s#1;call get_char(pbuffer,#s)
 	if s=(Xfile_function_t_normal)
-		call functiondef_rw(pbuffer,outfile,pointer,sz)
-		set loop.has_entry (TRUE)
-		call writecln(outfile)
+		call functiondef_entry(pbuffer,outfile,pointer,sz,vargs)
 	else #skip struct part, entryraw is only for global variables here, will error if not that
 		call functiondef_d(pbuffer,outfile)
 		callg writenl(outfile)
 	end
 end
-function functiondef_extern(sv pbuffer,sd outfile,sd pointer,sd sz)
-	call functiondef_ext(pbuffer,outfile,pointer,sz)
+function functiondef_extern(sv pbuffer,sd outfile,sd pointer,sd sz,sd vargs)
+	call functiondef_ext(pbuffer,outfile,pointer,sz,vargs)
 	callg writecln(outfile)
 end
-function functiondef_entry(sv pbuffer,sd outfile,sd pointer,sd sz)
-	call functiondef_ext(pbuffer,outfile,pointer,sz)
+function functiondef_entry(sv pbuffer,sd outfile,sd pointer,sd sz,sd vargs)
+	call functiondef_extern(pbuffer,outfile,pointer,sz,vargs)
 	set loop.has_entry (TRUE)
-	callg writecln(outfile)
 end
 
 #D structure
--- ocompiler-1.orig/otoc/loop.oc
+++ ocompiler-1/otoc/loop.oc
@@ -255,13 +255,14 @@ function functiondef(sd outfile,sv pbuff
 	value *entry^functiondef_entry
 
 	charx type#1;call get_char(pbuffer,#type)
+	charx vargs#1;call get_char(pbuffer,#vargs)
 	valuex pointer#1
 	call get_string(pbuffer,#loop.szfunctiondef,#pointer)
 
 	mult type :
 	sv dest^intern;add dest type
 	set dest dest#
-	callg dest(pbuffer,outfile,pointer,loop.szfunctiondef)
+	callg dest(pbuffer,outfile,pointer,loop.szfunctiondef,vargs)
 end
 function iend()
 	if loop.icount!=0
--- ocompiler-1.orig/src/Makefile
+++ ocompiler-1/src/Makefile
@@ -65,6 +65,7 @@ ${OBJ}: ${FULLOBJS} ${etcinclude} ${vers
 
 _ATLDCOM = $(LD) ${linkerflags} -melf_i386 --dynamic-linker=${linker} -lc -entry main -o
 ATLDCOM = ${_ATLDCOM} $@
+ATLDCOM_T_O = $(LD) -melf_i386 --dynamic-linker=${linker} -lc -entry main -o z ${FULLOBJO}
 
 ${etcinclude}:
 	echo sd etchelper=${etchelper}\;ss etc_helper=\"${etc_helper}\" > ${etcinclude}
@@ -86,24 +87,32 @@ clean-compile:
 	-rm -f ${FULLOBJS}.log
 	-rm -f ${etcinclude}
 	-rm -f ${vers}
-
 clean-link:
 	-rm -f o
-
 clean-test:
 	-rm -f ./linux/o
 	-rm -f ./linux/o.oc.log
 	-rm -f ./linux/z
+clean-test-obj:
+	-rm -f ${FULLOBJO}
+	-rm -f z
+	-rm -f zz
 
-clean: clean-compile clean-link clean-test
+clean: clean-compile clean-link clean-test clean-test-obj
 distclean: clean
 
 uninstall:
 	-rm -f $(DESTDIR)$(prefix)/bin/o
 	-rm -f ${PREFFILEFULL}
 
-test:
-	echo "test"
+test-obj:
+	./o linux/obj.oc function_name 1 nul_res_pref 1
+	${ATLDCOM_T_O}
+	./z linux/obj.oc function_name 1 nul_res_pref 1
+	mv z zz
+	${ATLDCOM_T_O}
+	diff z zz
+test: test-obj
 	cd linux; ../o o.oc nul_res_pref 1; mv o z; \
 	if [ -z "${testlinker}" ]; then \
 		cd ../../; /bin/bash ./test32; \
@@ -116,4 +125,4 @@ test:
 #there is a backport in ppa-stagging for jammy
 #still at xenial/bionic but launchpad stop working for ./z . solution? local test
 
-.PHONY: all install install-proj clean clean-compile clean-link clean-test distclean uninstall test
+.PHONY: all install install-proj clean clean-compile clean-link clean-test clean-test-obj distclean uninstall test test-obj
