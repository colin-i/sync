--- ocompiler-1.orig/localtest
+++ ocompiler-1/localtest
@@ -1 +1 @@
-1-5+213
+1-5+214
--- ocompiler-1.orig/o.html
+++ ocompiler-1/o.html
@@ -734,7 +734,7 @@ format elfobj64<br>
 	<br>
 	<b>EntryRaw</b> is an <b>Entry</b> command which is acting like it does not have a value for <b>Ret</b> at the top of the stack and without a calling convention.
 	<br>
-	<b>FunctionX</b> is described at objects. <b>FunctionXX</b> and <b>EntryX</b> will handle the input arguments as if they don't know how many there are (varargs).
+	<b>FunctionX</b> is described at objects. <b>FunctionXV</b> and <b>EntryV</b> will handle the input arguments as if they don't know how many there are (varargs). Varargs are also at other function definitions for otoc.
 	<br>
 	All functions can be used in combinations like <b>AddCall</b>, <b>OrCall</b>, <b>XorCall</b>, etc (<i>set a b()</i> is same as <i>setcall a b()</i>).
 	<br>
@@ -991,8 +991,8 @@ format elfobj64<br>
 	<tr>                                                                                                                                                 <td>Xfile_include_alternative_yes</td>         <td class="red">file<sup-r>s</sup-r></td></tr>
 </table>
 <table id="selection_table">
-	<tr><td rowspan=2>Xfile_functiondef</td><td>Xfile_function_t*</td><td class="red" rowspan=2>name</td><td>Xfile_function_t_*</td><td class="blue" rowspan=2>nr_of_args</td><td class="green" rowspan=2>{D}</td></tr>
-	<tr>                                    <td>Xfile_function_e*</td>                                   <td>Xfile_function_e_*</td></tr>
+	<tr><td rowspan=2>Xfile_functiondef</td><td>Xfile_function_t*</td><td rowspan=2>Xfile_function_v*</td><td class="red" rowspan=2>name</td><td>Xfile_function_t_*</td><td class="blue" rowspan=2>nr_of_args</td><td class="green" rowspan=2>{D}</td></tr>
+	<tr>                                    <td>Xfile_function_e*</td></tr>
 </table>
 <table id="selection_table">
 	<tr><td rowspan=5>Xfile_declare</td><td class="green" rowspan=5>D</td><td>Xfile_declsign_pointer</td>     <td class="red">var/fn</td></tr>
