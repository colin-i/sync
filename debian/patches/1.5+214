 		value pointer#1;data sz#1
 
 		ss extstr=NULL
@@ -579,10 +580,7 @@ Function getcommand(value pcontent,data
 				setcall extstr getcom_declare(ptrsubtype#)
 			endif
 		Elseif command=(cSTARTFUNCTION)
