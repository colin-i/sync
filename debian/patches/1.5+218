--- ocompiler-1.orig/localtest
+++ ocompiler-1/localtest
@@ -1 +1 @@
-1-5+217
+1-5+218
--- ocompiler-1.orig/ocompiler.conf
+++ ocompiler-1/ocompiler.conf
@@ -15,7 +15,7 @@
 #hidden_pref=1
 
 #4. Showed warnings as errors.
-#0 if False; 1 is True
+#0 is False; 1 is True
 #w_as_e=1
 
 #5. Log file. This option creates a file with string lines. The files tree and virtual offset are logged.
@@ -99,4 +99,8 @@
 
 #24. Make .x file.
 #0 is No; 1 is Yes; 2 is Yes_strict without making exe/elf
-#x_file=0
\ No newline at end of file
+#x_file=0
+
+#25. Warn on callret;endfunction
+#0 is No and Error; 1 is Yes
+#callret_end_warn=1
\ No newline at end of file
