--- ocompiler-1.orig/src/files/actions/main/index.oc
+++ ocompiler-1/src/files/actions/main/index.oc
@@ -190,7 +190,7 @@ if errormsg=(noerror)
 			ElseIf commandset=(cRET)
 		call entryscope_verify_code()
 				setcall errormsg xfile_add_char_if((Xfile_ret));if errormsg=(noerror)
-					setcall errormsg writeret();endif
+					setcall errormsg writeret((ret_cont_break_mustskip));endif
 			ElseIf commandset=(cINCLUDELINK)
 				Include "./index/include.oc"
 			ElseIf commandset=(cFORMAT)
--- ocompiler-1.orig/src/files/functions/commands/cond.oc
+++ ocompiler-1/src/files/functions/commands/cond.oc
@@ -376,7 +376,7 @@ Function closeifopenelse(sd xfile_type)
 				Data elsenr=elsenumber
 				SetCall err condbeginwrite(elsenr)
 			endif
-		else # ret_cont_break_canskip ret_cont_break_mustskip ret_cont_break_notyet
+		else # ret_cont_break_canskip ret_cont_break_canskip_warn ret_cont_break_mustskip ret_cont_break_notyet
 			if main.ret_cont_break!=(ret_cont_break_notyet) #is useless JMP, if no previous JMP in this ifinscribe, is also useless ELSE
 				setcall err elseg()
 				If err!=noerr
--- ocompiler-1.orig/src/files/functions/commands/ret.oc
+++ ocompiler-1/src/files/functions/commands/ret.oc
@@ -1,6 +1,6 @@
 
 #err
-function writeret()
+function writeret(sd type)
 	sd err
 	sd termswitch
 	sd continuation
@@ -16,7 +16,7 @@ function writeret()
 		setcall continuationsize getreturn(#continuation)
 		setcall err addtosec(continuation,continuationsize,ptrcodesec)
 	endelse
-	set main.ret_cont_break_marker (ret_cont_break_mustskip)
+	set main.ret_cont_break_marker type
 	return err
 endfunction
 
@@ -30,7 +30,7 @@ function after_after_call(sd subtype)
 	setcall subtype callret_flag(subtype)
 	if subtype!=0
 		sd err
-		setcall err writeret()
+		setcall err writeret((ret_cont_break_canskip_warn)) #if was only o, mustskip was a rule, but at otoc this is: return operation
 		return err
 	endif
 	return (noerror)
--- ocompiler-1.orig/src/files/functions/global/end.oc
+++ ocompiler-1/src/files/functions/global/end.oc
@@ -28,10 +28,25 @@ function endfunction(sd parses)
 					setcall sizereturn getreturn(ptrptrreturn)
 					SetCall err addtoCode_set_programentrypoint(ptrreturn,sizereturn)
 					If err!=(noerror);return err;endif
-				elseif main.ret_cont_break=(ret_cont_break_canskip)
+				elseif main.ret_cont_break=(ret_cont_break_mustskip)
+					vstr uselessret="Previous RET was useless."
+					return uselessret
+				else
 					call set_programentrypoint()
-				else # ret_cont_break_mustskip
-					return "Previous RET was useless."
+					if main.ret_cont_break=(ret_cont_break_canskip_warn)
+						if main.xbool!=(Yes_strict) #at c is ok, is return argument
+							whiletrue
+								if main.xbool=(Yes)
+									if main.callret_end_warn=(Yes)
+										call Message("CallRet;EndFunction warning") #at c more important
+										break
+									end
+								end
+								return uselessret ##at only o or o more important
+							end
+						end
+					end
+					#else ret_cont_break_canskip
 				endelse
 				setcall err scopes_store(main.functionTagIndex)
 				If err=(noerror)
