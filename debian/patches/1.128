--- actionswf-1.orig/dev/actionswf.h
+++ actionswf-1/dev/actionswf.h
@@ -1,7 +1,7 @@
 
 #define flag_forin1 0x20
 #define flag_framesAsShows 0x40
-#define flag_pool_write 0x100
+#define flagpre_pool_write 0x100
 #define flag_pool_read 0x200
 
 #ifdef __cplusplus
--- actionswf-1.orig/dev/flags.oh
+++ actionswf-1/dev/flags.oh
@@ -1,21 +1,28 @@
 
-const debug_none=0
-const debug_log=0x1
-const debug_alt=0x2
-const debug_titles=0x4
-const debug_x=0x8
-const debug_x_pad=0x10
+#init order is: pool x log alt titles asShows forin
+#a good workflow(for ffdec and oadbg): prexx_flags|flagpre_mix|flagpre_write_no,xx_flags|flag_titles,xx_flags|flag_compress,oaalternative with flag_alt|flag_pool_read_unlink|flag_compress
+#or:                              prexx_flags|flagpre_mix,oaalternative with flag_alt|flag_pool_read,xx_flags|flag_titles  ,xx_flags|flag_pool_read_unlink|flag_compress
 
+const flag_none=0
+const flagpre_log=0x1
+const flag_alt=0x2
+const flag_titles=0x4
+const flagpre_x=0x8           #oaalternative will try to if the log has prexx data
+const flagpre_x_pad=0x10
 const flag_forin1=0x20
 const flag_framesAsShows=0x40
+const flag_x=0x80             #will turn off antix_read flags
+const flagpre_pool_write=0x100
+const flag_pool_read=0x200    #will turn off flag_pool_write
+const flagpre_mix=0x400
+const flag_pool_read_unlink=0x800
+const flagpre_write_no=0x1000
+const flag_compress=0x2000
 
-const flag_x=0x80           #will turn off antix_read flags
-const flag_pool_write=0x100
-const flag_pool_read=0x200  #will turn off flag_pool_write
-
-const debug_xpad=debug_x|debug_x_pad
-const flags_pool=flag_pool_write|flag_pool_read
-const flags_x=debug_x|flag_x
-const prexx_flags=debug_log|flag_pool_write|debug_x
-const xx_flags=debug_log|flag_pool_read|flag_x
-const antix_read=debug_log|debug_alt|debug_xpad
+const debug_xpad=flagpre_x|flagpre_x_pad
+const flags_pool=flagpre_pool_write|flag_pool_read
+const flags_x=flagpre_x|flag_x
+const prexx_flags=flagpre_log|flagpre_pool_write|flagpre_x #will turn off antixx_write
+const xx_flags=flag_pool_read|flag_x
+const antix_read=flagpre_log|flag_alt|debug_xpad
+const antixx_write=flag_titles                             #oad and ffdec are counting on this
