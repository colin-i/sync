--- actionswf-1.orig/s32
+++ actionswf-1/s32
@@ -8,8 +8,9 @@ reln () {
 		ln ../actionswf-1/tests/.expected/${1} ${here}
 	fi
 }
-reln data32.txt
 reln a.swf.x32.txt
+reln data32.txt
+reln example.swf.data32
 
 if [ -n "${mirror}" ]; then git pull local master; fi && \
 if [ -z "${1}" ]; then make clean && cd src && ./mr32d && cd ../example && ./mr32d && cd ..; fi && \
--- actionswf-1.orig/tests/data/test
+++ actionswf-1/tests/data/test
@@ -27,17 +27,18 @@ if [ $? != 0 ]; then
 	cat data.txt>../.expected/data${e}.txt #a mv was here but now data32.txt is a hard link and will break that
 fi
 
-diff ../.expected/example.swf.data ${etest}
+etestexp=../.expected/example.swf.data${e}
+diff ${etestexp} ${etest}
 if [ $? -ne 0 ]; then
 	if [ -n "${1}" ]; then exit 1; fi
 	source ../xxd
-	xxd${xxd_args} ../.expected/example.swf.data > 1
+	xxd${xxd_args} ${etestexp} > 1
 	xxd${xxd_args} ${etest} > 2
 	diff --color 1 2
 	rm 1 2
 	echo y \?; read -n1 -t $((60*60*24)) ans
 	if [ "${ans}" != "y" ]; then exit 1; fi
-	cp ${etest} ../.expected
+	cp ${etest} ${etestexp}
 fi
 
 rm data.txt
