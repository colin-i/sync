--- actionswf-1.orig/example/Makefile
+++ actionswf-1/example/Makefile
@@ -58,7 +58,7 @@ link:
 		if [ "${conv_64}" = "1" ]; then \
 			$(LD) ${linkerflags} -melf_i386 --dynamic-linker=/lib/ld-linux.so.2 ${name}.o -entry main -o ${name} -lc -lz -L${_L} -l:${libname}; \
 		elif [ -z "${ldprefer}" ]; then \
-			$(CC) ${linkerflags} ${name}.o -o ${name} -L${_L} -l:${libname}; \
+			$(CC) ${linkerflags} ${name}.o -o ${name} -lz -L${_L} -l:${libname}; \
 		else \
 			$(LD) ${linkerflags} --dynamic-linker=/lib64/ld-linux-x86-64.so.2 ${name}.o -entry main -o ${name} ${L} -lc -lz -L${_L} -l:${libname}; \
 		fi \
@@ -112,7 +112,7 @@ expected.swf:
 test: expected.swf
 	diff ${sfile} expected.swf
 expected.c.swf: build
-	$(MAKE) -f Makefile x3=x
+	x3=x $(MAKE) exe
 	mv example.swf $@
 
 .PHONY: all build uns lib link exe install clean distclean uninstall test
--- actionswf-1.orig/tests/asv
+++ actionswf-1/tests/asv
@@ -12,13 +12,13 @@ o a.oc logfile 0 conv_64 ${conv_64} ${in
 			LD_LIBRARY_PATH=/home/bc/Desktop/out/ld/usr/lib/i386-linux-gnu /home/bc/Desktop/out/ld/usr/bin/i686-linux-gnu-ld.bfd \
 				--dynamic-linker=/lib/ld-linux.so.2 a.o -entry main -lc -lz -L${_L}../src -lactionswf
 		else
-			cc a.o -L${_L}../src -lactionswf
+			cc a.o -lz -L${_L}../src -lactionswf
 		fi
 	else
 		if [ -z "${LD_LIBRARY_PATH}" ]; then
-			cc a.o -L${_L}../src -lactionswf
+			cc a.o -lz -L${_L}../src -lactionswf #local cc has -lz? bionic i386 cc has no -lz? who cares
 		else
-			cc a.o -L${LD_LIBRARY_PATH} -lactionswf
+			cc a.o -lz -L${LD_LIBRARY_PATH} -lactionswf
 		fi
 	fi && {
 		if [ -z "${LD_LIBRARY_PATH}" ]; then LD_LIBRARY_PATH=${_L}../src; fi
