--- actionswf-1.orig/Makefile
+++ actionswf-1/Makefile
@@ -1,7 +1,7 @@
 
 MEDTARGETS := test clean distclean
 TOPTARGETS := all install uninstall
-#distclean is called for configures (unexistent here, then, is deprecated for us)
+#distclean is called at launchpad build, for here if there were configures
 
 SUBDIRS := dev src oad
 ALLDIRS := example $(SUBDIRS)
--- actionswf-1.orig/example/Makefile
+++ actionswf-1/example/Makefile
@@ -111,7 +111,7 @@ uninstall:
 expected.swf:
 	base64 -d expected.c.swf.txt > expected.c.swf
 	ffdec -decompress expected.c.swf $@
-test: expected.swf
+test: all expected.swf
 	diff ${sfile} expected.swf
 expected.c.swf: build
 	x3=x $(MAKE) exe
--- actionswf-1.orig/example/entry.oc
+++ actionswf-1/example/entry.oc
@@ -1,11 +1,3 @@
 
 entryraw main(sd argc,sd *argv0,ss *argv1)
-sd flags
-if argc=1
-	set flags (flags1)
-elseif argc=2
-	set flags (flags2)
-else
-	set flags (flags3)
-end
 #sub argv1# 0x30
--- actionswf-1.orig/example/entry_arg.oc
+++ actionswf-1/example/entry_arg.oc
@@ -1,11 +1,3 @@
 
 entry main(sd argc,sv *argv)
-sd flags
-if argc=1
-	set flags (flags1)
-elseif argc=2
-	set flags (flags2)
-else
-	set flags (flags3)
-end
 #incst argv;ss argv1;set argv1 argv#;sub argv1# 0x30
--- actionswf-1.orig/example/example.oc
+++ actionswf-1/example/example.oc
@@ -5,6 +5,9 @@ format elfobj64
 importx "sprintf" sprintf
 importx "_exit" exit
 
+include "entry_arg.oc" "entry.oc"
+
+override include_sec 1
 einclude "../dev/import.oh"
 
 const width=640
@@ -18,7 +21,15 @@ const flags1=flagpre_log|flagpre_pool_wr
 const flags2=xxu_flags   ;#for tests/data . flag_compress is at ffdec test, and here will compare from 2 different(maybe) zlibs
 const flags3=flags2|flag_compress
 
-include "entry_arg.oc" "entry.oc"
+sd flags
+if argc=1
+	set flags (flags1)
+elseif argc=2
+	set flags (flags2)
+else
+	set flags (flags3)
+end
+
 call xlog_pad_set(0x30)
 
 call swf_new_ex("example.swf",(width),(height),0x001100,24,flags)
