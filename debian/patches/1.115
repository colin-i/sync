+							if log=(TRUE)
+								call tree_init()
+							end
+							set exit loop(logcontent,xcontent,xxcontent,logsize,#presprites,#sprites,poadata#,log)
 							if exit=(EXIT_SUCCESS)
-								call presprite_done(sprites,0,0,poadata#) #root has not a done(0 to 0) in .log
-								set exit inter(swf_fullpath)
+								if log=(TRUE)
+									set exit tree_exit()
+								end
+								if exit=(EXIT_SUCCESS)
+									set exit presprite_done(sprites,0,0,poadata#) #root has not a done(0 to 0) in .log
+									if exit=(EXIT_SUCCESS)
+										set exit inter(swf_fullpath)
+									end
+								end
 							end
 						end
 						call preoadata_free(presprites,sprites,log,xcontent)
@@ -182,3 +198,16 @@ functionx oadata_free(sv data,charx log)
 		call free(data)
 	end
 end
+
+functionx oadata_logpad_get()
+	return global.logpad
+end
+functionx oadata_logpad_set(charx a)
+	if a!=0
+		set global.logpad a
+	else
+		set global.logpad 1
+	end
+end
+
