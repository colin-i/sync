-		call branch_free(br#:branch.subbranch,logstart)
+		if logstart!=(NULL)
+			call tree_entrylive(indents,(xlog_branch))
+		end
+		call branch_free(br#:branch.subbranch,logstart,indents)
 	end
 	call free(br)
 end
