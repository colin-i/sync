--- actionswf-1.orig/csrc/Makefile
+++ actionswf-1/csrc/Makefile
@@ -36,6 +36,8 @@ $(foreach var,$(expitems),$(eval cfiles
 $(foreach var,$(items),$(eval cfiles += ${items_prefix}${var}.c))
 
 ifeq (${conv_64},1) #to cross compile
+	OCONVFLAGS=-s
+#yes, was not set earlier at arm64 when cross for armhf(even setting CC to armhf will change that), and i386 is not like x86_64 in terms of va_list
 	ifneq ($(CC),arm-linux-gnueabihf-gcc)
 		model=-m32
 	endif
--- /dev/null
+++ actionswf-1/csrc/m32d
@@ -0,0 +1 @@
+conv_64=1 ./md
--- /dev/null
+++ actionswf-1/csrc/m32dr
@@ -0,0 +1 @@
+CC=arm-linux-gnueabihf-gcc ./m32d
--- actionswf-1.orig/tests/ac
+++ actionswf-1/tests/ac
@@ -2,8 +2,8 @@
 if [ -z "${old}" ]; then
 	L1=../csrc
 	LD_LIBRARY_PATH=${L1}
-	CC=cc
-	if [ -n "${expand}" ]; then
+	if [ -z "${CC}" ]; then CC=cc; fi
+	if [ "${expand}" = x ]; then
 		shopt -s expand_aliases #for gd
 		source ~/aliases
 	fi
--- /dev/null
+++ actionswf-1/tests/ac32r
@@ -0,0 +1 @@
+conv_64=1 CC=arm-linux-gnueabihf-gcc ./ac
--- actionswf-1.orig/tests/bc
+++ actionswf-1/tests/bc
@@ -1 +1,6 @@
-launcher='gd --args' expand=x ./ac
\ No newline at end of file
+
+if [ -z "${expand}" ]; then
+	launcher='gd --args' expand=x ./ac
+else
+	launcher='gdb --args' ./ac
+fi
