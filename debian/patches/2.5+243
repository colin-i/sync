--- ocompiler-2.orig/otoc/decl.oc
+++ ocompiler-2/otoc/decl.oc
@@ -111,6 +111,12 @@ function decl(sv pbuffer,sd outfile,ss p
 	call get_char(pbuffer,pfield)
 	datax sz#1;valuex pointer#1
 	if pfield#!=(Xfile_declfield_const)
+		if ptype!=(NULL) #from declare, not function arg
+			if loop.innerfunction=(FALSE)
+				char s="static "^
+				call write(outfile,#s,\.s)
+			end
+		end
 		call decl_runtime(pbuffer,outfile,pfield#,ptype)
 		call get_string(pbuffer,#sz,#pointer)
 	else
--- ocompiler-2.orig/otoc/loop.oc
+++ ocompiler-2/otoc/loop.oc
@@ -46,6 +46,8 @@ function loop(sd pointer,sd delim,sd out
 	set function_start (err)
 	valuex function_start_base#1
 	set function_start_base (err)
+	charx innerfunction#1
+	set innerfunction (FALSE) #function_start is only until first return, and is not at structs
 	charx indentation#1
 	set indentation 0
 	charx same_line#1
@@ -279,6 +281,8 @@ function comment(sd outfile,sv pbuffer)
 	callg writenl(outfile)
 end
 function functiondef(sd outfile,sv pbuffer)
+	set loop.innerfunction (TRUE)
+
 	value intern^functiondef_intern
 	value *raw^functiondef_raw
 	value *extern^functiondef_extern
@@ -508,6 +512,7 @@ function end(sd outfile,sv pbuffer)
 	charx type#1;call get_char(pbuffer,#type)
 	if type=(Xfile_end_func)
 		set loop.function_start_base (err)
+		set loop.innerfunction (FALSE)
 	end
 	callg writecrtn(outfile)
 end
@@ -546,8 +551,8 @@ function import_name(sd *outfile,sv pbuf
 	datax sz#1;valuex name#1
 	call get_string(pbuffer,#sz,#name)
 end
-function aftercall(sd outfile,sv pbuffer)
-	call backindent(outfile)
+function aftercall(sd *outfile,sv pbuffer)
+	call unimplemented("aftercall")
 	charx acall#1;call get_char(pbuffer,#acall)
 	if acall<=(Xfile_aftercall_declarative)
 		if acall=(Xfile_aftercall_declare)
@@ -658,6 +663,9 @@ function write(sd outfile,ss buf,sd sz)
 			set items mwrite(buf,sz,outfile)
 		end
 		if items!=1
+			#if sz=0
+			call puts("0 size write. or write error") #example declare with unref, but not only
+			#end
 			call aftercallenable()
 		end
 	end
