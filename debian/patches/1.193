+exe = ${e}capture/save ${e}debug ${e}help ${e}init ${e}mainhandles ${e}mediainfo ${e}mix ${e}ostream ${e}start ${e}uri ${e}uristream
 f=file-folder/
 ffl = ${f}file-base ${f}folder-base
 gnu = gnu/gst
