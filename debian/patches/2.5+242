@@ -110,7 +110,11 @@ Function addvarreference(sv ptrcontent,s
 			endelse
 			or mask (stackbit)
 			sd vbool
-			if typenumber=(stackvaluenumber);set vbool (TRUE);else;setcall vbool sd_as_sv((sd_as_sv_bool),typenumber);endelse
+			if typenumber=(stackvaluenumber)
+				set vbool (TRUE)
+			else
+				setcall vbool sd_as_sv((sd_as_sv_bool),typenumber)
+			endelse
 			if vbool=(TRUE)
 				or mask (pointbit)
 			endif
--- ocompiler-2.orig/src/files/functions/actions/declare.oc
+++ ocompiler-2/src/files/functions/actions/declare.oc
@@ -67,7 +67,7 @@ function declare(sv pcontent,sd pcomsize
 		endelse
 	elseif declare_typenumber=(vstringnumber)
 		set is_stack (FALSE);set typenumber (stringnumber)
-		if bool_64=(TRUE);set mask (datapointbit)
+		if bool_64=(TRUE);set mask (stringslongmask)
 			if parses=(pass_init)
 				set unitsize (qwsz)
 			else
@@ -138,25 +138,26 @@ function declare(sv pcontent,sd pcomsize
 				endelse
 			endelse
 		else
+			set mask (dummy_mask)   #at pass_write, mask is used where stack is false (dataassign with stack false, descend into enumcomma and writevar again with stack false)
+			# at stack at bigstringbit
 			if is_stack=(TRUE)
 				#must be at the start
 				call entryscope_verify_code()
 
-				#xfile part
 				if typenumber=(valuesinnernumber)
 					set xfile_decltype (Xfile_decltype_long)
 				elseif typenumber=(integernumber)
 					set xfile_decltype (Xfile_decltype_longInt)
 				elseif typenumber=(stringnumber)
 					set xfile_decltype (Xfile_decltype_longByte)
+					if bool_64=(TRUE)
+						set mask (bigstringbit)
+					endif
 				else
 				#if typenumber=(wordnumber)
 					set xfile_decltype (Xfile_decltype_longWord)
 				endelse
 			else
-				set mask (dummy_mask)   #at pass_write, mask is used where stack is false (dataassign with stack false, descend into enumcomma and writevar again with stack false)
-				#                                         at stack is beginning with dummy_mask
-
 				#xfile part
 				if typenumber=(constantsnumber)
 					set xfile_decltype (Xfile_decltype_const)
--- ocompiler-2.orig/src/files/functions/actions/enumcomma.oc
+++ ocompiler-2/src/files/functions/actions/enumcomma.oc
@@ -7,7 +7,7 @@ function writevar(sd ptrvalue,sd unitsiz
 	data false=FALSE
 	data ptrobject%ptrobject
 
-	sd for_64;sd test
+	sd for_64;sd extval
 
 	if stack=false
 		data ptrdatasec%%ptr_datasec
@@ -41,21 +41,8 @@ function writevar(sd ptrvalue,sd unitsiz
 		endif
 		SetCall err addtosec(ptrvalue,unitsize,ptrdatasec);If err!=noerr;Return err;EndIf
 		if long_mask!=(dummy_mask)
-			whiletrue
-				if is_signed=(Xfile_declext_no) #signed (default) for long
-					set test (sign_bit)
-					and test ptrvalue#
-					if test!=0
-						data negative=-1
-						SetCall err addtosec(#negative,(dwsz),ptrdatasec)
-						break
-					end
-				end
-				data null=0
-				SetCall err addtosec(#null,(dwsz),ptrdatasec)
-				break
-			endwhile
-			return err
+			setcall extval writevar_ext(is_signed,long_mask,ptrvalue#)
+			callret addtosec(#extval,(dwsz),ptrdatasec)
 		endif
 		return (noerror)
 	endif
@@ -81,24 +68,30 @@ function writevar(sd ptrvalue,sd unitsiz
 	endif
 	if rightstackpointer!=(NULL)
 		#s^s
-		setcall err addtocodeforstack(rightstackpointer,for_64)
-	else
-		#s=consts
-		whiletrue
-			if is_signed=(Xfile_declext_no) #signed (default) ,stack values are long
-				set test (sign_bit)
-				and test ptrvalue#
-				if test!=0
-					#keep sign, for comparations
-					setcall err addtocodefordata(ptrvalue#,for_64,-1)
-					break
-				end
-			end
-			setcall err addtocodefordata(ptrvalue#,for_64,0)
+		callret addtocodeforstack(rightstackpointer,for_64)
+	endif
+	#s=consts
+	setcall extval writevar_ext(is_signed,long_mask,ptrvalue#)
+	callret addtocodefordata(ptrvalue#,for_64,extval)
+endfunction
+#0/-1
+function writevar_ext(sd is_signed,sd mask,sd val)
+	and mask (bigstringbit)
+	whiletrue  #same as at imm dependent
+		if is_signed=(Xfile_declext_no)
+			if mask!=0
+				break
+			endif
+		elseif mask=0
 			break
-		endwhile
-	endelse
-	return err
+		endelseif
+		and val (sign_bit)
+		if val!=0
+			return -1
+		endif
+		break
+	endwhile
+	return 0
 endfunction
 
 const fndecandgroup=1
--- ocompiler-2.orig/src/files/functions/actions/fndecargs.oc
+++ ocompiler-2/src/files/functions/actions/fndecargs.oc
@@ -70,6 +70,9 @@ Function fndecargs(sv ptrcontent,sd ptrs
 			set xfile_decltype (Xfile_decltype_longInt)
 		elseif vartype=(stackstringnumber)
 			set xfile_decltype (Xfile_decltype_longByte)
+			if b=(TRUE)
+				or long_mask (bigstringbit) #only this OR is ignored at 32, but why to OR?
+			endif
 		elseif vartype=(stackvaluenumber)
 			set xfile_decltype (Xfile_decltype_long)
 		else
@@ -88,8 +91,12 @@ Function fndecargs(sv ptrcontent,sd ptrs
 				set xfile_decltype (Xfile_decltype_long)
 			else
 				if b=(TRUE)
-					or long_mask (datapointbit)
 					set datasize (qwsz)
+					if vartype=(stringnumber)
+						or long_mask (stringslongmask)
+					else
+						or long_mask (datapointbit)
+					endelse
 				endif
 				if vartype=(integernumber)
 					set xfile_decltype (Xfile_decltype_longInt)
--- ocompiler-2.orig/src/files/functions/argument/imm.oc
+++ ocompiler-2/src/files/functions/argument/imm.oc
@@ -101,9 +101,18 @@ endfunction
 function write_imm_sign_dependent(sd val,sd regopcode,sd dataargdependent)
 	sd s
 	set s signbit(dataargdependent)
-	if s=0 #signed (default)
+	sd t
+	set t bstringsbit(dataargdependent)
+	whiletrue
+		if s=0 # not u/s sign (default)
+			if t!=0
+				break #ss/vstr[x]
+			endif
+		elseif t=0
+			break # sdu/svu/vdata[x]u/value[x]u
+		endelseif
 		callret write_imm_sign(val,regopcode)
-	end
+	endwhile
 	#unsigned
 	callret write_imm_simple(val,regopcode)
 endfunction
--- ocompiler-2.orig/src/files/functions/dataassign.oc
+++ ocompiler-2/src/files/functions/dataassign.oc
@@ -43,7 +43,7 @@ Function dataassign(sd ptrcontent,sd ptr
 				setcall immovable_struct_cont getstructcont(sectiontypenumber)
 				call getcontReg(immovable_struct_cont,#reg)
 				#
-				SetCall err addvarreferenceorunref_signed(ptrcontent,ptrsize,valsize,sectiontypenumber,(dummy_mask),is_signed,0) #there is 1 more argument but is not used
+				SetCall err addvarreferenceorunref_signed(ptrcontent,ptrsize,valsize,sectiontypenumber,long_mask,is_signed,0) #there is 1 more argument but is not used
 			else
 				#
 				setcall immovable_struct_cont getstructcont(typenumber)
--- ocompiler-2.orig/src/files/functions/mask.oc
+++ ocompiler-2/src/files/functions/mask.oc
@@ -38,6 +38,9 @@ endfunction
 function signbit(sd pointer)
 	callret data_get_maskbit(pointer,(signbit))
 endfunction
+function bstringsbit(sd pointer)
+	callret data_get_maskbit(pointer,(bigstringbit))
+endfunction
 
 function stack_get_relative(sd location)
 	sd mask
--- ocompiler-2.orig/src/files/headers/header.oh
+++ ocompiler-2/src/files/headers/header.oh
@@ -37,11 +37,15 @@ const signbit=0x200
 #bit offset 10: struct like bit
 const structbit=0x400
 
-#11,12,13,14,15
+#bit offset 11: atm is used only at 64 at sss/ss,... at args2 to get imm sign/zero extended
+const bigstringbit=0x800
+
+#12,13,14,15
 #16-31: reserve units
 
 const dummy_mask=0
 const valueslongmask=datapointbit|pointbit
+const stringslongmask=datapointbit|bigstringbit
 const location_bits=stackbit|expandbit
 const stack_location_bits=location_bits|stackrelativebit    #and expandbit? will be always 0 at stack, keep it clean from what we combine
 
