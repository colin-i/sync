+function mainfn(sv s,sd ignores)
+	#sd s;incst argv;set s argv#
+	sd f;setcall f fopen(s,"rb")
+	if f!=(NULL)
+		sd out;set out out_file(s)
+		sd exitval
+		if out!=(NULL)
+			set exitval preloop(f,out,ignores)
+			call fclose(out)
+		else
+			set exitval (EXIT_FAILURE)
+		end
+		call fclose(f)
+		return exitval
+	end
+	call puts("Cannot open input file")
+	return (EXIT_FAILURE)
+end
+
+include "loop.oc"
+
+#aftercalli
+
