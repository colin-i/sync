+function variadic(sv pbuffer,sd outfile)
+	charx type#1;call get_char(pbuffer,#type)
+importx "printf" qwe
+call qwe("%u\n",type)
+	if type!=(Xfile_variadic_end)
+		datax sz#1;valuex name#1
+		call get_string(pbuffer,#sz,#name)
+		if type=(Xfile_variadic_begin)
+			char va_list="va_list "^
+			char va_list_name="the_va_list"^
+			call write(outfile,#va_list,\.va_list+\.va_list_name)
+			call writet(outfile)
+			char va_start="va_start("^
+			call write(outfile,#va_start,\.va_start)
+			call write(outfile,#va_list_name,\.va_list_name)
+			call writec(outfile)
+			call write(outfile,name,sz)
+			call writertnl(outfile)
+		else
+			call write(outfile,name,sz)
+			call writee(outfile)
+			char va_arg="va_arg("^
+			call write(outfile,#va_arg,\.va_arg)
+			call write(outfile,#va_list_name,\.va_list_name)
+			call writec(outfile)
+			call write_long(outfile)
+			call writertnl(outfile)
+		end
+	else
+		char va_end="va_end(the_va_list)"^
+		callg writetn(outfile,#va_end,\.va_end)
+	end
+end
 function proto(sd outfile,sv pbuffer)
 	charx type#1;call get_char(pbuffer,#type)
 	ss buf;set buf pbuffer#
@@ -608,7 +645,7 @@ function proto(sd outfile,sv pbuffer)
 		end
 		call proto_core(outfile,pbuffer)
 		inc pbuffer#
-		callg proto_close(outfile)
+		callg writertnl(outfile)
 	else #Xfile_function_t_struct
 		set pbuffer# buf
 	end
@@ -635,10 +672,6 @@ function proto_open(sd outfile,sv pbuffe
 	call write_long_pointer(outfile,name,sz)
 	callg writel(outfile)
 end
-function proto_close(sd outfile)
-	call writer(outfile)
-	callg writetn(outfile)
-end
 
 function else_core(sd outfile)
 	char a="else"^
@@ -771,21 +804,30 @@ function writecln(sd outfile)
 	call writecl(outfile)
 	callg writenl(outfile)
 end
-function writen(sd outfile,ss buf,sd sz)
-	call write(outfile,buf,sz)
-	callg writenl(outfile)
-end
 function writeslsr(sd outfile)
 	call writesl(outfile)
 	callg writesr(outfile)
 end
-function writetn(sd outfile) #terminator newline
+function writetnl(sd outfile) #terminator newline
 	call writet(outfile)
 	callg writenl(outfile)
 end
+function writertnl(sd outfile)
+	call writer(outfile)
+	callg writetnl(outfile)
+end
 function writecrtn(sd outfile)
 	call writecr(outfile)
-	callg writetn(outfile) #with termination only for struct
+	callg writetnl(outfile) #with termination only for struct
+end
+
+function writen(sd outfile,ss buf,sd sz)
+	call write(outfile,buf,sz)
+	callg writenl(outfile)
+end
+function writetn(sd outfile,ss buf,sd sz)
+	call write(outfile,buf,sz)
+	callg writetnl(outfile)
 end
 
 function fprintu(sd outfile,sd c)  #has an upper write_allow check
