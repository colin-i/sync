 	callret action_parse_right(pointer,(Semicolon))
 end
 import "part_of_variable" part_of_variable
+#pointer - pointer is right after a call's closing ')'. If what follows is .name( parse it as a call
+#on the previous call's return value, else return pointer unchanged.
+#The chained call tokens go before the call they apply to: CallMethod pops name,object,nrargs,args,
+#so its args must be pushed first and the object (the inner call's result) last.
+#[begin,mid)=calls parsed so far, [mid,end)=the new chained call; they are swapped to [chain][inner]
+#with a member path (a().x.d()) [begin,mid) also has the path tokens: [chain][inner][path]
+#pointer
+function action_code_parse_call_chain(ss ac,sd ?begin)
+	if ac#!=(Period)
+		return ac
+	end
+	#.name( or .member[..].name( : walk over the members to find the last .name before '('
+	ss pos;set pos ac
+	ss last_dot
+	ss name ;#start of the last name. 0 if the last element was a [..]
+	whiletrue
+		if pos#=(Period)
+			set last_dot pos
+			inc pos
+			set name pos
+			ss ?sz
+			setcall sz part_of_variable(pos)
+			if sz=0 #no name after the dot
+				return ac
+			end
+			whiletrue
+				add pos sz
+				setcall sz part_of_variable(pos)
+				if sz=0
+					break
+				end
+			end
+		elseif pos#=(Openingbracket)
+			setcall pos brackets_test(pos)
+			set name 0
+		else
+			break
+		end
+	endwhile
+	if pos#!=(Openparenthesis) #.member : not a call
+		return ac
+	end
+	if name=0 #[1]( : not a plain method call on a member
+		return ac
+	end
+	sd ?type;set type (call_chain_left)
+	if last_dot!=ac
+		#.x.d() : apply the path before the final method name to the previous call's result
+		set type (call_chain_path)
+		#the last dot is nulled: member tokens retain string pointers for write time
+		set last_dot# (Nullchar)
+		call action_code_set((args_end)) #sentinel, like at action_code_call_member_tail
+		call action_code_member_body(ac,0)
+	end
+	sd ?mid;setcall mid action_code_values_index_get()
+	ss pointer;setcall pointer action_code_parse_new_or_call(name,type,name)
+	if pointer=name
+		call error("chained call expected")
+	end
+	sd ?end;setcall end action_code_values_index_get()
+	call action_code_values_rotate(begin,mid,end)
+	return pointer
+endfunction
+#swap adjacent token ranges [begin,mid) and [mid,end), units are DWORDs like action_code_values_index.
+#offsets, not pointers: the values container can be reallocated while parsing
+function action_code_values_rotate(sd ?begin,sd ?mid,sd ?end)
+	sd base;setcall base action_code_values()
+	sd first;set first mid;sub first begin;mult first (DWORD)
+	sd second;set second end;sub second mid;mult second (DWORD)
+	sd offset;set offset begin;mult offset (DWORD);add base offset
+	sd tmp;set tmp malloc(first)
+	if tmp=0
+		call error("memory")
+	end
+	call memcpy(tmp,base,first)
+	ss source;set source base;add source first
+	call memmove(base,source,second)
+	add base second
+	call memcpy(base,tmp,first)
+	call free(tmp)
+endfunction
 #pointer
 function action_code_parse_new_or_call(ss ac,sd ?type,ss cursor)
 	ss pointer
@@ -1479,6 +1581,7 @@ function action_code_parse_new_or_call(s
 endfunction
 #pointer
 function action_code_parse_function_detected(ss start,ss last_dot,ss pointer,sd ?type)
+	sd ?marker;setcall marker action_code_values_index_get() #after pointer_prefix (-a()), which stays before the call
     #function mark
     call action_code_set(type)
     set pointer# 0
@@ -1494,6 +1597,7 @@ function action_code_parse_function_dete
     endelse
     setcall pointer action_code_parse_function_arguments(pointer)
     call action_code_set((args_end))
+	set globalp.call_begin marker ##here, not before: arguments can contain calls too
     return pointer
 endfunction
