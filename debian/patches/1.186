--- actionswf-1.orig/csrc/Makefile
+++ actionswf-1/csrc/Makefile
@@ -6,7 +6,10 @@ ifndef OCONV
 OCONV=otoc
 endif
 ifndef linkerflags
-linkerflags=-O3 -march=native -s
+ifndef arch
+arch=native
+endif
+linkerflags=-O3 -march=$(arch) -s
 # -flto currently breaks. ... block_get_size is pointer(translator), int when we use it, at == 0 comparation lto if having O1 will skip
 #	when trying to find what lto/O mix, -fno-strict-aliasing will produce less crashes
 endif
--- actionswf-1.orig/include/action.oh
+++ actionswf-1/include/action.oh
@@ -36,6 +36,8 @@ const ifElse_start=0xfd0DD0d0         #R
 const for=0xfe0EE0e0                  #1
 const do_start=0xfe0FF0f0             #1
 const label=0xff0FF0f0                #L
+const call_chain_left=0xff0AA0a0      #1 CL RH
+const call_chain_path=0xff0BB0b0      #1 CL RH
 
 const no_flag=0                        #code only
 const consecutive_flag=0x80000000      #parse only
