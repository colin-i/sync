+	setcall codepointer action_code_chain_header(codepointer,#fname)
+	ss ?inner=TRUE #the inner result is the object, so it must stay on the stack
+	setcall codepointer action_code_write_left_call(codepointer,#inner)
+	if marker=(call_chain_path) #a().x.d(): apply members after the inner call to its returned object
+		if codepointer#!=(args_end)
+			call error("chained call members expected")
+		end
+		add codepointer (DWORD)
+		set codepointer action_member_loop_right_onstack(codepointer)
+	end
+	call action_push((ap_Constant8),fname)
+	call action_one((ActionCallMethod))
+	call debug_xlog_call()
+	return codepointer
+endfunction
+#codepointer
+function action_code_chain_header(sv codepointer,sv pfname)
+	sv member
+	sv mathpointer;set mathpointer codepointer
+	setcall codepointer x_call(#member,pfname,codepointer)
+	if codepointer=mathpointer
+		set member debug_x_preexpand(#codepointer)
+		setcall codepointer action_caller(member,pfname,codepointer)
+	end
+	return codepointer
+endfunction
 
