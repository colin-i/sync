+function translate_optarg(ss start,ss oa) #oa here is not ""
+	sdu ?sz;set sz strlen(oa)
+	ss cursor;set cursor start
+	whiletrue
+		ss pointer
+		set pointer strstr(cursor,oa)
+		if pointer=(NULL)
+			break
+		end
+		if pointer=cursor
+			break
+		end
+		set cursor pointer;add cursor sz
+		dec pointer
+		if pointer#!=(Openparenthesis)
+			if pointer#!=(Comma)
+				continue
+			end
+		end
+		if cursor#!=(Closeparenthesis)
+			if cursor#!=(Comma)
+				continue
+			end
+		end
+		inc pointer
+		set sz pointer;sub sz start
+		sd ?len;set len snprintf(globalt.a_page_switch,(a_page_size),"%.*s?%s",sz,start,pointer)
+		if len>0
+			if len<(a_page_size)
+				call translated("OptArg")
+				return globalt.a_page_switch
+			end
+		end
+		break
+	end
+	return start
+end
