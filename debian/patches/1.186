--- actionswf-1.orig/oaas/md
+++ actionswf-1/oaas/md
@@ -1,5 +1,16 @@
 
 if [ -z "${compilerflags}" ]; then
-	compilerflags='-g -fsanitize=address,undefined'
+	if [ -n "${release}" ]; then
+		compilerflags='-O3 -march='
+		if [ -z "${arch}" ]; then
+			compilerflags="${compilerflags}"native
+		else
+			compilerflags="${compilerflags}${arch}"
+		fi
+	fi
+	compilerflags="${compilerflags} -g"
+	if [ -z "${no_sanitize}" ]; then
+		compilerflags="${compilerflags} -fsanitize=address,undefined"
+	fi
 fi
 compilerflags="${compilerflags}" linkerflags=' ' make -j4 $@
