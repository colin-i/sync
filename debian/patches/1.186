+	inc cursor;call memcpy(cursor,subject,sz)
+	inc sz;add cursor sz;set cursor# (Nullchar)
+	ss ?b;set b translate_self_subset(container,pointer,(Openparenthesis),(Comma),1,0,sz)
+	add b translate_self_subset(container,pointer,(Comma),(Comma),0,0,sz)
+	add b translate_self_subset(container,pointer,(Comma),(Closeparenthesis),0,0,sz)
+	add b translate_self_subset(container,pointer,(Openparenthesis),(Closeparenthesis),1,1,sz)
+	return b
+end
+function translate_self_subset(ss container,ss subject,ss ?left,ss ?right,ss ?at_left,ss ?at_right,ss pointer)
+	set subject# left
+	add subject pointer
+	set subject# right
+	sub subject pointer
+	ss cursor;set cursor strstr(container,subject)
+	if cursor!=(NULL)
+		add cursor at_left
+		add pointer cursor
+		sub pointer at_right
+		svu ?end=1;add end strlen(pointer)
+		add end cursor
+		while cursor!=end
+			set cursor# pointer#
+			inc cursor
+			inc pointer
+		end
+		return 1
+	end
+	return 0
+end
