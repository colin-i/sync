--- ocompiler-1.orig/otoc/Makefile
+++ ocompiler-1/otoc/Makefile
@@ -74,8 +74,8 @@ install:
 	$(MAKE) install-proj
 install-proj:
 	install -D ${prog} $(DESTDIR)$(prefix)/bin/${prog}
-	#if [ "${NOOCONV}" != "1" ]; then install -D ${prog} $(DESTDIR)$(prefix)/bin/${prog} && echo ${prog} is installed; else echo ${prog} is not installed; fi
-	#is at debian/ocompiler.install , will install here but not in the final deb
+#if [ "${NOOCONV}" != "1" ]; then install -D ${prog} $(DESTDIR)$(prefix)/bin/${prog} && echo ${prog} is installed; else echo ${prog} is not installed; fi
+#is at debian/ocompiler.install , will install here but not in the final deb
 
 clean:
 	-rm -f ${FULLOBJO}
--- ocompiler-1.orig/ounused/Makefile
+++ ocompiler-1/ounused/Makefile
@@ -30,7 +30,8 @@ ${vers}:
 ${FULLOBJO}: ${FULLOBJS} ${vers}
 	${launcher} ${OCOMP} $< exit_end 1 ${OFLAGSEXTRA}
 
-ATLDCOM = $(LD) ${linkerflags} -melf_i386 --dynamic-linker=/lib/ld-linux.so.2 -o $@ ${L} -l:libc.so.6 -entry main
+ATLDCOM = $(LD) ${linkerflags} -melf_i386 --dynamic-linker=/lib/ld-linux.so.2 --build-id -o $@ ${L} -l:libc.so.6 -entry main
+#build-id for rpm
 
 ${OB}: ${OBJ}
 	${ATLDCOM} ${FULLOBJO}
--- ocompiler-1.orig/readme.md
+++ ocompiler-1/readme.md
@@ -18,10 +18,13 @@ On Arch Linux, <i>.zst</i> file from [re
 yay -Sy ocompiler
 ```
 \
-On Fedora, <i>.rpm</i> file from [releases](https://github.com/colin-i/o/releases).
+On Fedora:
 ```sh
-dnf install ocompiler-*.*.rpm
+sudo dnf copr enable colin/project
+sudo dnf install ocompiler
 ```
+There is also <i>ocompiler-devel</i>.\
+\
 \
 On linux distributions, <i>.AppImage</i> file from [releases](https://github.com/colin-i/o/releases).\
