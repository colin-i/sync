--- ocompiler-1.orig/localtest
+++ ocompiler-1/localtest
@@ -1 +1 @@
-1-5+209
+1-5+210
--- ocompiler-1.orig/src/files/functions/xfile_details.oc
+++ ocompiler-1/src/files/functions/xfile_details.oc
@@ -424,30 +424,32 @@ endfunction
 #err
 function xfile_recursive()
 	if main.xfile!=(openno)
-		if main.innerfunctionreturn=(FALSE)
-			#can add at pass_init on top of all
-			sv ptrfunctions%%ptr_functions
-			sd fns
-			call getcont(ptrfunctions,#fns)
-			sd pos;set pos 0
-			whiletrue
-				sd ibit;setcall ibit importbit(fns)
-				if ibit=0
-					if pos=main.functionTagIndex
-						break
+		if main.innerfunction=(TRUE)
+			if main.innerfunctionreturn=(FALSE)
+				#can add at pass_init on top of all
+				sv ptrfunctions%%ptr_functions
+				sd fns
+				call getcont(ptrfunctions,#fns)
+				sd pos;set pos 0
+				whiletrue
+					sd ibit;setcall ibit importbit(fns)
+					if ibit=0
+						if pos=main.functionTagIndex
+							break
+						endif
+						inc pos
 					endif
-					inc pos
-				endif
+					add fns (nameoffset)
+					addcall fns strlen(fns)
+					inc fns
+				endwhile
+				sd size
 				add fns (nameoffset)
-				addcall fns strlen(fns)
-				inc fns
-			endwhile
-			sd size
-			add fns (nameoffset)
-			setcall size strlen(fns)
-			sd err;setcall err xfile_add_base((Xfile_proto),fns,size)
-			set main.innerfunctionreturn (TRUE)
-			return err
+				setcall size strlen(fns)
+				sd err;setcall err xfile_add_base((Xfile_proto),fns,size)
+				set main.innerfunctionreturn (TRUE)
+				return err
+			endif
 		endif
 	endif
 	return (noerror)
