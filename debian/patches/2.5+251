--- ocompiler-2.orig/cln
+++ ocompiler-2/cln
@@ -1,5 +1,5 @@
 
-make clean && git status
+make clean && ~/test/git/sts
 
 #plans:
 
--- ocompiler-2.orig/localtest
+++ ocompiler-2/localtest
@@ -1 +1 @@
-2-5+250
+2-5+251
--- ocompiler-2.orig/o.html
+++ ocompiler-2/o.html
@@ -985,6 +985,7 @@ Xfile_yesignore at compiler is '!' sign
 Xfile_variadic at ocompiler is '%' sign at start, followed by '&lt;argument' for va_start at otoc, '&variable' for va_copy, '|variable' for va_arg, '&gt;' for va_end. <i>va_copy</i> will also replace 'the_va_list' with <i>variable</i> until <i>va_end</i>.
 </p>
 <p>Another option specific to otoc is Xfile_c_volatile, to use stack variables at o for recursion but not pointers at c (example: sdu ?attr). And Xfile_c_variadic to work with va_list arguments.</p>
+<p><b>otoc</b> will print more options like for 'long long', va_list pointer strip, inline include extension, ignore tags.</p>
 <table id="selection_table">
 	<tr><td>Xfile_proto</td><td>Xfile_function_t_*</td><td class="red">name</td><td class="blue">nr_of_args</td><td class="green">{DA}</td><td>Xfile_proto_*</td></tr>
 </table>
--- ocompiler-2.orig/otoc/ascii.oh
+++ ocompiler-2/otoc/ascii.oh
@@ -25,6 +25,7 @@ const asciisquareright=0x5d      #]
 const asciicirc=0x5e             ;#^
 const asciic=0x63                #c
 const asciih=0x68                #h
+const asciii=0x69                #i
 const asciil=0x6c                #l
 const asciin=0x6e                #n
 const asciio=0x6f                #o
--- ocompiler-2.orig/otoc/loop.oc
+++ ocompiler-2/otoc/loop.oc
@@ -261,6 +261,21 @@ end
 function signed()
 end
 
+function is_oc(ss pointer,sd sz)
+	if sz>main.inl_ext_size
+		add pointer sz
+		sub pointer main.inl_ext_size
+		sd ?r;set r memcmp(pointer,main.inl_ext,main.inl_ext_size)
+		if r=0
+			dec pointer
+			if pointer#=(asciidot)
+				return (TRUE)
+			end
+		end
+	end
+	return (FALSE)
+end
+
 
 #aftercalli *
 
@@ -355,19 +370,29 @@ end
 function include(sd outfile,sv pbuffer)
 	charx type#1;call get_char(pbuffer,#type)
 
-	char s="#include "^
-	call write(outfile,#s,\.s)
-	call write_string_ex(pbuffer,outfile) #new line is useless: there are no escape chars in c include and, also: any member of the source character set except new-line and (quote or >)
-	call writenl(outfile)
+	charx multiline#1;datax sz#1;valuex pointer#1
+	call get_multistring(pbuffer,#multiline,#sz,#pointer)
 
 	charx alternative#1;call get_char(pbuffer,#alternative)
 	if alternative=(Xfile_include_alternative_yes)
-		charx multi#1;datax sz#1;valuex pointer#1
-		call get_multistring(pbuffer,#multi,#sz,#pointer)
+		charx multi#1;datax asz#1;valuex apointer#1
+		call get_multistring(pbuffer,#multi,#asz,#apointer)
 	end
 
-	inc loop.icount
-	or loop.allowwrite (allowwrite_no_include)
+	#.oc is code, not a header: keep its content in the .c and skip the #include tag
+	sd write_content=FALSE
+	if loop.icount=0
+		set write_content is_oc(pointer,sz)
+	end
+	if write_content=(FALSE)
+		char s="#include "^
+		call write(outfile,#s,\.s)
+		call write_string(outfile,multiline,sz,pointer) #new line is useless: there are no escape chars in c include and, also: any member of the source character set except new-line and (quote or >)
+		call writenl(outfile)
+
+		inc loop.icount
+		or loop.allowwrite (allowwrite_no_include)
+	end
 end
 function declare(sd outfile,sv pbuffer)
 	charx type#1;charx field#1;charx constif#1
--- ocompiler-2.orig/otoc/otoc.oc
+++ ocompiler-2/otoc/otoc.oc
@@ -52,6 +52,9 @@ char long_long="long "^
 char long_simple="long"^
 char point=asciiasterisk #this point is untouchable, is in a combination
 char long_long_reserve={asciispace,asciispace,asciispace,asciispace,asciispace}
+vstrx inl_ext#1
+datax inl_ext_size#1
+char inl_ext_default="oc"^ #goot at c on global
 
 importx "strlen" strlen
 
@@ -98,26 +101,46 @@ function options(sd _argc,sv _argv)
 	set main.long #main.long_simple
 	set main.long_size \main.long_simple
 	set main.long_cast_size \main.long_simple+\main.point
+	set main.inl_ext #main.inl_ext_default
+	set main.inl_ext_size \main.inl_ext_default
+
 	charx strip_va_list#1
 	set strip_va_list (FALSE)
+	ss ?has_ext
+	set has_ext (FALSE)
 	sv argv;set argv _argv#
 	ss s;set s argv#
 	if s#=(asciihyphen)
 		inc s
 		ss a;set a s
-		if s#=(asciil) #long long
-			call option_long_long()
-			inc s
-		end
-		if s#=(asciis) # *va_list*
-			set strip_va_list (TRUE)
+		whiletrue
+			if s#=(asciil) #long long
+				call option_long_long()
+			elseif s#=(asciis) # *va_list*
+				set strip_va_list (TRUE)
+			elseif s#=(asciii) # next argument is the extension of the inlined files
+				set has_ext (TRUE)
+			else
+				break
+			end
 			inc s
 		end
 		if s#=(asciinul)
 			if _argc#<3
 				return (EXIT_FAILURE)
 			end
-			if a=s
+			if has_ext=(TRUE)
+				if _argc#<4
+					return (EXIT_FAILURE)
+				end
+				incst argv   ##argv is still at the options argument, now at the extension
+				ss e;set e argv#
+				sd b;set b strlen(e)
+				set main.inl_ext e
+				set main.inl_ext_size b
+				dec _argc#
+				incst _argv#
+			elseif a=s
 				#here can return failure, but why not to remain backward compatible, - simple was long long
 				call option_long_long()
 			end
@@ -171,9 +194,10 @@ include "entry.oc" "entryraw.oc"
 			call exit(a)
 		end
 	end
-	call puts("Usage: otoc [-[OPTIONS]] filePath [tagIgnore1 .. tagIgnoreN]")
+	call puts("Usage: otoc [-[OPTIONS] [extension]] filePath [tagIgnore1 .. tagIgnoreN]")
 	call puts(#version)
 	call puts("OPTIONS(only - is like l):")
 	call puts("\tl\tlong long")
 	call puts("\ts\tstrip pointer at va_list")
+	call puts("\ti\tnext argument is the extension (without dot) of the files to inline, default oc")
 	call exit((EXIT_FAILURE))
--- ocompiler-2.orig/ounused/Makefile
+++ ocompiler-2/ounused/Makefile
@@ -48,9 +48,9 @@ link:
 	${exelauncher} ./${platform_ob} ${FULLOBJLOG}
 
 ${vers}:
-	cd .. && $(MAKE) -f ./Makefile ${ver}
+	$(MAKE) -C .. ${ver}
 
-${FULLOBJO}: ${FULLOBJS} ${vers}
+${OBJ}: ${FULLOBJS} ${vers}
 	${launcher} ${OCOMP} $< ${OFLAGS} ${OFLAGSEXTRA}
 
 install:
--- ocompiler-2.orig/readme.md
+++ ocompiler-2/readme.md
@@ -18,7 +18,7 @@ On Arch Linux(x86_64), <i>.zst</i> file
 yay -Sy ocompiler
 ```
 \
-On Fedora 42/43/44(x86_64):
+On Fedora 43/44/45(x86_64):
 ```sh
 sudo dnf copr enable colin/project
