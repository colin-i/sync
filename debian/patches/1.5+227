+#bit offset 7; pointer bit (sv# with rex, sd# without rex)
+const pointbit=0x80
+
+#bit offset 8; runtime sufix offset
+const suffixbit=0x100
+
+#bit offset 9: sign
+const signbit=0x200
+
+#bit offset 10: struct like bit
+const structbit=0x400
+
+#11,12,13,14,15
+#16-31: reserve units
+
+const dummy_mask=0
+const valueslongmask=datapointbit|pointbit
