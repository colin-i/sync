+function ignores_init(sv endval,sv argv)
+	sub endval 2
+	mult endval :
+	add endval argv
+	datax out#1
+	set out 0
+	while argv!=endval
+include "tags.oh"
+		ss s;set s argv#
+		sd b
+		set b strlen(s)
+		ss aa^a
+		datax outwas#1;set outwas out
+		sd orval=1
+		while aa#!=0
+			charx aaa#1;set aaa aa#
+			inc aa
+			if b=aaa
+				sd c;set c memcmp(s,aa,b)
+				if c=0
+					or out orval
+				end
+			end
+			add aa aaa
+			shl1 orval
+		end
+		if outwas=out
+			return 0
+		end
+		incst argv
+	end
+	return out
+end
