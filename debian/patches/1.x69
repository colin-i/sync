--- /dev/null
+++ edor-1/.github/workflows/deledor.yml
@@ -0,0 +1,20 @@
+
+on:
+ # Allows you to run this workflow manually from the Actions tab
+ workflow_dispatch:
+
+# A workflow run is made up of one or more jobs that can run sequentially or in parallel
+jobs:
+ # This workflow contains a single job called "build"
+ del:
+  # The type of runner that the job will run on
+  runs-on: ubuntu-18.04
+  # Steps represent a sequence of tasks that will be executed as part of the job
+  steps:
+   - name: Remove asset
+     uses: mknejp/delete-release-assets@v1
+     env:
+     with:
+      token: ${{ secrets.PAT }}
+      tag: refs/tags/${{ env.tag }}
+      assets: ${{ env.file }}
--- /dev/null
+++ edor-1/.github/workflows/pkg.yml
@@ -0,0 +1,50 @@
+
+on:
+ workflow_dispatch:
+env:
+ #for upload
+ GITHUB_TOKEN: ${{ secrets.PAT }}
+
+jobs:
+  archbuild:
+    runs-on: ubuntu-latest
+    container: archlinux:latest
+
+    steps:
+    - name: Checkout
+      uses: actions/checkout@v3
+    - name: build
+      run: |
+        name=`cat debian/changelog | head -1 | grep -o ^[^\ ]*`
+        here=`pwd`
+
+        useradd bot
+        cd /home
+        mkdir bot
+        chown bot:bot bot
+        cd bot
+
+        pacman -Sy --noconfirm --needed git base-devel wget
+        su bot -c 'git clone -n --depth=1 --filter=tree:0 https://github.com/colin-i/pkgbuilds'
+        #--filter in git-rev-list
+        cd pkgbuilds
+        su bot -c "git sparse-checkout set --no-cone /${name}"
+        su bot -c 'git checkout'
+        cd ${name}
+        pacman -S --noconfirm bc  #to not make bot with a password for -s --noconf
+        su bot -c makepkg
+        ls
+        nm=`ls | grep ".*\.zst$" | grep -v debug`
+        nm2=`echo ${nm} | sed s/-any/-arch-x86_64/`
+        mv ${nm} ${here}/${nm2}
+        echo "file=${nm2}" >> $GITHUB_ENV
+
+        wget https://github.com/colin-i/test/releases/download/1.5/${name} -O 1.txt
+        echo "up_url=`cat 1.txt`" >> $GITHUB_ENV
+    - name: Upload Release Asset
+      uses: actions/upload-release-asset@v1
+      with:
+        upload_url: ${{ env.up_url }}
+        asset_path: ./${{ env.file }}
+        asset_name: ${{ env.file }}
+        asset_content_type: application/zstd
--- /dev/null
+++ edor-1/.github/workflows/pkgarm.yml
@@ -0,0 +1,42 @@
+
+on:
+ workflow_dispatch:
+env:
+ #for upload
+ GITHUB_TOKEN: ${{ secrets.PAT }}
+
+jobs:
+  archarmbuild:
+    runs-on: ubuntu-24.04-arm
+    container: image0/archarm:latest
+
+    steps:
+    - name: Checkout
+      uses: actions/checkout@v3
+    - name: build
+      run: |
+        name=`cat debian/changelog | head -1 | grep -o ^[^\ ]*`
+        here=`pwd`
+        cd /home/alarm
+
+        su alarm -c 'git clone -n --depth=1 --filter=tree:0 https://github.com/colin-i/pkgbuilds'
+        cd pkgbuilds
+        su alarm -c "git sparse-checkout set --no-cone /${name}"
+        su alarm -c 'git checkout'
+        cd ${name}
+        su alarm -c makepkg
+        ls
+        nm=`ls | grep ".*\.xz$" | grep -v debug`
+        nm2=`echo ${nm} | sed s/-any/-arch-aarch64/`
+        mv ${nm} ${here}/${nm2}
+        echo "file=${nm2}" >> $GITHUB_ENV
+
+        wget https://github.com/colin-i/test/releases/download/1.5/${name} -O 1.txt
+        echo "up_url=`cat 1.txt`" >> $GITHUB_ENV
+    - name: Upload Release Asset
+      uses: actions/upload-release-asset@v1
+      with:
+        upload_url: ${{ env.up_url }}
+        asset_path: ./${{ env.file }}
+        asset_name: ${{ env.file }}
+        asset_content_type: application/x-xz
--- /dev/null
+++ edor-1/.github/workflows/uponpkg.yml
@@ -0,0 +1,34 @@
+
+on:
+ workflow_dispatch:
+
+env:
+ #for gh and upload
+ GITHUB_TOKEN: ${{ secrets.PAT }}
+
+jobs:
+ uopbuild:
+  runs-on: ubuntu-latest
+  steps:
+   - uses: actions/checkout@v3
+   - name: Run a multi-line script
+     run: |
+      name=`cat debian/changelog | head -1 | grep -o ^[^\ ]*`
+      wget https://github.com/colin-i/test/releases/download/1.5/${name} -O 1.txt
+      echo "up_url=`cat 1.txt`" >> $GITHUB_ENV
+      id=$(gh run list --workflow=pkg.yml -b $(git rev-parse --abbrev-ref HEAD) | cut -f7 | head -1)
+      repo_at_gh=`cat debian/control | grep "^Homepage" | grep -o [^/]*$`
+      url=`gh api -H "Accept: application/vnd.github.v3+json" /repos/colin-i/${repo_at_gh}/actions/runs/${id}/artifacts | jq ".artifacts[0].archive_download_url"`
+      url=${url:1:-1}
+      echo ${url}
+      curl -L -H "Authorization: token ${{ secrets.PAT }}" ${url} --output a.zip
+      file=`unzip -l a.zip | sed -n 4p | tr -s ' ' | cut -d ' ' -f5`
+      unzip ./a.zip
+      echo "file=${file}" >> $GITHUB_ENV
+   - name: Upload Release Asset
+     uses: actions/upload-release-asset@v1
+     with:
+      upload_url: ${{ env.up_url }}
+      asset_path: ./${{ env.file }}
+      asset_name: ${{ env.file }}
+      asset_content_type: application/zstd
