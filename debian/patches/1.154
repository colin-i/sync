--- actionswf-1.orig/oaalternative.py
+++ actionswf-1/oaalternative.py
@@ -5,7 +5,7 @@ default_tab=3
 import sys
 if len(sys.argv)!=2: exit(1)
 import os
-is_debug=os.environ.get("is_debug")
+verbose=os.environ.get("expect_obfuscation") or os.environ.get("is_debug")
 
 def ind_match(indt,b):
 	global n,ps
@@ -23,7 +23,7 @@ def ind_match(indt,b):
 			if a<indt: exit(1)
 		elif a>indt: exit(1)
 
-with open(sys.argv[1]) as f:
+with open(sys.argv[1], encoding='utf-8') as f:
 	data=f.read()  #\r\n is translated to \n also at windows msys2, else data=data.replace('\r','')
 	if data: # := only from 3.8
 		start=0
@@ -56,7 +56,7 @@ with open(sys.argv[1]) as f:
 
 			start+=len(goto)
 			addr='addr'+data[start:start+4]+':'
-			if is_debug:
+			if verbose:
 				print(addr)
 			start+=4
 			if data[start:start+3]!=');\n': exit(1)
@@ -148,7 +148,7 @@ with open(sys.argv[1]) as f:
 			data=text
 			start=a
 
-with open(sys.argv[1],"w") as f:
+with open(sys.argv[1],"w",encoding='utf-8') as f:
 	f.write(data)
 
 exit(0)
