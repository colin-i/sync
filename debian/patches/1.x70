--- edor-1.orig/.github/workflows/pkg.yml
+++ edor-1/.github/workflows/pkg.yml
@@ -24,14 +24,14 @@ jobs:
         chown bot:bot bot
         cd bot
 
-        pacman -Sy --noconfirm --needed git base-devel wget
+        pacman -Sy --noconfirm --needed git base-devel wget bc
         su bot -c 'git clone -n --depth=1 --filter=tree:0 https://github.com/colin-i/pkgbuilds'
         #--filter in git-rev-list
         cd pkgbuilds
         su bot -c "git sparse-checkout set --no-cone /${name}"
         su bot -c 'git checkout'
         cd ${name}
-        pacman -S --noconfirm bc  #to not make bot with a password for -s --noconf
+
         su bot -c makepkg
         ls
         nm=`ls | grep ".*\.zst$" | grep -v debug`
--- edor-1.orig/.github/workflows/pkgarm.yml
+++ edor-1/.github/workflows/pkgarm.yml
@@ -16,6 +16,14 @@ jobs:
     - name: build
       run: |
         name=`cat debian/changelog | head -1 | grep -o ^[^\ ]*`
+        repo_at_gh=`cat debian/control | grep "^Homepage" | grep -o [^/]*$`
+        version=`cat debian/changelog | head -1 | grep -Poe "[^\(]*(?=\))"`
+        text=`curl https://api.github.com/graphql -X POST -H "Authorization: bearer ${{ secrets.PAT }}" -d '
+        {
+         "query": "query { repository ( owner: \"colin-i\", name: \"'"${repo_at_gh}"'\" ) { release ( tagName: \"'"${version}"'\" ) { databaseId }} }"
+        }'`
+        id=`echo ${text} | grep -Poe "(?<=databaseId\":)[^}]*"`
+        up_url=https://uploads.github.com/repos/colin-i/edor/releases/${id}/assets{?name,label}
         here=`pwd`
         cd /home/alarm
 
@@ -29,10 +37,9 @@ jobs:
         nm=`ls | grep ".*\.xz$" | grep -v debug`
         nm2=`echo ${nm} | sed s/-any/-arch-aarch64/`
         mv ${nm} ${here}/${nm2}
-        echo "file=${nm2}" >> $GITHUB_ENV
 
-        wget https://github.com/colin-i/test/releases/download/1.5/${name} -O 1.txt
-        echo "up_url=`cat 1.txt`" >> $GITHUB_ENV
+        echo "file=${nm2}" >> $GITHUB_ENV
+        echo "up_url=${up_url}" >> $GITHUB_ENV
     - name: Upload Release Asset
       uses: actions/upload-release-asset@v1
       with:
--- edor-1.orig/clean
+++ /dev/null
@@ -1,2 +0,0 @@
-
-git clean -xdf -e .pc/ -e debian/patches/ && git diff && echo git diff
--- /dev/null
+++ edor-1/cln
@@ -0,0 +1,2 @@
+
+git clean -xdf -e .pc/ -e debian/patches/ && git diff && echo git diff
--- edor-1.orig/readme.md
+++ edor-1/readme.md
@@ -12,6 +12,11 @@ Install:
 sudo apt-get install edor
 ```
 \
+On Arch Linux, <i>.zst</i> or <i>.xz</i> file from [releases](https://github.com/colin-i/edor/releases), depending on architecture. Or:
+```sh
+yay -Sy edor
+```
+\
 On Fedora, <i>.rpm</i> file from [releases](https://github.com/colin-i/edor/releases).
 ```sh
 dnf install edor-*.*.rpm
