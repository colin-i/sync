--- ocompiler-2.orig/Makefile
+++ ocompiler-2/Makefile
@@ -5,7 +5,7 @@ TOPTARGETS := install-proj clean distcle
 
 #                                                             || arch/fedora/suse
 ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH 2>/dev/null || uname -m)
-ARCH := $(patsubst i586,i386,$(ARCH))
+ARCH := $(patsubst i686,i386,$(ARCH))
 
 ifeq ($(ARCH),i386)
 	conv_64=1
@@ -30,7 +30,16 @@ $(TOPTARGETS): $(SUBDIRS)
 install:
 	$(MAKE) all
 	$(MAKE) install-proj
-$(SUBDIRS):
+src:
+	conv_64=${conv_64} $(MAKE) -C $@ $(MAKECMDGOALS)
+
+ounused: src
+	conv_64=${conv_64} $(MAKE) -C $@ $(MAKECMDGOALS)
+
+ostrip: ounused
+	conv_64=${conv_64} $(MAKE) -C $@ $(MAKECMDGOALS)
+
+otoc: ounused
 	conv_64=${conv_64} $(MAKE) -C $@ $(MAKECMDGOALS)
 
 verify_comp_with_link:
@@ -48,4 +57,3 @@ clean:
 
 #phony only in this file not in subdirs, then can write extra for a PHONYTOPTARGETS
 .PHONY: all install $(TOPTARGETS) $(SUBDIRS) verify_comp_with_link
-.NOTPARALLEL:
--- ocompiler-2.orig/cln
+++ ocompiler-2/cln
@@ -1,2 +1,16 @@
 
 make clean && git status
+
+#plans:
+
+#vars/fns/consts and usage locations in dbg sec for odbg
+#and or
+#={"a","b"}
+#~(page_sectionalignment-1)
+#function in code at execs
+#SizeofStackReserve against growramp?
+#at write when there is at 0x80.... or at exes it is a fixed virtual
+#there is 0x66 prefix for words and some movsw/movzw
+
+#info:
+#ocompiler.conf is not overwritten if modifying it locally, "any files under the /etc directory as conffile, so if your program only has conffiles there you do not need to specify them in debian/{package}.conffiles"
--- ocompiler-2.orig/localtest
+++ ocompiler-2/localtest
@@ -1 +1 @@
-2-5+249
+2-5+250
