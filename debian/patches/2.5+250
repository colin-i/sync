+++ ocompiler-2/readme.md
@@ -1,11 +1,11 @@
 # O Compiler
 
 ## Install
-On Ubuntu(amd64 i386)[xenial(i386) bionic focal jammy noble] from PPA.
+On Ubuntu(amd64 i386)[xenial(i386) bionic focal jammy noble resolute] from PPA.
 ```sh
 sudo add-apt-repository ppa:colin-i/ppa
 ```
-Or the *Manual installation step* from this [link](https://gist.github.com/colin-i/e324e85e0438ed71219673fbcc661da6).\
+Or the *Manual installation step* from this [link](https://gist.github.com/colin-i/e324e85e0438ed71219673fbcc661da6#manual-installation-step).\
 Then:
 ```sh
 sudo apt-get install ocompiler
@@ -50,8 +50,8 @@ On Windows, <i>.windows.zip</i> file fro
 On linux distributions(x86_64), <i>.AppImage</i> file from [releases](https://github.com/colin-i/o/releases).
 
 ## Info
-Documentation is at [o.html](https://htmlpreview.github.io/?https://github.com/colin-i/o/blob/master/o.html).\
+Documentation(O syntax and X syntax) is at [o.html](https://htmlpreview.github.io/?https://github.com/colin-i/o/blob/master/o.html).\
 [Preferences file](https://raw.githubusercontent.com/colin-i/o/master/ocompiler.conf).
 
 ## Donations
-The *Donations* section is [here](https://gist.github.com/colin-i/e324e85e0438ed71219673fbcc661da6).
+The *Donations* section is [here](https://gist.github.com/colin-i/e324e85e0438ed71219673fbcc661da6#donations).
--- ocompiler-2.orig/src/files/functions/argument/arg.oc
+++ ocompiler-2/src/files/functions/argument/arg.oc
@@ -551,6 +551,13 @@ function getarg_colon(sd content,sd args
 			if pointer_size!=0
 				#runtime
 				or pointer2# (suffixbit)
+				if is_stack!=0 #here is the allday usage at runtime when pointing from mem and cannot move qword on dword
+					and location_part data2#
+					and location_part (datapointbit)
+					if location_part!=0
+						or pointer2# (datapointrememberbit)
+					end
+				end
 				add pointer2 (masksize) #note that here is not on nameoffset, is on data#3 value from temp
 				set pointer2# data#
 				sub pointer2# subtract_base
--- ocompiler-2.orig/src/files/functions/argument/comwrite.oc
+++ ocompiler-2/src/files/functions/argument/comwrite.oc
@@ -186,6 +186,14 @@ function writetake_offset(sd takeindex,s
 							set op (0x81)
 							set sz 6
 						endelse
+
+						sub entry (masksize)
+						sd tst=stackbit|datapointrememberbit
+						and tst entry#
+						if tst=(stackbit)
+							and entry# ~stackbit^stackrelativebit #more at set time
+						end
+
 						callret addtosec(#op,sz,ptrcodesec)
 					endif
 				endif
--- ocompiler-2.orig/src/files/functions/commons/vars.oc
+++ ocompiler-2/src/files/functions/commons/vars.oc
@@ -490,10 +490,10 @@ function tempdataadd(sv ptrdata)
 	sd err
 	sv original;set original ptrdata#
 	sv t%%ptr_tempdata
-	setcall err addtosec(original,(location_and_mask),t)
+	setcall err addtosec(original,(location_and_mask+location),t) #+location for colon mix and runtime suffix, needing 2 offsets there
 	if err=(noerror)
 		call getcontplusReg(t,ptrdata)
-		sub ptrdata# (location_and_mask)
+		sub ptrdata# (location_and_mask+location)               #same
 		call memtomem(ptrdata#,original,(location_and_mask))
 	endif
 	return err
--- ocompiler-2.orig/src/files/headers/header.oh
+++ ocompiler-2/src/files/headers/header.oh
@@ -18,6 +18,8 @@ Const datapointbit=0x08
 
 #bit offset 4: 1 means is nobits
 const expandbit=0x10
+	#if stackbit & suffixbit
+const datapointrememberbit=0x10
 
 #bit offset 5: 1 means apply aftercall
 const aftercallthrowbit=0x20
@@ -47,7 +49,7 @@ const dummy_mask=0
 const valueslongmask=datapointbit|pointbit
 const stringslongmask=datapointbit|bigstringbit
 const location_bits=stackbit|expandbit
-const stack_location_bits=location_bits|stackrelativebit    #and expandbit? will be always 0 at stack, keep it clean from what we combine
+const stack_location_bits=location_bits|stackrelativebit    #expandbit since datapointrememberbit. was: will be always 0 at stack, keep it clean from what we combine
 
 const location=dwsz
 Const maskoffset=location
--- ocompiler-2.orig/src/md
+++ ocompiler-2/src/md
@@ -1,5 +1,5 @@
 
-OFLAGS+=" function_name 1 nul_res_pref 1" make linkerflags= $@
+OFLAGS+=" function_name 1 nul_res_pref 1" make linkerflags="${linkerflags}" $@
 
 #last working glibc linker: 2.36
 #linker=/home/bc/arh/libc6-i386/lib32/ld-linux.so.2 make test
