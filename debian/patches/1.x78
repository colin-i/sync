+			store_aftercall=aftercall;
+			if(aftercall<rows_tot){
+				aftercall=aftercall_aux; // if warning, is ok, ocompiler_flag dependent
+			}else aftercall=n;
 		}
+		store_rows=rows;rows=rowswrap;
+		store_rows_tot=rows_tot;rows_tot=j;
 
 		//window
 		ytext=y;xtext=0;
--- /dev/null
+++ edor-1/win
@@ -0,0 +1,9 @@
+set -e
+curl -s https://api.github.com/repos/colin-i/edor/releases/latest > 1
+n=`cat 1 | jq '.assets[] | .name' | grep -n msys | cut -d: -f1`
+n=$((n-1))
+x=`cat 1 | jq ".assets[${n}].browser_download_url"`
+x=${x:1:-1}
+wget $x
+pacman -U $x
+rm 1 $x
