--- actionswf-1.orig/oaalternative.sh
+++ actionswf-1/oaalternative.sh
@@ -41,20 +41,18 @@ if [ -z "${skip_ffdec}" ]; then
 		"${ffdec}" -export script "${folder}" "${bname}" || exit 1
 	fi
 fi
-mover () {
-	if [ -z "${no_clean}" ]; then
-		mv ${v} "${@}" || exit 1
-	else
-		cp ${v} "${@}" || exit 1
-	fi
-}
 if [ -z "${skip_alternative}" ]; then
 	mkdir -p "${out}"
 
 	cd "${folder}"
 
 	move () {
-		mover "${1}" $2
+		if [ -z "${no_clean}" ]; then
+			mv ${v} "${1}" $2 || exit 1
+		else
+			cp ${v} "${1}" $2 || exit 1
+		fi
+
 		if [ -n "${is_debug}" ]; then
 			cat ${2}
 		fi
--- actionswf-1.orig/src/actioncode.oc
+++ actionswf-1/src/actioncode.oc
@@ -372,10 +372,11 @@ function action__code_row_ex(sd codepoin
 		set action__code_row.rcb (ret_cont_break_something)
 		return codepointer
 	endif
+	ss p
 	if attrib=(if_marker) #block_end
 		add codepointer (DWORD)
 		if codepointer#=(else_marker)
-			ss p;set p ret_cont_break()
+			set p ret_cont_break()
 			if p#=(ret_cont_break_nothing)
 				call action_code_else_add()
 			else #dead jump after return/continue/break
@@ -418,9 +419,12 @@ function action__code_row_ex(sd codepoin
 		return codepointer
 	endif
 	if attrib=(break_flag)
-		call action_code_break()
-		add codepointer (DWORD)
+		set p ret_cont_break()
+		if p#=(ret_cont_break_nothing) #why? for(var mc_name in drivers_container)return null is ok here but at ffdec an extra break is after return
+			call action_code_break()
+		end
 		set action__code_row.rcb (ret_cont_break_break)
+		add codepointer (DWORD)
 		return codepointer
 	endif
 	if attrib=(continue_flag)
--- actionswf-1.orig/src/actionparse.oc
+++ actionswf-1/src/actionparse.oc
@@ -116,6 +116,7 @@ import "memtrailstrict" memtrailstrict
 import "compat" compat
 import "debug_phase_code_remove" debug_phase_code_remove
 import "mem_cmp_bool" mem_cmp_bool
+import "escape_action_endcom" escape_action_endcom
 
 #aftercallimport ebool
 
@@ -139,6 +140,19 @@ function action_code_row(ss ac,sd a_bloc
 endfunction
 #pointer
 function action_code_row_ex(ss ac,sd a_block_detected,sd else_index)
+	ss p;set p action_code_row_ex_wrap(ac,a_block_detected,else_index)
+	if p#=(Slash)
+		inc p
+		if p#=(Slash)
+			set p escape_action_endcom(p) #cannot inc p because //\n ending lines will not be recognized
+			return p
+		end
+		call error("not a right line end comment")
+	end
+	return p
+end
+#pointer
+function action_code_row_ex_wrap(ss ac,sd a_block_detected,sd else_index)
     sv p_c
     setcall p_c debug_code()
     set p_c# ac
--- actionswf-1.orig/src/actionutil.oc
+++ actionswf-1/src/actionutil.oc
@@ -24,8 +24,24 @@ function row_termination(sv p_ac,sv p_ro
 	endif
 	return 1
 endfunction
+function row_termination_endcom(ss ac)
+	if ac#=(text_nl)
+		inc ac
+	elseif ac#=(text_cr)
+		inc ac
+		if ac#=(text_nl);inc ac;end
+	end
+	return ac
+end
+
+function endcom(ss c,ss p)
+	vstrx ac#1
+	vstrx pointer#1
+	set ac c;set pointer p
+end
+
 #error_row
-function escape_action(ss ac,ss pointer,ss stop_pointer)
+function escape_action(ss ac,ss pointer,ss stop_pointer,ss line_term)
     sd row=1
     #sd loop1=1
     sd error_row=0
@@ -67,12 +83,29 @@ function escape_action(ss ac,ss pointer,
 				return pointer
 			endif
 			if comments=0
-			    if pointer=stop_pointer
-			        set error_row row
-			    else
-			        set pointer# ac#
-			    endelse
-			    inc pointer
+				if pointer=stop_pointer
+					set error_row row
+				elseif line_term!=(NULL)
+					if line_term=pointer
+						whiletrue
+							inc ac;inc pointer
+							ss c;set c row_termination_endcom(ac)
+							if c=ac
+								if ac#=0
+									break
+								end
+							else
+								set endcom.ac ac
+								set endcom.pointer pointer
+								break
+							end
+						end
+						return pointer
+					end
+				else
+					set pointer# ac#
+				endelse
+				inc pointer
 			elseif comments=(multiLine_comment)
 			    if ac#=lines_com_c1
 			        set test ac;inc test;if test#=lines_com_c2;set comments 0;inc ac;endif
@@ -89,6 +122,10 @@ function escape_action(ss ac,ss pointer,
 	endif
     endwhile
 end
+#ac
+function escape_action_endcom(ss pointer)
+	callret escape_action(endcom.ac,endcom.pointer,(NULL),pointer)
+end
 #nr
 function escape_count(ss string,sd escape)
     sd nr=0
@@ -158,7 +195,7 @@ function action_error()
     sv p_c
     setcall p_c debug_code()
     sd row
-    setcall row escape_action(ac,mem,p_c#)
+    setcall row escape_action(ac,mem,p_c#,(NULL))
     import "string_nl_print" string_nl_print
     #a small reserve for a number like 2 000 000 000
     char row_nr#dword_to_string_char
--- actionswf-1.orig/src/faction.oc
+++ actionswf-1/src/faction.oc
@@ -9,7 +9,7 @@ import "action_code_values_action" actio
 import "escape_action" escape_action
 import "action_debug_free" action_debug_free
 import "debug_phase_parse_end" debug_phase_parse_end
-
+import "endcom" endcom
 
 #aftercallimport ebool
 
@@ -39,7 +39,7 @@ function action_base(ss ac)
 
 		import "debug_action_init" debug_action_init
 		call debug_action_init(ac)
-		sd last;set last escape_action(ac,mem,0)
+		sd last;set last escape_action(ac,mem,(NULL),(NULL))
 		import "debug_x_pointers" debug_x_pointers
 		call debug_x_pointers(mem,last)
 		import "debug_action_phase" debug_action_phase
@@ -49,6 +49,7 @@ function action_base(ss ac)
 		setcall p_action_errors action_debug((action_debug_get))
 		set p_action_errors# ac  ##this also requires debug_code to be set, and is set at first action_code_row_ex / at every row, that is from here without any aftercall
 		sv cursor;set cursor p_action_errors;incst cursor;set cursor# mem
+		call endcom(ac,mem) #also for line end term to follow
 		while mem#!=0
 			setcall mem action_code_row(mem,(FALSE))
 		endwhile
--- actionswf-1.orig/tests/ffdec/a.oc
+++ actionswf-1/tests/ffdec/a.oc
@@ -45,7 +45,7 @@ function cc(a){
 }
 function ccc(a,b){
 }
-var a;
+var a;//line ending comment
 delete a;
 delete a.b;
 var a=2;
@@ -100,6 +100,9 @@ for(a in b){
 	if(a==2)break;
 	c=1+c;
 }
+for(a in b){
+	return null;
+}
 ")
 #call actiond("for(a in b){c=1+c;}") will be ""b"" and here straight "b"
 call action("return 1")
