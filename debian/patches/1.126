 	return seekint
 endfunction
 #offset
@@ -135,20 +135,20 @@ function file_get_content(ss filepath,sv
 		dec size
 	end
 	call file_get_content__resources((TRUE),(fd_none),mem)
-	call file_read(file,mem,size)
+	call read(file,mem,size)
 	if p_size=(NULL)
 		add size mem
 		set size# (Nullchar)
