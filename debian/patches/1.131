+ainits_ar_key=
+ainits_ar_val=
+ainits_ar_set () {
+	ainits_ar_key="${ainits_ar_key} $1"
+	ainits_ar_val="${ainits_ar_val} $2"
+}
+ainits_ar_get () {
+	i=0
+	for a in ${ainits_ar_key}; do
+		if [ $a = $s ]; then
+			break
+		fi
+		i=$((i+1))
+	done
+	j=0
+	for a in ${ainits_ar_val}; do
+		if [ $j = $i ]; then
+			return $a
+		fi
+		j=$((j+1))
+	done
+}
