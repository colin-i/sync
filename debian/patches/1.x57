   * same(fix upload-artifact)
Author: bc <bc@bc-desktop>

---
The information above should follow the Patch Tagging Guidelines, please
checkout https://dep.debian.net/deps/dep3/ to learn about the format. Here
are templates for supplementary fields that you might want to add:

Origin: (upstream|backport|vendor|other), (<patch-url>|commit:<commit-id>)
Bug: <upstream-bugtracker-url>
Bug-Debian: https://bugs.debian.org/<bugnumber>
Bug-Ubuntu: https://launchpad.net/bugs/<bugnumber>
Forwarded: (no|not-needed|<patch-forwarded-url>)
Applied-Upstream: <version>, (<commit-url>|commit:<commid-id>)
Reviewed-By: <name and email of someone who approved/reviewed the patch>
Last-Update: 2025-03-14

--- edor-1.orig/.github/workflows/appimage.yml
+++ edor-1/.github/workflows/appimage.yml
@@ -113,7 +113,7 @@ jobs:
       glibc=${glibc//./-}
       echo -n ${glibc} > version #"glibc" will not be ok for upload-artifact
    - name: artifact
-     uses: actions/upload-artifact@v3
+     uses: actions/upload-artifact@v4
      with:
       name: appimage
       path: |
--- edor-1.orig/.github/workflows/deb.yml
+++ edor-1/.github/workflows/deb.yml
@@ -31,7 +31,7 @@ jobs:
       cd in
       debuild -S -us -uc
    - name: unsigned debs
-     uses: actions/upload-artifact@v3
+     uses: actions/upload-artifact@v4
      with:
       name: sdebs
       path: |
--- edor-1.orig/.github/workflows/rpm.yml
+++ edor-1/.github/workflows/rpm.yml
@@ -34,7 +34,7 @@ jobs:
       #${fname2} #alien says x86_64 but we coded elsewhere with amd64
       echo "file=${fname}" >> $GITHUB_ENV
    - name: artifact
-     uses: actions/upload-artifact@v3
+     uses: actions/upload-artifact@v4
      with:
       name: rpm
       path: ./${{ env.file }}
