+			$(LD) ${linkerflags} -melf_i386 --dynamic-linker=/lib/ld-linux.so.2 ${name}.o -entry main -o ${name} -lc `pkg-config --libs zlib` -L${_L} -l:${libname}; \
 		elif [ -z "${ldprefer}" ]; then \
