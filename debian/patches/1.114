-    #
-    set mem# size
-    sd byte=0x0000ff00;and byte size;div byte 0x100
-    inc mem;set mem# byte
+	set mem# size
+	sd byte=0x0000ff00;and byte size;div byte 0x100
+	inc mem;set mem# byte
 endfunction
 
