--- actionswf-1.orig/oad/branch.oc
+++ actionswf-1/oad/branch.oc
@@ -4,10 +4,38 @@ format elfobj64
 override include_sec 1
 include "common.h" "common.h.oh"
 
+importx "malloc" malloc
+#branch pointer
+function branch_init(valueu pf)
+	valueu bra#1
+	set bra malloc((\branch\))
+	if bra!=(NULL)
+		valueu inners#1
+		set inners malloc((sprites_realloc_onepart))
+		if inners!=(NULL)
+			sv cuts;set cuts malloc(1) #symbolic, null malloc can be null return
+			if cuts!=(NULL)
+				set bra#:branch.cuts cuts
+				set bra#:branch.size 0
+
+				set bra#:branch.innerbranches inners
+				set bra#:branch.isize 0
+				set bra#:branch.subbranch (NULL)
+
+				set pf#:preframe.branchpointer bra
+				return bra
+			end
+			call free(inners)
+		end
+		call free(bra)
+	end
+	return (NULL)
+end
+
 importx "realloc" realloc
 function branch_done(sv pf,dataxu size,dataxu offset,valueu code)
 	sub size offset
-	sv br;set br pf#:preframe.abranch
+	sv br;set br pf#:preframe.branchpointer
 
 	valueu sz#1;set sz br#:branch.size
 	add sz \branchcut\
@@ -109,7 +137,14 @@ function branch_log(sv br,valueu start)
 end
 
 importx "free" free
-function branch_free(sv br)
+function branch_free(valueu br,valueu logstart)
+	if logstart!=(NULL)
+		call branch_log(br,logstart)
+	end
 	call free(br#:branch.cuts)
+	call free(br#:branch.innerbranches)
+	if br#:branch.subbranch!=(NULL)
+		call branch_free(br#:branch.subbranch,logstart)
+	end
 	call free(br)
 end
--- actionswf-1.orig/oad/common.h.oh
+++ actionswf-1/oad/common.h.oh
@@ -44,16 +44,19 @@ function preframe()
 	value recalculation#1 #can be in ui32, multiple actions with a big pool, or multiple actions constant16 to constant8 reductions. good at log
 
 	valueu abranch#1
+
 	valueu branchpointer#1  #starting from abranch and descending
 end
 function branch()
 	valueu cuts#1
 	valueu size#1  #here a return undefined DoAction has 8 and a branchcut has 12(16 if aligned), there are no 3 size(tag+end) DoAction from actionswf lib
 
-#	dataxu *offset#1
-#	valuexu *action#1   #for mark, after compare
+	valuexu innerbranches#1 #for define functions and for 3rd part
+	dataxu isize#1  #same as oadata functions plus for 3rd that is bigger, a jump,push,define at least
 
-#	valuexu *subbranch#1
+	valueu subbranch#1
+
+#	valuexu *action#1   #for mark, after compare
 end
 function branchcut()
 	vdataxu x#1   #ints everywhere and pointers for strings, will not memcpy
