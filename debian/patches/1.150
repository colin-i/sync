-#bool
-function part_of_variable(sd value)
-    sd bool
-    setcall bool is_numeric(value)
-    if bool=(TRUE)
-        return (TRUE)
-    endif
+#0 1/2
+function part_of_variable(ss value)
+	sd bool
+	setcall bool is_numeric(value#)
+	if bool=(TRUE)
+		return 1
+	endif
 	callret is_letter(value)
 endfunction
-#bool
-function is_letter(sd value)
+#0 1/2
+function is_letter(ss str)
+	sd value;set value str#
 	if value<(A)
-        return (FALSE)
+		return 0
 	endif
 	if value<=(Z)
-        return (TRUE)
+		return 1
 	endif
 	if value=(_)
-        return (TRUE)
+		return 1
 	endif
 	if value<(a)
-        return (FALSE)
+		return 0
 	endif
 	if value<=(z)
-        return (TRUE)
+		return 1
 	endif
-    return (FALSE)
+	if value>=(control2_start) #https://www.fileformat.info/info/unicode/utf8.htm  more at ascii.oh
+		if value<=(control2_end)
+			inc str
+			set value str#
+			if value>=(continuing_start)
+				if value<=(continuing_end)
+					return 2
+				end
+			end
+		end
+	end
+	return 0
 endfunction
 
