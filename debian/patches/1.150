@@ -187,10 +187,87 @@ function infinite_loop_check(sd codepoin
 	return test
 end
 function action_true_compare(ss command)
-	sd compare
+	datax compare#1
 	set compare strcmp("true",command) #int
 	return compare
 end
+import "is_x" is_x
+function forinbreak_check(sd codepointer)
+	sd start;set start codepointer
+	if codepointer#=(call_action_right)
+		add codepointer (DWORD)
+		sd name
+		sd x;set x is_x()
+		if x=(FALSE)
+			if codepointer#v!=(NULL)
+				return start
+			end
+			sv rules;set rules codepointer
+			incst codepointer
+			sv pname;set pname codepointer
+			set name codepointer#v
+			incst codepointer
+			if codepointer#!=(args_end)
+				return start
+			end
+			add codepointer (DWORD)
+		else
+			set name action_code_get_pointer_touchless(#codepointer)
+			if codepointer#!=(args_end)
+				return start
+			end
+			add codepointer (DWORD)
+			if codepointer#v!=(NULL)
+				return start
+			end
+			incst codepointer
+		end
+		datax compare#1
+		set compare strcmp("§§pop",name) #is memcmp unsafe? comparing from last to first?
+		if compare=0
+			if codepointer#=(compare_action)
+				add codepointer (DWORD)
+				if codepointer#=(ActionEquals2)
+					add codepointer (DWORD)
+					if codepointer#=(ActionNot)
+						add codepointer (DWORD)
+						if codepointer#=(ActionGetVariable)
+							add codepointer (DWORD)
+							sv nl;set nl codepointer
+							set name action_code_get_pointer_touchless(#codepointer)
+							set compare action_null_compare(name)
+							if compare=0
+								if codepointer#=(math_end)
+									add codepointer (DWORD)
+									if codepointer#=(whileblock_end)
+										add codepointer (DWORD)
+										if x=(FALSE) #is this hacky?
+											call x_pointer(nl)
+											if nl#!=name ##fast way to see if is prex
+												call x_pointer(pname)
+												set rules# pname#
+												set pname# (args_end)
+												add pname (DWORD)
+												set pname# (NULL)
+											end
+										end
+										return codepointer
+									end
+								end
+							end
+						end
+					end
+				end
+			end
+		end
+	end
+	return start
+end
+function action_null_compare(ss command)
+	datax compare#1
+	set compare strcmp("null",command) #int
+	return compare
+end
 
