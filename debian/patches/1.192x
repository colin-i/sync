+			end
+		end
+	elseif action=(value_set) #in main safe
+		set view arg
+		importx "_malloc" malloc
+		set mem malloc(1) #no zero
+		set size 0
+	else #in main safe
+		if mem!=(NULL)
+			if action=(value_get)
+				importx "_gtk_text_view_get_buffer" gtk_text_view_get_buffer
