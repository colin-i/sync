@@ -40,11 +40,27 @@ function rec_stream_error(data *bus,data
 endfunction
 
 function save_inform_saved(ss location)
-    str sv="File saved as: "
-    data ss=stringstring
-    import "strvaluedisp" strvaluedisp
-    call strvaluedisp(sv,location,ss)
+	vstr sv="File saved as: "
+	data ss=stringstring
+	import "strvaluedisp" strvaluedisp
+	call strvaluedisp(sv,location,ss)
 endfunction
+function save_inform_saved_th_fn(ss location)
+	call strvaluedisp(save_inform_saved.sv,location,save_inform_saved.ss)
+	return (FALSE)
+end
+function save_inform_saved_thf_fn(ss location)
+	call strvaluedisp(save_inform_saved.sv,location,save_inform_saved.ss)
+	call free(location)
+	return (FALSE)
+end
+importx "_g_idle_add" g_idle_add
+function save_inform_saved_th(ss location)
+	call g_idle_add(save_inform_saved_th_fn,location)
+end
+function save_inform_saved_thf(ss location)
+	call g_idle_add(save_inform_saved_thf_fn,location)
+end
 
 function rec_endofstream(data *bus,data *message,str passdata)
     call save_inform_saved(passdata)
--- /dev/null
+++ ovideo-1/src/_exec/debug.oc
@@ -0,0 +1,59 @@
+
+format elfobj
+
+include "../_include/include.oh"
+
+importx "_getenv" getenv
+importx "_fopen" fopen
+importx "_fclose" fclose
+importx "_fwrite" fwrite
+importx "_strchr" strchr
+
+import "texter" texter
+
+function debug_init()
+	sd v;set v getenv("OVIDEO_DEBUG_FILES")
+	if v!=(NULL)
+		value f=NULL
+		value fi#1
+		import "getwritemode" getwritemode
+		ss pos;set pos strchr(v,(MULTIPATH_SEPARATOR))
+		if pos!=(NULL)
+			set pos# (Nullchar)
+			sd w;set w getwritemode()
+			inc pos
+			set fi fopen(pos,w)
+			if fi!=(NULL)
+				set f fopen(v,w)
+				if f!=(NULL)
+					call texter("debug file opened")
+				else
+					call fclose(fi)
+				end
+			end
+		end
+	end
+end
+function debug_free()
+	if debug_init.f!=(NULL)
+		call fclose(debug_init.f)
+		#set debug_init.f (NULL)
+		call fclose(debug_init.fi)
+	end
+end
+function debug(ss data,sd size)
+	if debug_init.f!=(NULL)
+		sd a;set a fwrite(#size,4,1,debug_init.fi)
+		if a=1
+			set a fwrite(data,size,1,debug_init.f)
+			if a=1
+				importx "_fflush" fflush
+				call fflush(debug_init.fi)
+				call fflush(debug_init.f)
+				#also a kernel sync(2) to phisical write to the disk
+				ret
+			end
+		end
+		call texter("weird error")
+	end
+end
