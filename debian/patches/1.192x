-
+importx "_fread" fread
+importx "_fwrite" fwrite
+importx "_strlen" strlen
+import "getwritemode" getwritemode
+import "getreadmode" getreadmode
+import "save_inform_saved_thf" save_inform_saved_thf
+function mp3_file(sd bool,sv extra_off1,sv mp3_off)
+#location is saved with const
+#reopen, the mode is getwritemode for mp4 file. call before mp4 is closed to not release resources to not recheck too many calls
+	charx nothing#1
+	vstrx src#1
+	const extr_0^src
+	ss dest;set dest src
+	sd src_sz;set src_sz strlen(src)
+	add dest src_sz
+	dec dest
+	if bool=(FALSE)
+		if extra_off1=mp3_off
+			set nothing 1
+			ret
+		end
+		set nothing 0
+
+		sd err
+		sd file
+		ss r;set r getreadmode()
+		set err openfile(#file,src,r) #after this the resources are claimed at least to what the opened file reached
+		#linux, for example, can rename the resources to .nfs000000000068516d00000006 if the file information header is deleted
+		if err=(noerror)
+			charx aux#1;set aux dest#
+			set dest# 0x33   #mp4->mp3 , hacky way
+
+			sub mp3_off extra_off1
+			sd mp3Mem;setcall mp3Mem memalloc(mp3_off)
+			if mp3Mem!=(NULL)
+				sd mp3__file
+				ss w;set w getwritemode()
+				set err openfile(#mp3__file,src,w)
+				if err=(noerror)
+					call file_seek_set(file,extra_off1) #this was ok
+					sdu rd;set rd fread(mp3Mem,mp3_off,1,file)
+					if rd=1 #if the resources are ok at main open it doesn't mean async is not changeable for second open
+						Call fwrite(mp3Mem,mp3_off,1,mp3__file)
+						call fclose(mp3__file)
+					end
+				end
+				call free(mp3Mem)
+			end
+			call fclose(file)
+
+			set dest# aux
+		end
+	else
+		if nothing=0
+			sd allocsz;set allocsz src_sz
+			mult allocsz 2 #this is captures/epoch.ext here
+			add allocsz 5+1
+			sd mem;set mem memalloc(allocsz)
+			if mem!=(NULL)
+				importx "_memcpy" memcpy
+				call memcpy(mem,src,src_sz)
+				ss cursor;set cursor mem
+				add cursor src_sz
+				char and=" and "^
+				call memcpy(cursor,#and,5)
+				add cursor 5
+				set dest# 0x33   #mp4->mp3 , hacky way
+				call memcpy(cursor,src,src_sz)
+				add cursor src_sz
+				set cursor# (Nullchar)
+				call save_inform_saved_thf(mem)
+			end
+		else
+			call save_inform_saved_th(src)
+		end
+	end
+end
+function mp3_file_bool()
+	char b=FALSE
+	return b
+end
+function mp3_file_bool_set(sd value)
+	set mp3_file_bool.b value
+end
 
