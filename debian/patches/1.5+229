--- ocompiler-1.orig/otoc/action.oc
+++ ocompiler-1/otoc/action.oc
@@ -24,12 +24,10 @@ end
 
 function return(sd outfile)
 	if loop.function_start!=(err)
-		if loop.allowwrite=(allowwrite_yes) #can be no_include
-			call fseek(outfile,loop.function_start,(SEEK_SET))
-			call fwrite(#write_long_pointer.a,(write_long_cast),1,outfile)
-			call fseek(outfile,0,(SEEK_END))
-			set loop.function_start (err) #if is not at endfunction, is here. multipe returns,write once
-		end
+		call fseek(outfile,loop.function_start,(SEEK_SET))
+		call fwrite(#write_long_pointer.a,(write_long_cast),1,outfile)
+		call fseek(outfile,0,(SEEK_END))
+		set loop.function_start (err) #if is not at endfunction, is here. multipe returns,write once
 	end
 	char a="return "^  #also used at ret
 	callg write(outfile,#a,\.a)
--- ocompiler-1.orig/otoc/decl.oc
+++ ocompiler-1/otoc/decl.oc
@@ -26,14 +26,16 @@ function functiondef_d(sv pbuffer,sd out
 	return args ##for varargs
 end
 function functiondef_r(sv pbuffer,sd outfile,sd pointer,sd sz)
-	set loop.function_start ftell(outfile)
-	if loop.function_start!=(err)
-		call write_void(outfile,pointer,sz)
-		call writel(outfile)
-		sd args;set args functiondef_d(pbuffer,outfile)
-		return args ##for varargs
+	sd b;set b write_allow();if b=(TRUE) #returns ca be also in include files at o, don't want to test that on c?
+		set loop.function_start ftell(outfile)
+		if loop.function_start=(err)
+			call aftercallenable()
+		end
 	end
-	call aftercallenable()
+	call write_void(outfile,pointer,sz)
+	call writel(outfile)
+	sd args;set args functiondef_d(pbuffer,outfile)
+	return args ##for varargs
 end
 function functiondef_ext(sv pbuffer,sd outfile,sd pointer,sd sz,sd vargs)
 	sd args;set args functiondef_r(pbuffer,outfile,pointer,sz)
--- ocompiler-1.orig/otoc/loop.oc
+++ ocompiler-1/otoc/loop.oc
@@ -400,7 +400,9 @@ function declare(sd outfile,sv pbuffer)
 			charx multi#1;call get_multistring(pbuffer,#multi,#sz,#pointer)
 			charx trim#1;call get_char(pbuffer,#trim)
 			if trim=(Xfile_declmode_string_pop_yes)
-				call write_popstring(pointer,sz,outfile)
+				sd b;set b write_allow();if b=(TRUE)
+					call write_popstring(pointer,sz,outfile)
+				end
 				if type!=(Xfile_decltype_byte) #why check here and not above? to let popstring to be normal and check for 0 size and write to file (is more easy at debug)
 					call unimplemented() # char*={'a','b','c',0} is not "abc" ,downgrade to char? the sizeof and pointers then
 				end
@@ -626,18 +628,24 @@ function else_core(sd outfile)
 	callg write(outfile,#a,\.a)
 end
 
-function write(sd outfile,ss buf,sd sz)
+function write_allow()
 	if loop.ignored=(ignored_no)
 		if loop.allowwrite=(allowwrite_yes)
-			sd items
-			if loop.directwrite=(TRUE)
-				set items fwrite(buf,sz,1,outfile)
-			else
-				set items mwrite(buf,sz,outfile)
-			end
-			if items!=1
-				call aftercallenable()
-			end
+			return (TRUE)
+		end
+	end
+	return (FALSE)
+end
+function write(sd outfile,ss buf,sd sz)
+	sd b;set b write_allow();if b=(TRUE)
+		sd items
+		if loop.directwrite=(TRUE)
+			set items fwrite(buf,sz,1,outfile)
+		else
+			set items mwrite(buf,sz,outfile)
+		end
+		if items!=1
+			call aftercallenable()
 		end
 	end
 end
@@ -756,8 +764,8 @@ function writetn(sd outfile) #terminator
 	callg writenl(outfile)
 end
 
-function fprintu(sd outfile,sd c)
-	sd items;set items fprintf(outfile,"%u",c) #this does't encounter allowwrite or directwrite at this moment
+function fprintu(sd outfile,sd c)  #has an upper write_allow check
+	sd items;set items fprintf(outfile,"%u",c) #safe from directwrite at this moment
 	if items<0
 		call aftercallenable()
 	end
--- ocompiler-1.orig/otoc/var.oc
+++ ocompiler-1/otoc/var.oc
@@ -207,7 +207,7 @@ function write_string_ex(sv pbuffer,sd o
 	call get_multistring(pbuffer,#multiline,#sz,#pointer)
 	callg write_string(outfile,multiline,sz,pointer)
 end
-function write_popstring(ss pointer,sd sz,sd outfile)
+function write_popstring(ss pointer,sd sz,sd outfile) #has an upper write_allow check
 	call writecl(outfile) #write {}, can work for char*?see at declare
 	add sz pointer
 	if pointer!=sz
--- ocompiler-1.orig/tests/db
+++ ocompiler-1/tests/db
@@ -1,4 +1,6 @@
 
 if [ -z "${OCONV}" ]; then OCONV=../otoc/otoc; fi
-./xb ${1} && \
-${OCONV} ${1}.oc.x
+a=${1}
+shift
+./xb ${a} && \
+${OCONV} ${a}.oc.x $@
--- /dev/null
+++ ocompiler-1/tests/dbr
@@ -0,0 +1 @@
