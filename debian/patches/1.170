+++ /dev/null
@@ -1,2 +0,0 @@
-
-OCOMP='q '"${HOME}"/o/ocompiler-2/src/o OCONV='qq '"${HOME}"/o/ocompiler-2/otoc/otoc ./mrt
--- /dev/null
+++ actionswf-1/oaas.html
@@ -0,0 +1,79 @@
+<!DOCTYPE html>
+<html>
+<head>
+<style>
+	.red
+	{
+		color:red;
+	}
+	.green
+	{
+		color:green;
+	}
+	.yellow
+	{
+		color:yellow;
+	}
+	.blue
+	{
+		color:cyan;
+	}
+	table td {
+		border: 1px solid;
+	}
+	.com, .com td { /* com on td, but also with inner tables with their own tds */
+		border: none;
+		white-space: nowrap;
+	}
+	td table { /* this to extend inside table borders to full width */
+		width: 100%;
+	}
+</style>
+</head>
+
+<body>
+<h1>OA AS syntax</h1>
+<p class="red">String</p>
+<p class="blue">Left/Right strings</p>
+<p class="yellow">Tested</p>
+<p class="green">[] is optional , or , and</p>
+<table>
+	<tr><td>a</td>                        <td><table class="red"><tr><td colspan=2>className</td></tr>
+	                                                             <tr><td>className</td><td>extendName</td></tr></table></td>
+	                                      <td class="com"><table><tr><td>class <span class="red">className</span>{</td></tr>
+	                                                             <tr><td>class <span class="red">className</span> extends <span class="red">extendName</span>{</td></tr></table></td></tr>
+	<tr><td>c</td>                        <td class="red">comment</td><td class="com">//<span class="red">comment</span></td></tr>
+	<tr><td>d</td>                        <td><table class="red"><tr><td colspan=2>childName</td></tr>
+	                                                             <tr><td>childName</td><td>parentName</td></tr></table></td>
+	                                      <td class="com"><table><tr><td>addChild(<span class="red">childName</span>);</td></tr>
+	                                                             <tr><td><span class="red">parentName</span>.addChild(<span class="red">childName</span>);</td></tr></table></td></tr>
+	<tr><td class="blue" colspan=2>e</td><td class="com">is adding <span class="blue">e</span> in first <span class="blue">()</span></td></tr>
+	<tr><td rowspan=2>f</td>              <td>p</td><td class="com">public function new(){super();</td></tr>
+      <tr>                                  <td>s</td><td class="com">static function main(){</td></tr>
+	<tr><td>g</td>                        <td class="red">varName</td><td class="com">var <span class="red">varName</span>=Lib.current.stage;</td></tr>
+	<tr><td>i</td>                        <td class="red">importString</td><td class="com">import <span class="red">importString</span>;</td></tr>
+	<tr><td class="blue">l</td>           <td class="red">name</td><td class="com"><span class="red">name</span>.graphics.<span class="blue">beginFill(color);</span> <span class="green">or</span> <span class="red">name</span>.graphics.<span class="blue">endFill();</span></td><td class="com"><span class="blue">beginFill(color);</span> <span class="green">or</span> <span class="blue">endFill();</span></td></tr>
+	<tr><td class="blue" rowspan=2>m</td><td></td><td class="com">buttonMode=<span class="blue">value;</span></td><td class="com">u<span class="yellow">seHandCursor=</span><span class="blue">value;</span></td></tr>
+	<tr>                                  <td>b</td><td class="com">same plus <span class="blue">mouseChildren=false;</span></td></tr>
+	<tr><td colspan=2>n</td>              <td class="com">static</td></tr>
+	<tr><td class="blue" colspan=2 rowspan=4>o</td><td class="com">addEventListener(Event.ENTER_FRAME,<span class="blue">functionName</span>);</td><td class="com"><span class="yellow">onEnterFrame=</span><span class="blue">functionName</span><span class="yellow">;</span></td></tr>
+	<tr>                                           <td class="com">addEventListener(MouseEvent.MOUSE_CLICK,<span class="blue">functionName</span>);</td><td class="com"><span class="yellow">onPress=</span><span class="blue">functionName</span><span class="yellow">;</span></td></tr>
+	<tr>                                           <td class="com">addEventListener(MouseEvent.MOUSE_OVER,<span class="blue">functionName</span>);</td><td class="com"><span class="yellow">onRollOver=</span><span class="blue">functionName</span><span class="yellow">;</span></td></tr>
+	<tr>                                           <td class="com">addEventListener(MouseEvent.MOUSE_OUT,<span class="blue">functionName</span>);</td><td class="com"><span class="yellow">onRollOut=</span><span class="blue">functionName</span><span class="yellow">;</span></td></tr>
+	<tr><td class="blue" colspan=2>p</td><td class="com"><span class="blue">alpha=value</span>/100;</td><td class="com">_<span class="blue">alpha=value</span><span class="yellow">;</span></td></tr>
+	<tr><td class="blue">r</td>          <td class="red">name</td><td class="com"><span class="red">name</span>.graphics.drawRect<span class="blue">(x,y</span>,<span class="blue">width,height)</span>;</td><td class="com">lineTo<span class="yellow">(</span><span class="blue">width</span><span class="yellow">,</span><span class="blue">y</span><span class="yellow">)</span>;lineTo(width<span class="blue">,height)</span>;lineTo<span class="blue">(x,</span>height)<span class="blue">;</span></td></tr>
+	<tr><td class="blue" rowspan=4>s</td><td>_</td><td class="com">is removing all <span class="blue">_</span></td></tr>
+	<tr>                                 <td>w</td><td class="com">is replacing all <span class="blue">Stage.w</span> with <span class="blue">stage.stageW</span></td></tr>
+	<tr>                                 <td>h</td><td class="com">is replacing all <span class="blue">Stage.h</span> with <span class="blue">stage.stageH</span></td></tr>
+	<tr>                                 <td><span class="green">[</span>_wh<span class="green">]</span></td> <td class="com">any case or at least one</td></tr>
+	<tr><td class="blue" colspan=2>t</td><td class="com">var <span class="blue">label</span>=new TextField();<span class="green">[</span><span class="blue">label</span>.x=<span class="blue">x</span>;<span class="green">]</span><span class="green">[</span><span class="blue">label</span>.y=<span class="blue">y</span>;<span class="green">]</span><span class="green">[</span><span class="blue">label</span>.width=<span class="blue">width</span>;<span class="green">]</span><span class="green">[</span><span class="blue">label</span>.height=<span class="blue">height</span>;<span class="green">]</span></td><td class="com">createTextField(<span class="yellow">'</span><span class="blue">label</span><span class="yellow">',</span>nr<span class="yellow">,</span><span class="blue">x</span><span class="yellow">,</span><span class="blue">y</span><span class="yellow">,</span><span class="blue">width</span><span class="yellow">,</span><span class="blue">height</span><span class="yellow">)</span>;</td></tr>
+	<tr><td>v</td>                       <td class="red"><table><tr><td>name</td><td>class</td></tr></table></td><td class="com" rowspan=2>var <span class="red">name</span>=new <span class="red">class</span>();</td></tr>
+	<tr><td class="blue" colspan=2>v</td>                                                                                                                                                                              <td class="com">attachMovie(<span class="yellow">'</span><span class="blue">class</span><span class="yellow">'</span>,<span class="yellow">'</span><span class="blue">name</span><span class="yellow">'</span>,getNextHighestDepth());</td></tr>
+	<tr><td class="blue" colspan=2>x</td><td class="com"><span class="blue">leftPart=</span>TextFormatAlign.<span class="blue">TYPE;</span></td><td class="com"><span class="blue">leftPart=</span><span class="yellow">'</span><span class="blue">type</span><span class="yellow">'</span><span class="blue">;</span></td></tr>
+</table>
+Other recognized notations:
+<table>
+	<tr><td>}</td></tr>
+</table>
+</body>
+</html>
--- actionswf-1.orig/oaas/Makefile
+++ actionswf-1/oaas/Makefile
@@ -11,7 +11,10 @@ ifndef OCONV
 OCONV=otoc
 endif
 ifndef linkerflags
-linkerflags=-O3 -s
+	linkerflags=-O3 -s
+	ifeq ($(findstring mingw,$(CC)),)
+		linkerflags += -march=native
+	endif
 endif
 ifndef compilerflags
 compilerflags=${linkerflags}
@@ -22,33 +25,66 @@ endif
 ifndef prefix
 prefix=/usr
 endif
+ifndef platform
+platform=lin
+endif
 
 ifeq (${conv_64},1) #to cross compile
 	ifneq ($(CC),arm-linux-gnueabihf-gcc)
 		model=-m32
 	endif
+else
+	ifeq (${platform},win) #to long long
+		OCONVFLAGS=-
+	endif
 endif
 
 OFLAGS=x_file 2
 
-libname=liboaas.so
+firstname=liboaas
+libname=${firstname}.so
+libnamedll=${firstname}.dll
+
+objs=translate util ${platform}
+
+$(eval obs = )
+$(foreach var,$(objs),$(eval obs += ${var}.o))
+$(eval logs = )
+$(foreach var,$(objs),$(eval logs += ${var}.oc.log))
+$(eval cfiles = )
+$(foreach var,$(objs),$(eval cfiles += ${var}.c))
+$(eval xfiles = )
+$(foreach var,$(objs),$(eval xfiles += ${var}.oc.x))
 
 objects=main.o
+exte=libexte.a
+
+all: headers ${libname}
+
+headers:
+	$(MAKE) -C ../include common.h
 
-all: ${libname}
+${libname}: ${objects} ${exte}
+	${OLINK} main.oc.log ${logs}
+	if [ "${platform}" = "lin" ]; then \
+		$(CC) ${model} ${linkerflags} -shared $< -o ${libname} -L. -l:${exte} -Wl,--exclude-libs=${exte}; \
+	else \
+		x86_64-w64-mingw32-gcc --no-leading-underscore ${linkerflags} ${objects} ${obs} -shared -lmsvcrt -o ${libnamedll} -Wl,--exclude-modules-for-implib `printf ',%s' ${obs} | cut -c2-`; \
+	fi
 
-${libname}: ${objects}
-	${OLINK} main.oc.log
-	$(CC) ${model} ${linkerflags} -shared $< -o ${libname}
+${exte}: ${obs}
+	$(AR) cr ${exte} $^
 
 %.o: %.oc
-	${OCOMP} $< ${OFLAGS}
+	${OCOMP} $< ${OFLAGS} include_sec 1
 	${OCONV} ${OCONVFLAGS} $<.x import
 	$(CC) ${model} -c -w -fPIC ${compilerflags} ${EXTRA_CFLAGS} $*.c
 
 clean:
+	$(MAKE) -C ../include clean
 	-rm -f main.oc.log main.oc.x main.c
-	-rm -f ${objects} ${libname}
+	-rm -f ${objects} ${exte} ${libname} ${libnamedll}
+	-rm -f ${obs} ${logs} ${xfiles} ${cfiles}
 
 distclean: clean
 
@@ -63,4 +99,4 @@ install: all install-lib
 uninstall:
 	-rm -f $(DESTDIR)$(prefix)/lib/${libname}
 
-.PHONY: all install install-lib clean distclean uninstall test
+.PHONY: all headers install install-lib clean distclean uninstall test
--- /dev/null
+++ actionswf-1/oaas/lin.oc
@@ -0,0 +1,9 @@
+
+format elfobj64
+
+^importx "stdout" stdout
+
+function platform_stdout()
+	svu s^stdout
+	return s#
+end
--- actionswf-1.orig/oaas/main.oc
+++ actionswf-1/oaas/main.oc
@@ -1,10 +1,33 @@
 
 format elfobj64
 
+einclude "../include/ascii.h" "../include/ascii.oh"
+
+^import "translate_one" translate_one 2
+^import "translate_two" translate_two 2
+
+import "print_stdout" print_stdout
+import "translated_ratio" translated_ratio
+
 functionx line(ss oa)
-	#remove "text" 'text'
-	#a . af . function a() -> function a(e) , find ()
-	#r . r_x _x -> x
-	#x next is untranslated
-	return oa
+	callret translate_one(oa,"")
+end
+
+functionx startline(ss start,ss oa)
+	#at this function first can be syntax dependent of start string
+	ss result
+	set result translate_two(start,oa)
+	if result!=oa
+		return result
+	end
+
+	#or normal line
+	#if start was modified in a syntax, don't worry, this callret will return untranslated oa and not go in start because _one and _two letters are unique overall
+	callret translate_one(oa,start)
+end
+
+functionx ratio()
+	call print_stdout("Ratio: ")
+	call translated_ratio()
+	call print_stdout("\n")
 end
--- /dev/null
+++ actionswf-1/oaas/mw
@@ -0,0 +1,4 @@
+set -e
+CC=x86_64-w64-mingw32-gcc platform=win make $@
+cd ../tests/as3
+./aw $@
--- /dev/null
+++ actionswf-1/oaas/translate.oc
@@ -0,0 +1,1039 @@
+
+format elfobj64
+
+const a_page_size=0x1000
+#multithread unsafe
+charx a_page#a_page_size;vstr a_page_switch^a_page;charx b_page#a_page_size
+
+einclude "../include/common.h" "../include/common.oh"
+Const b_low=0x62
+Const c_low=0x63
+Const d_low=0x64
+Const e_low=0x65
+Const f_low=0x66
+Const g_low=0x67
+Const h_low=0x68
+Const i_low=0x69
+Const m_low=0x6D
+Const n_low=0x6E
+Const o_low=0x6F
+Const p_low=0x70
+Const r_low=0x72
+Const t_low=0x74
+Const v_low=0x76
+Const w_low=0x77
+
+importx "free" free
+importx "memcmp" memcmp
+importx "strcpy" strcpy
+importx "strdup" strdup
+importx "snprintf" snprintf
+importx "strstr" strstr
+
+^import "commaafter" commaafter 1
+^import "commaon" commaon 1
+^import "equalafter" equalafter 1
+^import "equalon" equalon 1
+import "object_com" object_com
+import "object_make" object_make
+^import "parecafter" parecafter 1
+^import "parecon" parecon 1
+^import "pareoafter" pareoafter 1
+^import "pareoon" pareoon 1
+^import "pluson" pluson 1
+^import "quotafter" quotafter 1
+^import "quoton" quoton 1
+^import "replace" replace 5
+^import "semicolafter" semicolafter 1
+^import "semicolon" semicolon 1
+^import "spcfullafters" spcfullafters 1
+^import "spcfull" spcfull 1
+^import "strip" strip 3
+import "to_upper" to_upper
+import "translated" translated
+import "untranslated" untranslated
+
+function switch_page()
+	if globalt.a_page_switch=#globalt.a_page
+		set globalt.a_page_switch #globalt.b_page
+		return #globalt.a_page
+	end
+	set globalt.a_page_switch #globalt.a_page
+	return #globalt.b_page
+end
+
+#a cdEfg i  LMnOP RST V X
+# b     h jk     q   u w yz
+#also at the end
+
+#a	s [s]
+#d	s [s] but diff at format
+#c	comment
+#f	p/s
+#g	string
+#i	string
+#n	a letter and predef format
+#v	s s
+#}	mix indents and in
+
+function translate_one(ss in,ss indents)
+	ss oa;set oa spcfull(in)
+	sd ?len
+	ss ?chr;set chr oa#
+	ss cursor;ss pointer;ss ?reminder;ss ext;ss o_a
+	char blank=""
+	if chr=(a_low)
+		set o_a oa
+		inc oa
+		whiletrue
+			if oa#!=(Space)
+				if oa#!=(HorizontalTab)
+					break
+				end
+			end
+			inc oa
+
+			set cursor spcfullafters(#oa)
+			if cursor!=oa
+				set ext " extends "
+				set pointer spcfull(cursor)
+				set reminder cursor#;set cursor# (Nullchar)
+			else
+				set ext #blank
+				set pointer ext
+				set reminder (Nullchar)
+			end
+			set o_a# (Nullchar)
+			set len snprintf(#globalt.a_page,(a_page_size),"%s%sclass %s%s%s{",indents,in,oa,ext,pointer)
+			if len>0
+				if len<(a_page_size)
+					call translated("Class")
+					return #globalt.a_page
+				end
+			end
+			set o_a# (a_low)
+			set cursor# reminder
+			break
+		end
+	elseif chr=(c_low)
+		set cursor oa
+		inc oa
+		whiletrue
+			if oa#!=(Space)
+				if oa#!=(HorizontalTab)
+					break
+				end
+			end
+			set cursor# (Slash)
+			set reminder oa#;set oa# (Slash)
+			set len snprintf(#globalt.a_page,(a_page_size),"%s%s",indents,in)
+			if len>0
+				if len<(a_page_size)
+					call translated("Comment")
+					return #globalt.a_page
+				end
+			end
+			set oa# reminder
+			set cursor# (c_low)
+			break
+		end
+	elseif chr=(d_low)
+		set o_a oa
+		inc oa
+		whiletrue
+			if oa#!=(Space)
+				if oa#!=(HorizontalTab)
+					break
+				end
+			end
+			inc oa
+			set cursor spcfullafters(#oa)
+			if cursor!=oa
+				set ext "."
+				set pointer spcfull(cursor)
+				set reminder cursor#;set cursor# (Nullchar)
+			else
+				set ext #blank
+				set pointer ext
+				set reminder (Nullchar)
+			end
+			set o_a# (Nullchar)
+			set len snprintf(#globalt.a_page,(a_page_size),"%s%s%s%saddChild(%s);",indents,in,pointer,ext,oa)
+			if len>0
+				if len<(a_page_size)
+					call translated("AddChild")
+					return #globalt.a_page
+				end
+			end
+			set o_a# (d_low)
+			set cursor# reminder
+			break
+		end
+	elseif chr=(f_low)
+		set cursor oa
+		inc oa
+		whiletrue
+			if oa#!=(Space)
+				if oa#!=(HorizontalTab)
+					break
+				end
+			end
+			inc oa
+			whiletrue
+				ss type;ss name
+				if oa#=(p_low)
+					set type "public"
+					set name "new"
+					set ext "super();"
+				elseif oa#=(s_low)
+					set type "static"
+					set name "main"
+					set ext #blank
+				else
+					break
+				end
+				inc oa
+				if oa#=(Nullchar)
+					set cursor# (Nullchar)
+					set len snprintf(#globalt.a_page,(a_page_size),"%s%s%s function %s(){%s",indents,in,type,name,ext)
+					if len>0
+						if len<(a_page_size)
+							call translated("Function")
+							return #globalt.a_page
+						end
+					end
+					set cursor# (f_low)
+				end
+				break
+			end
+			break
+		end
+	elseif chr=(g_low)
+		set cursor translate_one_1((g_low),oa,"%s%svar %s=Lib.current.stage;",indents,in,"Stage")
+		if cursor!=oa
+			return cursor
+		end
+	elseif chr=(i_low)
+		set cursor translate_one_1((i_low),oa,"%s%simport %s;",indents,in,"Import")
+		if cursor!=oa
+			return cursor
+		end
+	elseif chr=(n_low)
+		set o_a oa
+		inc oa
+		if oa#=(Nullchar)
+			set o_a# (Nullchar)
+			set len snprintf(#globalt.a_page,(a_page_size),"%s%sstatic",indents,in)
+			if len>0
+				if len<(a_page_size)
+					call translated("Static")
+					return #globalt.a_page
+				end
+			end
+			set o_a# (n_low)
+		end
+	elseif chr=(v_low)
+		set o_a oa
+		inc oa
+		whiletrue
+			if oa#!=(Space)
+				if oa#!=(HorizontalTab)
+					break
+				end
+			end
+			inc oa
+			set cursor spcfullafters(#oa)
+			if cursor!=oa
+				set pointer spcfull(cursor)
+				if pointer!=cursor
+					set reminder cursor#;set cursor# (Nullchar)
+					set o_a# (Nullchar)
+					set pointer translate_one_var(indents,in,oa,pointer,#globalt.a_page,#blank)
+					if pointer!=in
+						return pointer
+					end
+					set o_a# (v_low)
+					set cursor# reminder
+				end
+			end
+			break
+		end
+	elseif chr=(Nullchar)
+		call translated("blank")
+		return in
+	else
+		if oa#=(Closingbrace)
+			inc oa
+			if oa#=(Nullchar)
+				set len snprintf(#globalt.a_page,(a_page_size),"%s%s",indents,in)
+				if len>0
+					if len<(a_page_size)
+						call translated("closing")
+						return #globalt.a_page
+					end
+				end
+			end
+		end
+	end
+	call untranslated(in)
+	return in
+end
+function translate_one_1(ss ?chr,ss oa,ss format,ss indents,ss in,ss ok)
+	ss cursor;set cursor oa
+	inc oa
+	whiletrue
+		if oa#!=(Space)
+			if oa#!=(HorizontalTab)
+				break
+			end
+		end
+		inc oa
+		set cursor# (Nullchar)
+		sd ?len;set len snprintf(#globalt.a_page,(a_page_size),format,indents,in,oa)
+		if len>0
+			if len<(a_page_size)
+				call translated(ok)
+				return #globalt.a_page
+			end
+		end
+		set cursor# chr
+		break
+	end
+	return cursor
+end
+function translate_one_var(ss indents,ss in,ss oa,ss pointer,ss out,ss two)
+	sd ?len
+	set len snprintf(out,(a_page_size),"%s%svar %s=new %s();%s",indents,in,oa,pointer,two)
+	if len>0
+		if len<(a_page_size)
+			call translated("Var")
+			return globalt.a_page_switch
+		end
+	end
+	return in
+end
+
+#e	()
+#l	b or e
+#m	seHandCursor=; same as p but diff at format and continuation
+#o	onPATTERN=;
+#p	alpha=;
+#r	(,),)(,
+#s	_ and more
+#t	'',,,,)
+#v	''''
+#x	=''
+
+function translate_two(ss start,ss in)
+	ss oa;set oa spcfull(in)
+	ss cursor;ss pointer
+	ss ?chr;set chr oa#
+	if chr=(e_low)
+		inc oa
+		set cursor translate_eparam(start) #why here? who is using untranslated, anyway
+		if cursor!=start
+			set cursor translate_two_switch(oa,cursor)
+			if cursor!=oa
+				return cursor
+			end
+		end
+	elseif chr=(l_low)
+		inc oa
+		whiletrue
+			if oa#!=(Space)
+				if oa#!=(HorizontalTab)
+					break
+				end
+			end
+			inc oa
+			set pointer pluson(oa)
+			if pointer!=oa
+				set pointer# (Nullchar)
+			end
+			set cursor translate_fill(start,oa)
+			set cursor translate_two_switchAfter(cursor,oa,pointer)
+			if cursor!=oa
+				return cursor
+			end
+			dec oa
+			break
+		end
+	elseif chr=(m_low)
+		inc oa
+		set cursor translate_buttonmode(start,oa)
+		if cursor!=start;return cursor;end
+	elseif chr=(o_low)
+		inc oa
+		set cursor translate_onev(start)
+		if cursor!=start
+			set cursor translate_two_switch(oa,cursor)
+			if cursor!=oa
+				return cursor
+			end
+		end
+	elseif chr=(p_low)
+		inc oa
+		set cursor translate_alpha(start)
+		if cursor!=start
+			set cursor translate_two_switch(oa,cursor)
+			if cursor!=oa
+				return cursor
+			end
+		end
+	elseif chr=(r_low)
+		inc oa
+		whiletrue
+			if oa#!=(Space)
+				if oa#!=(HorizontalTab)
+					break
+				end
+			end
+			inc oa
+			set pointer pluson(oa)
+			if pointer!=oa
+				set pointer# (Nullchar)
+			end
+			set cursor translate_rect(start,oa)
+			set cursor translate_two_switchAfter(cursor,oa,pointer)
+			if cursor!=oa
+				return cursor
+			end
+			dec oa
+			break
+		end
+	elseif chr=(s_low)
+		inc oa
+		set cursor translate_srch(start,oa)
+		if cursor!=oa;return cursor;end
+	elseif chr=(t_low)
+		inc oa
+		set cursor translate_textfield(start)
+		if cursor!=start
+			set cursor translate_two_switch(oa,cursor)
+			if cursor!=oa
+				return cursor
+			end
+		end
+	elseif chr=(v_low)
+		inc oa
+		set cursor translate_var(start)
+		if cursor!=start
+			set cursor translate_two_switch(oa,cursor)
+			if cursor!=oa
+				return cursor
+			end
+		end
+	elseif chr=(x_low)
+		inc oa
+		set cursor translate_textformat(start)
+		if cursor!=start
+			set cursor translate_two_switch(oa,cursor)
+			if cursor!=oa
+				return cursor
+			end
+		end
+	elseif chr=(Nullchar)
+		ss mem;set mem strdup(start) #must remember that start is touched in calls #set cursor fn(mem,oa) is not yet through otoc
+		set cursor translate_textformat(mem)
+		if cursor=mem
+			call strcpy(mem,start)
+			set cursor translate_textfield(mem)
+			if cursor=mem
+				call strcpy(mem,start)
+				set cursor translate_var(mem)
+				if cursor=mem
+					call strcpy(mem,start)
+					set cursor translate_srch_all(mem)
+					if cursor=mem
+						call strcpy(mem,start)
+						set cursor translate_alpha(mem)
+						if cursor=mem
+							call strcpy(mem,start)
+							set cursor translate_buttonmode(mem,(NULL))
+							if cursor=mem
+								call strcpy(mem,start)
+								set cursor translate_onev(mem)
+								if cursor=mem
+									call strcpy(mem,start)
+									set cursor translate_eparam(mem)
+								end
+							end
+						end
+					end
+				end
+			end
+		end
+		call free(mem)
+		if cursor!=mem;return cursor;end
+	end
+	return in
+end
+function translate_two_switch(ss oa,ss cursor)
+	if oa#=(Nullchar)
+		return cursor
+	end
+	if oa#=(Plus)
+		callret translate_two_switcher(oa)
+	end
+	return oa
+end
+function translate_two_switcher(ss oa)
+	inc oa
+	ss page;set page switch_page()
+	set page translate_two(page,oa)
+	if page!=oa
+		return page
+	end
+	dec oa
+	return oa
+end
+function translate_two_switchAfter(ss cursor,ss oa,ss pointer)
+	if pointer!=oa
+		if cursor!=oa
+			set cursor translate_two_switcher(pointer)
+			if cursor!=pointer
+				return cursor
+			end
+		end
+		set pointer# (Plus)
+	else
+		if cursor!=oa
+			return cursor
+		end
+	end
+	return oa
+end
+
+function translate_eparam(ss start)
+	ss str="()"
+	ss p;set p strstr(start,str)
+	if p!=(NULL)
+		set p# (Nullchar)
+		inc p
+		sd ?n;set n snprintf(globalt.a_page_switch,(a_page_size),"%s(e%s",start,p)
+		#set p# '('
+		if n>0
+			if n<(a_page_size)
+				call translated("Event")
+				return globalt.a_page_switch
+			end
+		end
+	end
+	return start
+end
+
+function translate_fill(ss indents,ss name)
+	ss cursor;set cursor spcfull(indents)
+	ss ?chr;set chr cursor#
+	whiletrue
+		if chr!=(b_low)
+			if chr!=(e_low)
+				break
+			end
+		end
+		set cursor# (Nullchar)
+		inc cursor
+		sd ?len
+		set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s.graphics.%c%s",indents,name,chr,cursor)
+		if len>0
+			if len<(a_page_size)
+				call translated("Fill")
+				return globalt.a_page_switch
+			end
+		end
+	end
+	return name
+end
+
+function translate_buttonmode(ss indents,ss oa)
+	ss cursor;set cursor spcfull(indents)
+	set cursor# (Nullchar)
+	inc cursor
+	sd ?c
+	char against="seHandCursor="^
+	set c memcmp(cursor,#against,13)
+	if c=0
+		add cursor 13
+		ss pointer
+		sd ?len
+		set pointer globalt.a_page_switch
+		sd ?size;set size (a_page_size)
+		set len snprintf(pointer,size,"%sbuttonMode=%s",indents,cursor)
+		if len>0
+			if len<(a_page_size)
+				ss ok="ButtonMode"
+				whiletrue
+					if oa=(NULL)
+						break
+					end
+					if oa#=(Nullchar)
+						break
+					end
+					#here is not always wanted to be if there are no children inside, or if disabling the button
+					if oa#=(b_low) #is set once to make it look like a button
+						inc oa
+						add pointer len
+						sub size len
+						set len snprintf(pointer,size,"mouseChildren=false;")
+						if len<0
+							return indents
+						end
+						if len>=size
+							return indents
+						end
+					end
+					if oa#=(Plus)
+						call translated(ok)
+						set cursor translate_two_switcher(oa)
+						if cursor!=oa
+							return cursor
+						end
+						return indents
+					end
+					break
+				end
+				call translated(ok)
+				return globalt.a_page_switch
+			end
+		end
+	end
+	return indents
+end
+
+function translate_onev(ss start)
+	ss cursor
+	set cursor equalon(start)
+	if cursor!=start
+		ss pointer;set pointer cursor
+		while start!=pointer
+			dec pointer
+			if pointer#=(o_low)
+				inc pointer
+				if pointer#=(n_low)
+					inc pointer
+					vstr mous="Mouse"
+					sd ?c
+					set c memcmp(pointer,"EnterFrame",10) #memcmp is defined to compare the first 10 bytes
+					if c=0
+						set cursor translate_on(start,"","ENTER_FRAME",cursor)
+					else
+						set c memcmp(pointer,"Press",5)
+						if c=0
+							set cursor translate_on(start,mous,"CLICK",cursor)
+						else
+							set c memcmp(pointer,"RollOver",8)
+							if c=0
+								set cursor translate_on(start,mous,"MOUSE_OVER",cursor)
+							else
+								set c memcmp(pointer,"RollOut",7)
+								if c=0
+									set cursor translate_on(start,mous,"MOUSE_OUT",cursor)
+								end
+							end
+						end
+					end
+					if c=0
+						if cursor!=start
+							call translated("On")
+							return cursor
+						end
+					end
+					break # on is unique at the moment
+				end
+				dec pointer
+			end
+		end
+	end
+	return start
+end
+function translate_on(ss start,ss type,ss ev,ss value)
+	inc value
+	ss cursor
+	set cursor semicolon(value)
+	if cursor!=value
+		ss pointer
+		set pointer spcfull(start)
+		set pointer# (Nullchar)
+		set cursor# (Nullchar)
+		inc cursor
+		sd ?n;set n snprintf(globalt.a_page_switch,(a_page_size),"%saddEventListener(%sEvent.%s,%s);%s",start,type,ev,value,cursor)
+		if n>0
+			if n<(a_page_size)
+				return globalt.a_page_switch
+			end
+		end
+	end
+	return start
+end
+
+function translate_alpha(ss indents)
+	ss cursor;set cursor spcfull(indents)
+	set cursor# (Nullchar)
+	inc cursor
+	sd ?c
+	ss sizer=6
+	char against="alpha="^
+	set c memcmp(cursor,#against,sizer)
+	if c=0
+		add sizer cursor
+		ss pointer
+		set pointer semicolon(sizer)
+		if pointer!=sizer
+			set pointer# (Nullchar)
+			inc pointer
+			sd ?len
+			set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s/100;%s",indents,cursor,pointer)
+			if len>0
+				if len<(a_page_size)
+					call translated("Alpha")
+					return globalt.a_page_switch
+				end
+			end
+		end
+	end
+	return indents
+end
+
+function translate_rect(ss indents,ss name)
+	ss cursor;set cursor spcfull(indents)
+	set cursor# (Nullchar) #on lineTo...
+	inc cursor
+	ss width
+	set width pareoafter(cursor)
+	if width!=cursor
+		ss width_end
+		set width_end commaon(width) #(width,
+		if width_end!=width
+			ss y=1;add y width_end
+			ss y_end
+			set y_end parecon(y)   #,y)
+			if y_end!=y
+				set cursor y_end
+				inc cursor
+				ss height
+				set height commaon(cursor)
+				if height!=cursor
+					ss height_end
+					set height_end parecafter(height)    #,height)
+					if height_end!=height
+						set cursor height_end
+						inc cursor
+						ss x;set x pareoon(cursor)
+						if x!=cursor
+							ss x_end
+							set x_end commaafter(x) #(x,
+							if x_end!=x
+								set cursor semicolon(x_end)
+								if cursor!=x_end
+									set x_end# (Nullchar)
+									set y_end# (Nullchar)
+									set width_end# (Nullchar)
+									set height_end# (Nullchar)
+									sd ?len
+									set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s.graphics.drawRect%s%s,%s%s%s",indents,name,x,y,width,height,cursor)
+									if len>0
+										if len<(a_page_size)
+											call translated("Rect")
+											return globalt.a_page_switch
+										end
+									end
+								end
+							end
+						end
+					end
+				end
+			end
+		end
+	end
+	return name
+end
+
+function translate_srch(ss start,ss oa)
+	ss cursor
+	whiletrue
+		if oa#!=(Nullchar)
+			if oa#!=(Plus)
+				break
+			end
+		end
+		set cursor translate_srch_all(start)
+		if cursor!=start
+			call translated("SearchAll")
+			if oa#=(Plus)
+				set cursor translate_two_switcher(oa)
+				if cursor=oa
+					return oa
+				end
+			end
+			return cursor
+		end
+		return oa
+	end
+	whiletrue
+		if oa#!=(Space)
+			if oa#!=(HorizontalTab)
+				break
+			end
+		end
+		set cursor translate_search(start,oa)
+		if cursor!=oa
+			return cursor
+		end
+		break
+	end
+	return oa
+end
+function translate_srch_all(ss start)
+	ss ?t=7
+	ss cursor
+	set cursor translate_search_base(start,#t)
+	if t=0
+		return start
+	end
+	return cursor
+end
+function translate_search(ss start,ss oa)
+	ss cursor;set cursor oa
+	inc cursor
+	ss ?types=0
+	while cursor#!=(Nullchar)
+		if cursor#=(_)
+			or types 1
+			inc cursor
+			continue
+		end
+		if cursor#=(w_low)
+			or types 2
+			inc cursor
+			continue
+		end
+		if cursor#=(h_low)
+			or types 4
+			inc cursor
+			continue
+		end
+		if cursor#=(Plus)
+			break
+		end
+		return oa
+	end
+	ss ?t;set t types
+	ss pointer
+	set pointer translate_search_base(start,#types)
+	if types=t
+		call translated("Search")
+		if cursor#=(Plus)
+			set pointer translate_two_switcher(cursor)
+			if pointer=cursor
+				return cursor
+			end
+		end
+		return pointer
+	end
+	return oa
+end
+function translate_search_base(ss start,ss ptypes)
+	ss cursor;set cursor start
+	ss str
+	ss ?t=1
+	and t ptypes#
+	if t!=0
+		set str strip(start,globalt.a_page_switch,(a_page_size)) #can't recognize at search all if is good or bad without different buffer
+		if str!=start
+			set start str
+		else
+			xor ptypes# 1
+		end
+	end
+	ss pointer
+	set t 2
+	and t ptypes#
+	if t!=0
+		if cursor!=start
+			set pointer strdup(start) #else will be a collision
+		end
+		set str replace(pointer,"Stage.w","stage.stageW",globalt.a_page_switch,(a_page_size))
+		if cursor!=start
+			call free(pointer)
+		end
+		if str!=pointer
+			set start str
+		else
+			xor ptypes# 2
+		end
+	end
+	set t 4
+	and t ptypes#
+	if t!=0
+		if cursor!=start
+			set pointer strdup(start)
+		end
+		set str replace(pointer,"Stage.h","stage.stageH",globalt.a_page_switch,(a_page_size))
+		if cursor!=start
+			call free(pointer)
+		end
+		if str!=pointer
+			set start str
+		else
+			xor ptypes# 4
+		end
+	end
+	return start
+end
+
+function translate_textfield(ss start)
+	ss cursor
+	set cursor translate_label(start)
+	if cursor!=start
+		call translated("Text")
+		return cursor
+	end
+	return start
+end
+function translate_label(ss indents)
+	ss cursor;set cursor spcfull(indents)
+	set cursor# (Nullchar) #on create...
+	ss name
+	inc cursor
+	set name quotafter(cursor)
+	if name!=cursor
+		set cursor quoton(name)
+		if cursor!=name
+			ss buffer;set buffer globalt.a_page_switch
+			sd ?size
+			set size object_make(indents,name,cursor,"TextField",#buffer,(a_page_size))
+			if size!=0
+				inc cursor
+				ss pointer
+				set pointer commaafter(cursor)
+				if pointer!=cursor
+					set cursor commaafter(pointer)
+					if cursor!=pointer
+						set pointer commaon(cursor)
+						if pointer!=cursor
+							sd ?len
+							set len object_com(name,"x",cursor,pointer,#buffer,size)
+							if len!=0
+								inc pointer
+								set cursor commaon(pointer)
+								if cursor!=pointer
+									set size object_com(name,"y",pointer,cursor,#buffer,len)
+									if size!=0
+										inc cursor
+										set pointer commaon(cursor)
+										set len object_com(name,"width",cursor,pointer,#buffer,size)
+										if len!=0
+											inc pointer
+											set cursor parecon(pointer)
+											set size object_com(name,"height",pointer,cursor,#buffer,len)
+											if size!=0
+												inc cursor
+												set pointer semicolafter(cursor) # this for + case
+												if pointer!=cursor
+													set len snprintf(buffer,size,"%s",pointer) #strncat or strncpy are not good here
+													if len>=0
+														if len<size
+															return globalt.a_page_switch
+														end
+													end
+												end
+											end
+										end
+									end
+								end
+							end
+						end
+					end
+				end
+			end
+		end
+	end
+	return indents
+end
+
+function translate_var(ss indents)
+	ss cursor;set cursor spcfull(indents)
+	set cursor# (Nullchar) #on attach...
+	ss class
+	inc cursor
+	set class quotafter(cursor)
+	if class!=cursor
+		set cursor quoton(class)
+		if cursor!=class
+			set cursor# (Nullchar)
+			inc cursor
+			ss name
+			set name quotafter(cursor)
+			if name!=cursor
+				set cursor quoton(name)
+				if cursor!=class
+					set cursor# (Nullchar)
+					inc cursor
+					ss pointer
+					set pointer semicolafter(cursor)
+					if pointer!=cursor
+						ss b=""
+						set cursor translate_one_var(indents,b,name,class,globalt.a_page_switch,pointer)
+						if cursor!=b
+							call translated("VarMorph")
+							return cursor
+						end
+					end
+				end
+			end
+		end
+	end
+	return indents
+end
+
+function translate_textformat(ss start)
+	ss cursor
+	set cursor equalafter(start)
+	if cursor!=start
+		ss type
+		set type quotafter(cursor)
+		if type!=cursor
+			ss pointer
+			set pointer quoton(type)
+			if pointer!=type
+				call to_upper(type,pointer)
+				set cursor# (Nullchar)
+				set pointer# (Nullchar)
+				inc pointer
+				sd ?len;set len snprintf(globalt.a_page_switch,(a_page_size),"%sTextFormatAlign.%s%s",start,type,pointer)
+				if len>0
+					if len<(a_page_size)
+						call translated("TextFormat")
+						return globalt.a_page_switch
+					end
+				end
+			end
+		end
+	end
+	return start
+end
+
+entryraw globalt()
+
+#!
+AddChild
+Alpha
+blank
+ButtonMode
+Class
+closing
+Comment
+Event
+Fill
+Function
+Import
+On
+Rect
