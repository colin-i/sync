--- ocompiler-1.orig/otoc/action.oc
+++ ocompiler-1/otoc/action.oc
@@ -22,18 +22,20 @@ function action1(sv act,sv pbuffer,sd ou
 	callg act(pbuffer,outfile)
 end
 
-function action_areturn(sv pbuffer,sd outfile)
+function return(sd outfile)
 	if loop.function_start!=(err)
 		if loop.allowwrite=(allowwrite_yes) #can be no_include
 			call fseek(outfile,loop.function_start,(SEEK_SET))
 			call fwrite(#write_long.a,(write_long_cast),1,outfile)
 			call fseek(outfile,0,(SEEK_END))
-			#is ok to ignore multi return at entry because it is non-sense
-			#set loop.function_start (err) #if is not at endfunction, is here
+			set loop.function_start (err) #if is not at endfunction, is here. multipe returns,write once
 		end
 	end
 	char a="return "^  #also used at ret
-	call write(outfile,#a,\.a)
+	callg write(outfile,#a,\.a)
+end
+function action_areturn(sv pbuffer,sd outfile)
+	call return(outfile)
 	callg arg(pbuffer,outfile)
 end
 function action_aexit(sv pbuffer,sd outfile) #this exit() an option? now only entryraw/exit case
--- ocompiler-1.orig/otoc/loop.oc
+++ ocompiler-1/otoc/loop.oc
@@ -420,6 +420,9 @@ function action2(sd outfile,sv pbuffer)
 end
 function call(sd outfile,sv pbuffer)
 	char c#1;call get_char(pbuffer,#c)
+	if c=(Xfile_call_ret)
+		call return(outfile)
+	end
 	call cll(pbuffer,outfile)
 	callg writetn(outfile)
 end
@@ -474,7 +477,7 @@ function end(sd outfile)
 	callg writetn(outfile) #with termination only for struct
 end
 function ret(sd outfile)
-	call write(outfile,#action_areturn.a,\action_areturn.a-1)
+	call write(outfile,#return.a,\return.a-1)
 	callg writetn(outfile)
 end
 function library(sd *outfile,sv pbuffer)
