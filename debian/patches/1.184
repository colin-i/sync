+import re
+import subprocess
 target=os.environ.get('target')
 if target:
-	if target!="html5":
+	proj_compiler=os.environ.get('proj_compiler')
+	if not proj_compiler:
+		proj_compiler='openfl'
+	def get_openfl_targets():
+		out = subprocess.run(
+			[proj_compiler, "help", "build"],
+			capture_output=True, text=True
+		)
+		text = out.stdout + out.stderr
+
+		# strip ANSI color codes, in case the output is colored
+		text = re.sub(r"\x1b\[[0-9;]*m", "", text)
+
+		targets = []
+		in_section = False
+
+		for line in text.splitlines():
+			stripped = line.strip()
+
+			if stripped in ("Targets:", "Target Aliases:"):
+				in_section = True
+				continue
+
+			# any other "Something:" header ends the sections
+			if in_section and re.match(r"^[A-Za-z ]+:$", stripped):
+				in_section = False
+				continue
+
+			if in_section and " -- " in stripped:
+				names = stripped.split(" -- ", 1)[0]
+				for name in names.split("/"):
+					name = name.strip()
+					if name and name not in targets:
+						targets.append(name)
+		return targets
+	if target not in get_openfl_targets():
 		print('target not available')
 		exit(1)
 
