-			open_brace_line += 1
-
-		if open_brace_line == while_line:
-			i += 1
-			continue
-
-		# Find matching closing brace
-		brace_level = 0
-		close_brace_line = None
-		j = open_brace_line
-		while j < while_line:
-			brace_level += lines[j].count('{')
-			brace_level -= lines[j].count('}')
-			if brace_level == 0:
-				close_brace_line = j
-				break
