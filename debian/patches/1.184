-		replacement.append(f"{indent}while(true){{\n")
-		replacement.extend(body_lines)
-		replacement.append(f"{indent}{tabs}if({condition})continue;\n")
-		replacement.append(f"{indent}{tabs}break;\n")
-		replacement.append(f"{indent}}}\n")
-
