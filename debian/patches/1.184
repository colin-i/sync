+import "write_forward_offset_jump" write_forward_offset_jump
+#codepointer is right after doblock_end: condition tokens follow
+function action_code_do_end(sd codepointer)
+	sd base;set base cond_blocks_at_index(0)
+	sd b;set b cond_blocks_noerror()
+	#continues land here, at the condition
+	sd ?c
+	whiletrue
+		if b=base
+			call error("do block is broken")
+		end
+		sub b (DWORD)
+		set c b#
+		if c=(top_marker);break;end
+		and c (do_continue_bit)
+		if c!=0
+			set c b#
+			xor c (do_continue_bit)
+			call write_forward_offset_jump(c)
+		end
+	end
+	sd pointer;set pointer b
+	sub b (2*DWORD)
+	sd ?start;set start b#
+	#condition true: jump back
+	set codepointer action_code_right_util(codepointer)
+	call write_ifjump()
+	call resolve_back_jump(start)
+	#breaks land after the ActionIf
+	whiletrue
+		call brace_blocks_counter_dec()
+		set b cond_blocks_noerror()
+		if b=pointer;break;end
+		set c b#
+		and c (do_continue_bit)
+		if c=0
+			call write_forward_offset_jump(b#)
+		end
+	end
+	call brace_blocks_counter_dec()#type
+	call brace_blocks_counter_dec()#start
+	return codepointer
+end
