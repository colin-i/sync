 	if alt_ac!=(NULL)
 		call debug_base(0)
 		if pbuffer=alt_ac
-			call actions_format(psize,pbuffer,the_va_list)
+			call actions_format(pbuffer,psize,the_va_list)
 		else
 			call action_base(alt_ac)
 			call file_get_content__resources_free()
 		end
 	end
 end
-function actionsf_sprite_local(sd sprite,svu psize,sv pbuffer,sv %the_va_list)
