-			print(while_line)
-
-	return lines
-
-def main():
-	if len(sys.argv) != 2:
-		print("no input file")
-		sys.exit(1)
-
-	with open(sys.argv[1], "r", encoding="utf-8") as f:
-		lines = f.readlines()
-
