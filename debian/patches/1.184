-	brace_open = text.index('{', paren_close)
-	brace_close = find_matching_brace(text, brace_open)
-	return {
-		'exclaim_index': exclaim_index,
-		'brace_open': brace_open,
-		'brace_close': brace_close,
-	}
-
-
-def convert_if_block_to_continue(text, indent='      '):
-	"""
-	Turn:
