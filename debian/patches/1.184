 	sd alt_ac;set alt_ac alt_action(pbuffer,sprite) #this to trick alt action that if will return the same thing, will return a not null thing
 	if alt_ac!=(NULL)
 		call debug_base(sprite)
 		call swf_actionblock_change(sprite)
 		if pbuffer=alt_ac
-			call actions_format(psize,pbuffer,the_va_list)
+			call actions_format(pbuffer,psize,the_va_list)
 		else
