--- actionswf-1.orig/tests/apy
+++ actionswf-1/tests/apy
@@ -16,5 +16,6 @@ else
 		export LD_LIBRARY_PATH=../src
 	fi
 fi
+export PYTHONMALLOC=malloc #asan problems
