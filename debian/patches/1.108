--- actionswf-1.orig/Makefile
+++ actionswf-1/Makefile
@@ -15,7 +15,7 @@ $(SUBDIRS):
 
 test:
 	cd tests && conv_64=${conv_64} /bin/bash ./as && conv_64=${conv_64} /bin/bash ./c 1 && cd ffdec && conv_64=${conv_64} /bin/bash ./as && \
-	cd ../data && /bin/bash ./test x && echo tests ok
+	cd ../data && conv_64=${conv_64} /bin/bash ./test x && echo tests ok
 clean:
 	cd tests; /bin/bash ./c; cd ffdec; /bin/bash ./c; cd ../data; /bin/bash ./c
 install:
--- actionswf-1.orig/oad/Makefile
+++ actionswf-1/oad/Makefile
@@ -11,6 +11,11 @@ endif
 ifndef linkerflags
 linkerflags=-O3 -s
 endif
+ifeq (${conv_64},1) #to cross compile
+	model=-m32
+else
+	model=
+endif
 
 OFLAGS=x_file 2
 
@@ -41,13 +46,13 @@ ${exte}: ${subobjects}
 	$(AR) cr ${exte} $^
 ${libname}: main.o ${exte}
 	${OLINK} main.oc.log ${sublogs}
-	$(CC) ${linkerflags} -shared $< -o ${libname} -L. -l:${exte} -Wl,--exclude-libs ${exte}
+	$(CC) ${model} ${linkerflags} -shared $< -o ${libname} -L. -l:${exte} -Wl,--exclude-libs ${exte}
 # -l:intern.o ? is ok but exclude-libs intern.o/...a will not exclude
 
 %.o: %.oc
 	${OCOMP} $< ${OFLAGS}
 	${OCONV} $<.x
-	$(CC) -c -w -fPIC ${compilerflags} $*.c
+	$(CC) ${model} -c -w -fPIC ${compilerflags} $*.c
 #-fPIC since launchpad bionic build
 #-Wimplicit-function-declaration is good but anyway when making .x, ocompiler is also checking for this error
 %.oh: %.h.oh
