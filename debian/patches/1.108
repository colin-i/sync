--- actionswf-1.orig/tests/data/a
+++ actionswf-1/tests/data/a
@@ -1,11 +1,14 @@
 
 if [ -n "${1}" ]; then g="gdb --args"; fi
 
+model=
+if [ ${conv_64} = 1 ]; then model=-m32; fi
+
 f=../../example/example.swf
 
 o a.oc x_file 1 && \
 otoc a.oc.x && \
-cc -w -g a.c -L../../oad -loadbgdata && \
-LD_LIBRARY_PATH=../../oad ${g} ./a.out ${f} && \
-echo ok && \
+cc ${model} -w -g a.c -L../../oad -loadbgdata && \
+LD_LIBRARY_PATH=../../oad ${g} ./a.out ${f} || { echo a.out error; exit 1; }
+echo ok
 rm ${f}.data
--- actionswf-1.orig/tests/data/test
+++ actionswf-1/tests/data/test
@@ -1,6 +1,9 @@
 
+e=
+if [ ${conv_64} = 1 ]; then e=32; fi
+
 set -o pipefail && /bin/bash ./a | tee data.txt || exit 1
-diff ../.expected/data.txt data.txt
+diff ../.expected/data${e}.txt data.txt
 if [ $? = 0 ]; then
 	rm data.txt
 	exit 0
@@ -8,4 +11,4 @@ fi
 if [ -n "${1}" ]; then exit 1; fi
 echo y \?; read -n1 -t $((60*60*24)) ans
 if [ "${ans}" != "y" ]; then exit 1; fi
-mv data.txt ../.expected/data.txt
+mv data.txt ../.expected/data${e}.txt
--- /dev/null
+++ actionswf-1/tests/data/test32
@@ -0,0 +1 @@
+conv_64=1 ./test
