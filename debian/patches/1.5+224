-source ./inits
+. ./inits
 
-tests=( `find -name "*.oc"` )
+tests="$(find -name "*.oc")"
 
-for file in "${tests[@]}"; do
+for file in ${tests}; do
 	OFLAGS="x_file 1 nul_res_pref 1 includedir 0 relative_path 1"
 	#includedir 0 relative_path 1   to test on launchpad at <<PKGBUILDDIR>> that is not the real folder there. and ounused is also working with this
 
 	echo ${file} | grep "\.w" > /dev/null
-	if [ $? = 0 ]; then OFLAGS+=" inplace_reloc 0 conv_64 2"; fi
+	if [ $? = 0 ]; then OFLAGS="${OFLAGS} inplace_reloc 0 conv_64 2"; fi
 	echo ${OCOMP} ${file} ${OFLAGS}
 	LD_LIBRARY_PATH=${LD_LIBRARY_PATH} ${OCOMP} ${file} ${OFLAGS} || exit 1
 done
--- ocompiler-1.orig/tests/tests
+++ ocompiler-1/tests/tests
@@ -1,3 +1,3 @@
-
-/bin/bash ./compile && \
-/bin/bash ./c 1
+#!/bin/bash
+${RUN__SHELL} ./compile && \
+${RUN__SHELL} ./c 1
--- ocompiler-1.orig/versionscript
+++ ocompiler-1/versionscript
@@ -1,2 +1,2 @@
-
+#!/bin/sh
 echo char version=\"`cat ./debian/changelog | head -1 | grep -Poe "[^\(]*(?=\))"`\" > ./version.h
