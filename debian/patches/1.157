--- actionswf-1.orig/example/Makefile
+++ actionswf-1/example/Makefile
@@ -12,6 +12,10 @@ ifndef conv_64
 conv_64=0
 endif
 
+ifndef ffdec
+ffdec=ffdec
+endif
+
 name=example
 sfile=${name}.swf
 OFLAGS=conv_64 ${conv_64}
@@ -110,7 +114,7 @@ uninstall:
 
 expected.swf:
 	base64 -d expected.c.swf.txt > expected.c.swf
-	ffdec -decompress expected.c.swf $@
+	${ffdec} -decompress expected.c.swf $@
 test: all expected.swf
 	diff ${sfile} expected.swf && echo $$?
 expected.c.swf: build
--- actionswf-1.orig/example/rtest
+++ actionswf-1/example/rtest
@@ -1 +1,2 @@
-./mrd test
\ No newline at end of file
+. ~/games/ep/ffdec
+ffdec=${ffd} ./mrd test
--- actionswf-1.orig/src/actionparse.oc
+++ actionswf-1/src/actionparse.oc
@@ -593,7 +593,7 @@ function action_parse_loop(ss ac,ss p_op
 	ss end2
 	set end2 #globalp.operations_full
 	add end2 \globalp.operations_full-2
-	ss end=-1
+	sss end=-1
 	add end end2
     #
     whiletrue
