 const flag_format=0x80000                       #is not reached at .x or at alt
+const flag_splitter_n=0x100000
+const flag_splitter_r=0x200000
 
 const flags_pool=flagpre_pool_write|flag_pool_read
 const flags_x=flagpre_x|flag_x
@@ -33,3 +35,4 @@ const prexx_flags=prex_flags|flag_xx
 const antix_read=flagpre_log|flag_alt|flagpre_x
 const antixx_write=flag_titles                  #oad and ffdec are counting on this
 const flags_xx=flag_pool_read|flag_xx
+const flag_splitters=flag_splitter_n|flag_splitter_r
