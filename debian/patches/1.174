+			for tag, i1, i2, j1, j2 in matcher.get_opcodes():
+				if tag == "equal":
+					continue
+				print(tag)
+				print("old:", old[i1:i2])
+				print("new:", new[j1:j2])
+
+				i1 += offset
+				i2 += offset
+				if tag == "insert":
+					out[i1:i1] = new[j1:j2]
+					offset += (j2 - j1)
+					continue
+				if tag == "replace":
+					out[i1:i2] = new[j1:j2]
+					offset += (j2 - j1) - (i2 - i1)
+					continue
+				if tag == "delete":
+					del out[i1:i2]
+					offset -= (i2 - i1)
+					continue
