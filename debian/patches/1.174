+function translate_buttonmode(ss indents,ss oa)
+	ss cursor;set cursor spcfull(indents)
+	sd ?c
+	char against="useHandCursor="
+	set c strncmp(cursor,#against,14)
+	if c=0
+		set cursor# (Nullchar)
+		add cursor 14
+		ss pointer
+		sd ?len
+		set pointer globalt.a_page_switch
+		sd ?size;set size (a_page_size)
+		set len snprintf(pointer,size,"%sbuttonMode=%s%s%s",indents,cursor,against,cursor)
+		if len>0
+			if len<(a_page_size)
+				ss ok="ButtonMode"
+				whiletrue
+					if oa=(NULL)
+						break
+					end
+					if oa#=(Nullchar)
+						break
+					end
+					#here is not always wanted to be if there are no children inside, or if disabling the button
+					if oa#=(m_low) #is set once to make it look like a button
+						inc oa
+						add pointer len
+						sub size len
+						set len snprintf(pointer,size,"mouseChildren=false;")
+						if len<0
+							return indents
+						end
+						if len>=size
+							return indents
+						end
+					end
+					if oa#=(switch_char)
+						call translated(ok)
+						set cursor translate_two_switcher(oa)
+						if cursor!=oa
+							return cursor
+						end
+						return indents
+					end
+					break
+				end
+				call translated(ok)
+				return globalt.a_page_switch
+			end
+		end
+	end
+	return indents
+end
