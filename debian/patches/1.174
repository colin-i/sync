--- actionswf-1.orig/cln
+++ actionswf-1/cln
@@ -1,2 +1,6 @@
 
-cd example && make clean && cd .. && make clean && cd csrc && make clean && cd .. && cd oaas && make clean && cd .. && git status
+cd example && make clean && cd ../csrc && make clean && cd .. && make clean && \
+#if [ -n "${general}" ]; then
+#	cd tests/as3 && ./cf
+#fi &&
+git status
--- actionswf-1.orig/csrc/md
+++ actionswf-1/csrc/md
@@ -1,3 +1,3 @@
 
-if [ -z "${linkerflags}" ]; then linkerflags='-g -fsanitize=undefined'; fi
+if [ -z "${linkerflags}" ]; then linkerflags='-g -fsanitize=address'; fi
 make linkerflags="${linkerflags}" $@
--- actionswf-1.orig/csrc/mdo
+++ actionswf-1/csrc/mdo
@@ -1,3 +1,3 @@
 
-if [ -z "${linkerflags}" ]; then linkerflags='-g -fsanitize=undefined -O3 -march=native'; fi
