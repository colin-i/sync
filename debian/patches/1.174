--- actionswf-1.orig/oaas/Makefile
+++ actionswf-1/oaas/Makefile
@@ -11,7 +11,8 @@ ifndef OCONV
 OCONV=otoc
 endif
 ifndef linkerflags
-	linkerflags=-O3 -s
+	linkerflags=-O3 -flto=auto  -s
+	#unlike csrc or oad, flto here is not breaking, a clue is that libubsan is not erroring
 	ifeq ($(findstring mingw,$(CC)),)
 		linkerflags += -march=native
 	endif
@@ -45,7 +46,7 @@ firstname=liboaas
 libname=${firstname}.so
 libnamedll=${firstname}.dll
 
-objs_needing_headers=translate util
+objs_needing_headers=translate util solve
 objs_not_needing_headers=${platform}
 objs=${objs_needing_headers} ${objs_not_needing_headers}
 
@@ -78,7 +79,8 @@ ${libname}: ${objects} ${exte}
 #headers: this is not good because will trigger no timestamp rebuilds
 ../include/common.h:
 	$(MAKE) -C ../include common.h
-${obs_needing_headers}: ../include/common.h
+oaas.h: ../include/common.h
+${obs_needing_headers} main.o: oaas.h
 
 ${exte}: ${obs}
 	$(AR) cr ${exte} $^
@@ -88,9 +90,17 @@ ${exte}: ${obs}
 	${OCOMP} $< ${OFLAGS} include_sec 1
 	${OCONV} ${OCONVFLAGS} $<.x import
 	$(CC) ${model} -c -w -fPIC ${compilerflags} ${EXTRA_CFLAGS} $*.c
+%.h: %.ohi
+	${OCOMP} $< x_file 2 logfile 0 include_sec 1
+	${OCONV} $<.x
+%.ohi: %.oh
+	echo "format elfobj64" > $@
+	echo "orphan off" >> $@
+	cat $< >> $@
 
 clean:
 	$(MAKE) -C ../include clean
+	-rm -f oaas.h oaas.ohi.x
 	-rm -f main.oc.log main.oc.x main.c
 	-rm -f ${objects} ${exte} ${libname} ${libnamedll}
 	-rm -f ${obs} ${logs} ${xfiles} ${cfiles}
@@ -101,11 +111,11 @@ test:
 	echo "Nothing"
 
 install-lib:
-	install -D ${libname} $(DESTDIR)$(prefix)/lib/${libname}
+	install -D ${libname} $(DESTDIR)$(prefix)/lib${install_number}/${libname}
 
 install: all install-lib
 
 uninstall:
-	-rm -f $(DESTDIR)$(prefix)/lib/${libname}
+	-rm -f $(DESTDIR)$(prefix)/lib${install_number}/${libname}
 
 .PHONY: all install install-lib clean distclean uninstall test
--- actionswf-1.orig/oaas/main.oc
+++ actionswf-1/oaas/main.oc
@@ -1,11 +1,23 @@
 
 format elfobj64
 
+import "print_stdout" print_stdout
+^import "verbosep" verbosep
+
 ^import "translate_one" translate_one 2
 ^import "translate_two" translate_two 2
-
-import "print_stdout" print_stdout
 import "translated_ratio" translated_ratio
+^import "openfl" openfl #full
+import "_postpone_char" _postpone_char
+
+^import "solver1" solver1 1
+^import "solver2" solver2 1
+^import "solver4" solver4 1
+^import "solver7" solver7 2
+^import "solver" solver 2
+import "_resolve" _resolve
+
+einclude "oaas.h" "oaas.oh"
 
 functionx line(ss oa)
 	callret translate_one(oa,"")
@@ -24,8 +36,51 @@ functionx startline(ss start,ss oa)
 	callret translate_one(oa,start)
 end
 
-functionx ratio()
-	call print_stdout("Ratio: ")
-	call translated_ratio()
-	call print_stdout("\n")
+functionx ratio(ss ?print)
+	if print=(TRUE)
+		call print_stdout("Ratio: ")
+		call translated_ratio((TRUE))
+		call print_stdout("\n")
+	else
+		callret translated_ratio((FALSE))
+	end
+end
+
+functionx verbose(ss ?bol)
+	ss p;set p verbosep()
+	set p# bol
+end
+functionx flash_to_openfl(ss ?bol)
+	ss p;set p openfl()
+	set p# bol
+end
+functionx sep()
+	return (switch_char)
+end
+functionx postpone_char()
+	callret _postpone_char()
+end
+
+functionx solve1(ss value)
+	ss s
+	set s solver1(value)
+	callret solver(value,s)
+end
+functionx solve2(ss value)
+	ss s
+	set s solver2(value)
+	callret solver(value,s)
+end
+functionx solve4(ss value)
+	ss s
+	set s solver4(value)
+	callret solver(value,s)
+end
+functionx solve7(ss value,ss after)
+	ss s
+	set s solver7(value,after)
+	callret solver(value,s)
+end
+functionx resolve()
+	callret _resolve()
 end
--- actionswf-1.orig/oaas/md
