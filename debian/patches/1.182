--- actionswf-1.orig/tests/as3/otest
+++ actionswf-1/tests/as3/otest
@@ -5,7 +5,8 @@ cd ../..
 
 mkdir tmp
 
-items=$(make --no-print-directory -C oaas info)
+items=$(env -u MAKEFLAGS make --no-print-directory -C oaas info)
+#       env............S same like ../data
 
 for it in $items; do
 	ln oaas/$it.oc tmp
--- actionswf-1.orig/tests/data/otest
+++ actionswf-1/tests/data/otest
@@ -5,7 +5,11 @@ cd ../..
 
 mkdir tmp
 
-items=$(make --no-print-directory -C oad info)
+items=$(env -u MAKEFLAGS make --no-print-directory -C oad info)
+#       env............S required at launchpad deb wrappers to remove: make[2]: warning: ; and then: ln: failed to access 'oad/make[2]:.oc':
+#to test add a Makefile with .PHONY: t
+#                            t: ; ./otest
+#and run here: make t
 
 for it in $items; do
 	ln oad/$it.oc tmp
