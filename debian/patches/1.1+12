+package com.jpexs.decompiler.flash.configuration.enums;
+
+/**
+ * Grid snap accuracy.
+ * @author JPEXS
+ */
+public enum GridSnapAccuracy {
+    MUST_BE_CLOSE(5),
+    NORMAL(10),
+    CAN_BE_DISTANT(15),
+    ALWAYS_SNAP(Integer.MAX_VALUE);
+
+    private final int distance;
+
+    private GridSnapAccuracy(int value) {
+        this.distance = value;
+    }
+
+    public int getDistance() {
+        return distance;
+    }
+}
