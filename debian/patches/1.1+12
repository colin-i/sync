+    HANDLE CreateNamedPipe(String lpName, int dwOpenMode, int dwPipeMode, int nMaxInstances, int nOutBufferSize, int nInBufferSize, int nDefaultTimeOut,
+            WinBase.SECURITY_ATTRIBUTES lpSecurityAttributes);
+
