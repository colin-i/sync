+        if (getClass() != obj.getClass()) {
+            return false;
+        }
+        if (!super.equals(obj)) {
+            return false;
+        }
+        final SuperInterfaceMultinameUsage other = (SuperInterfaceMultinameUsage) obj;
+        if (this.classIndex != other.classIndex) {
+            return false;
+        }
+        return true;
+    }
+
