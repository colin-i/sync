+                        if (textSelectionText != null) {
+                            TextTag text = textSelectionText;
+                            int selStart = getSelectionStartInt();
+                            if (text != null && selStart > 0) {
+                                changeTextSelection(-1);
+                                text.removeCharacterGlyph(selStart - 1);
+                                fireTextChanged();                                
+                            }
+                        }
+                        return;
