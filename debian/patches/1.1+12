+        compressionComboBox.addItem(new ComboBoxItem<>("Zlib", SWFCompression.ZLIB));
+        compressionComboBox.addItem(new ComboBoxItem<>("LZMA", SWFCompression.LZMA));
+        compressionComboBox.addActionListener((ActionEvent e) -> {
+            validateHeader();
