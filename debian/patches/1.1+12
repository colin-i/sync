+                    if (e.getKeyChar() == KeyEvent.VK_DELETE) {
+                        if (textSelectionText != null) {
+                            TextTag text = textSelectionText;
+                            int selStart = getSelectionStartInt();
+                            if (text != null && selStart > -1) {
+                                text.removeCharacterGlyph(selStart);
+                                fireTextChanged();
+                            }
+                        }
+                        return;
+                    }
+
