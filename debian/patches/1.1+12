-    // MessageId: RPC_E_CANTTRANSMIT_CALL
-    //
-    // MessageText:
-    //
-    // The call was not transmitted properly; the message queue was full and was
-    // not emptied after yielding.
-    //
-    int RPC_E_CANTTRANSMIT_CALL = 0x8001000A;
