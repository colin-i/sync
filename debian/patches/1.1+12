     @Test
+    public void testJumpAfterFunctionFix() {
+        String res = decompilePcode("ConstantPool \"F\", \"A\", \"f\", \"B\", \"C\"\n"
+                + "DefineFunction \"f\", 0 {\n"
+                + "Push \"F\"\n"
