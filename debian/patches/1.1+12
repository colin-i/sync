+
+        public OSVERSIONINFOEX() {
+            szCSDVersion = new char[128];
+            dwOSVersionInfoSize = new DWORD(size()); // sizeof(OSVERSIONINFOEX)
+        }
+
+        public OSVERSIONINFOEX(Pointer memory) {
+            super(memory);
+            read();
+        }
+    }
