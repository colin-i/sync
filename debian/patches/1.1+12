+    // MessageId: TPM_E_DEACTIVATED
+    //
+    // MessageText:
+    //
+    // Activate the Trusted Platform Module (TPM).
+    //
+    int TPM_E_DEACTIVATED = 0x80280006;
+
+    //
+    // MessageId: TPM_E_DISABLED
+    //
+    // MessageText:
