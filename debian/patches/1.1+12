+
+    int SERVICE_INTERACTIVE_PROCESS = 0x00000100;
+
+    int SERVICE_TYPE_ALL = SERVICE_WIN32 | SERVICE_ADAPTER | SERVICE_DRIVER
+            | SERVICE_INTERACTIVE_PROCESS;
+
+    int STATUS_PENDING = 0x00000103;
