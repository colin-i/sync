+    private Integer getRulerFullLinePixels(double z) {
+        if (z < 0.0375) {
+            return null;
+        }
+
+        int fullLinePixels = 2000;
+
+        if (z >= 0.075) {
+            fullLinePixels = 1000;
+        }
+
+        if (z >= 0.15) {
+            fullLinePixels = 500;
+        }
+
+        if (z >= 0.31) {
+            fullLinePixels = 100;
+        }
+        if (z >= 0.6) {
+            fullLinePixels = 50;
+        }
+        if (z >= 1.5) {
+            fullLinePixels = 20;
+        }
+        if (z >= 2.99) {
+            fullLinePixels = 10;
+        }
+        if (z >= 5.95) {
+            fullLinePixels = 5;
+        }
+        if (z >= 14.64) {
+            fullLinePixels = 2;
+        }
+        return fullLinePixels;
+    }
+
