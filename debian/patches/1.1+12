-    private static final String ZZ_ATTRIBUTE_PACKED_0
-            = "\3\0\1\11\1\1\1\11\14\1\7\11\2\1\1\11"
-            + "\1\1\1\11\1\1\1\0\3\1\1\0\3\1\2\0"
-            + "\4\1\1\11\1\1\2\11\1\1\6\11\2\1\1\11"
-            + "\2\0\4\1\1\0\5\1\4\0\7\1\1\11\1\0"
-            + "\1\11\23\1\1\11\7\1";
