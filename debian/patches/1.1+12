+        }
+
+        public OSVERSIONINFO() {
+            szCSDVersion = new char[128];
+            dwOSVersionInfoSize = new DWORD(size()); // sizeof(OSVERSIONINFO)
+        }
+
+        public OSVERSIONINFO(Pointer memory) {
+            super(memory);
+            read();
+        }
+    }
