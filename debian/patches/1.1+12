-     * New Win32 exception from an error code, usually obtained from
-     * GetLastError.
-     *
-     * @param code Error code.
-     */
-    public Win32Exception(int code) {
-        this(W32Errors.HRESULT_FROM_WIN32(code));
-    }
-}
