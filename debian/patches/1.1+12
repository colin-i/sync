+    CDATA_OPEN,
+    CDATA,
+    CDATA_CLOSE,
+    CHARACTER,
+    ATTRIBUTE,
+    ATTRIBUTE_VALUE,
+    INSTR_CLOSE,
+    WHITESPACE,
+    EOF
+}
