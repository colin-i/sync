+ */
+public abstract class ChangeDoableOperation implements DoableOperation {
+
+    private final String itemIdentifier;
+
+    public ChangeDoableOperation(String itemIdentifier) {
+        this.itemIdentifier = itemIdentifier;        
+    }
+    
+
+    @Override
