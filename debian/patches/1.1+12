+                + "    <orderEntry type=\"sourceFolder\" forTests=\"false\" />\n"
+                + "  </component>\n"
+                + "</module>";
+        try (FileOutputStream fos = new FileOutputStream(new File(outDir, simpleName + ".iml"))) {
