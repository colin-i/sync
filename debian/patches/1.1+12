+        if (soundTag instanceof SoundStreamFrameRange) {
+            return importSoundStreamAtFrame(((SoundStreamFrameRange) soundTag).getHead(), is, newSoundFormat, ((SoundStreamFrameRange) soundTag).startFrame);
         }
         return false;
     }
 
