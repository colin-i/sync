-
-        int rc = Advapi32.INSTANCE.RegSetValueEx(hKey, name, 0, WinNT.REG_MULTI_SZ,
-                data.getByteArray(0, size), size);
-
-        if (rc != W32Errors.ERROR_SUCCESS) {
