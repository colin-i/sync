+            
+            if (Math.random() * 10 >= 5) {
+                sa += 100;
+            } else {
+                sa += 200;
+            }
+
+            private static const sc:int = Math.floor(Math.random() * 50) + sa + x;        	
+
+            private static var sb:int = sa + 20;
+            if (sb > 100) {
+                sb += 10;
+            } else {
+                sb += 20;
+            }
+
+            private static var sv:int;
+
+            for each (sv in [1,3,5])
+            {
+                trace(sv);
+            }
+                      
+            public function test() : void {
+                const x:int = 5;
+                
+                var th:TestHello = new TestHello();
+            }
+	}    
+}
