+        if (rc != W32Errors.ERROR_SUCCESS) {
+            throw new Win32Exception(rc);
+        }
+        try {
+            registrySetStringArray(phkKey.getValue(), name, arr);
+        } finally {
+            rc = Advapi32.INSTANCE.RegCloseKey(phkKey.getValue());
