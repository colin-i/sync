+                + "   public class TestStaticVars\n"
+                + "   {\n"
+                + "      public static var sa:int = 1001;\n"
+                + "      \n"
+                + "      public static var sb:int = 1002;\n"
+                + "      \n"
+                + "      public var b:int;\n"
+                + "      \n"
+                + "      public var a:int;\n"
+                + "      \n"
+                + "      public function TestStaticVars(param1:int, param2:int)\n"
+                + "      {\n"
+                + "         a = param1;\n"
+                + "         b = param2;\n"
+                + "      }\n"
+                + "   }\n"
+                + "}\n"
+        );
+    }
