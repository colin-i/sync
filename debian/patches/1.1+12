-/**
- * Advapi32 utility API.
- *
- * @author dblock[at]dblock.org
- */
-public abstract class Advapi32Util {
-
-    /**
-     * An account.
-     */
-    public static class Account {
-
-        /**
-         * Account name.
-         */
-        public String name;
-
-        /**
-         * Account domain.
