+    public boolean fIcon;
+
+    public DWORD xHotspot;
+
+    public DWORD yHotspot;
+
+    public HBITMAP hbmMask;
+
+    public HBITMAP hbmColor;
+
+    @Override
+    protected List getFieldOrder() {
+        return Arrays.asList("fIcon", "xHotspot", "yHotspot", "hbmMask", "hbmColor");
+    }
+}
