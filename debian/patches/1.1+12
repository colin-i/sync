-     */
-    public boolean LookupPrivilegeName(
-            String lpSystemName,
-            WinNT.LUID lpLuid,
-            char[] lpName,
-            IntByReference cchName);
-
-    /**
-     * The LookupPrivilegeValue function retrieves the locally unique identifier
-     * (LUID) used on a specified system to locally represent the specified
