-        if (obj == null) {
-            return false;
-        }
-        if (getClass() != obj.getClass()) {
-            return false;
-        }
-        if (!super.equals(obj)) {
-            return false;
-        }
-        final ClassNameMultinameUsage other = (ClassNameMultinameUsage) obj;
-        if (this.classIndex != other.classIndex) {
-            return false;
-        }
-        return true;
-    }
-
