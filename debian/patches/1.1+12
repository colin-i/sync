+package com.jpexs.decompiler.flash.gui.jna.platform.win32;
+
+import com.jpexs.decompiler.flash.gui.jna.platform.win32.WinDef.DWORD;
+import com.jpexs.decompiler.flash.gui.jna.platform.win32.WinDef.HBITMAP;
