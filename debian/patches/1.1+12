     public long line;
+    
+    /**
+     * Position in the code where the exception occurred. -1 where unknown
+     */
+    public long position = -1;
 
+    /**
+     * Text of the exception.
+     */
     public String text;
 
+    /**
+     * Constructs a new parse exception.
+     *
