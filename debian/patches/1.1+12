+    HANDLE CreateFile(String lpFileName, int dwDesiredAccess, int dwShareMode,
+            WinBase.SECURITY_ATTRIBUTES lpSecurityAttributes, int dwCreationDisposition,
+            int dwFlagsAndAttributes, HANDLE hTemplateFile);
+}
