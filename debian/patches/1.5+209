--- ocompiler-1.orig/otoc/loop.oc
+++ ocompiler-1/otoc/loop.oc
@@ -116,6 +116,7 @@ function loop(sd pointer,sd delim,sd out
 		value *Xfile_interrupt^interrupt
 		value *Xfile_line^line
 		value *Xfile_iend^iend
+		value *Xfile_proto^proto
 		mult command :
 		sv dest^Xfile_comment;add dest command
 		set dest dest#
@@ -476,13 +477,7 @@ function import(sd outfile,sv pbuffer)
 	charx imp#1;call get_char(pbuffer,#imp)
 	datax sz#1;valuex name#1
 	call get_string(pbuffer,#sz,#name)
-	datax sza#1;valuex alias#1
-	call get_string(pbuffer,#sza,#alias)
-
-	call write_long(outfile,alias,sza)
-	char a="()"^
-	call write(outfile,#a,2)
-	callg writetn(outfile)
+	callg proto(outfile,pbuffer)
 end
 function aftercall(sd outfile,sv pbuffer)
 	call backindent(outfile)
@@ -520,6 +515,14 @@ function interrupt(sd outfile)
 	#"__builtin_trap();" #this is not continuing on x86 but is an temporary solution
 	callg writen(outfile,#a,\.a)
 end
+function proto(sd outfile,sv pbuffer)
+	datax sz#1;valuex name#1
+	call get_string(pbuffer,#sz,#name)
+	call write_long(outfile,name,sz)
+	char a="()"^
+	call write(outfile,#a,2)
+	callg writetn(outfile)
+end
 
 function else_core(sd outfile)
 	char a="else"^
--- ocompiler-1.orig/src/files/functions/argument/argument.oc
+++ ocompiler-1/src/files/functions/argument/argument.oc
@@ -279,7 +279,12 @@ function argument_init(sv ptrcontent,sd
 			call advancecursors(ptrcontent,ptrsize,ptrsize#)
 			return (noerror)
 		endif
-	endif
+	else
+		setcall err xfile_recursive()
+		if err!=(noerror)
+			return err
+		endif
+	endelse
 	setcall err getarg(ptrcontent,ptrsize,ptrsize#,(allow_later),(FORWARD)) #there are 3 more arguments but are not used
 	return err
 endfunction
--- ocompiler-1.orig/src/files/functions/commons/base.oc
+++ ocompiler-1/src/files/functions/commons/base.oc
@@ -47,9 +47,6 @@ Function getcontplusReg(data ptrstrucutr
 	add ptrcontainer# r
 EndFunction
 
-Data innerfunction#1
-Const globalinnerfunction^innerfunction
-
 #pdata
 Function getstructcont(data typenumber)
 #structcont is not same as cont, it's easy to rename
--- ocompiler-1.orig/src/files/functions/global/end.oc
+++ ocompiler-1/src/files/functions/global/end.oc
@@ -9,6 +9,7 @@ function endfunction(sd parses)
 		endif
 		Set main.innerfunction (FALSE)
 		call vars_log_reset() #to let next variables be "o.var"
+		set main.innerfunctionreturn (FALSE)
 	elseif parses=(pass_write)
 		sd err
 		setcall err xfile_add_end_if()
--- ocompiler-1.orig/src/files/functions/xfile_details.oc
+++ ocompiler-1/src/files/functions/xfile_details.oc
@@ -420,3 +420,35 @@ function xfile_add_override_if(sd name,s
 	endif
 	return (noerror)
 endfunction
+
+#err
+function xfile_recursive()
+	if main.xfile!=(openno)
+		if main.innerfunctionreturn=(FALSE)
+			#can add at pass_init on top of all
+			sv ptrfunctions%%ptr_functions
+			sd fns
+			call getcont(ptrfunctions,#fns)
+			sd pos;set pos 0
+			whiletrue
+				sd ibit;setcall ibit importbit(fns)
+				if ibit=0
+					if pos=main.functionTagIndex
+						break
+					endif
+					inc pos
+				endif
+				add fns (nameoffset)
+				addcall fns strlen(fns)
+				inc fns
+			endwhile
+			sd size
+			add fns (nameoffset)
+			setcall size strlen(fns)
+			sd err;setcall err xfile_add_base((Xfile_proto),fns,size)
+			set main.innerfunctionreturn (TRUE)
+			return err
+		endif
+	endif
+	return (noerror)
+endfunction
