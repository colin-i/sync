-	rm -r ${v} ${folder}
+	set -e #at alternative there are return 1 and !=0 grep returns
+	mv ${v} "${bname}" "${bname}".orig
+	cd "${at_start}"
+	${2} || {
+		cd "${dname}"
+		if [ ! -e "${bname}" ]; then
+			mv ${v} "${bname}".orig "${bname}"
+		fi
+		exit 1
+	}
+	cd "${dname}"
+	diff "${bname}" "${bname}".orig
+	if [ -n "${scripts}" ]; then
+		mover "${out}"/* "${scripts}"
+	fi
+	if [ -z "${no_clean}" ]; then
+		rm -r ${v} "${out}"  #or rmdir if -n scripts
+		rm -r ${v} "${folder}"
+		rm "${bname}".orig
+	fi
 fi
