+function f_size(sd path)
+	vstr rb="rb"
+	sd f;set f fopen(path,rb)
+	if f!=(NULL)
+		call fseek(f,0,(SEEK_END))
+		sd size
+		set size ftell(f)
+		call fclose(f)
+		if size!=-1
+			return size
+		end
+	end
+	vstr er="f_size error"
+	callg error(er)
+end
+function f_size_errors(sd path)
+	sd f;set f fopen(path,f_size.rb)
+	if f!=(NULL)
+		call fseek(f,0,(SEEK_END))
+		sd size
+		set size ftell(f)
+		call fclose(f)
+		if size!=-1
+			return size
+		end
+	end
+	call free(f)
+	callg error(f_size.er)
+end
