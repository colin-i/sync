--- actionswf-1.orig/Makefile
+++ actionswf-1/Makefile
@@ -29,8 +29,8 @@ test:
 	conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./as && conv_64=${conv_64} $${RUN__SHELL} ./c 1 && \
 	$${RUN__SHELL} ./apy && conv_64=${conv_64} $${RUN__SHELL} ./c 1 && \
 	cd ffdec && conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./as && \
-	cd ../data && conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./test x && \
-	cd ../as3 && conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./as && \
+	cd ../data && conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./test x && conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./otest && \
+	cd ../as3 && conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./as && conv_64=${conv_64} RUN__SHELL="$${RUN__SHELL}" $${RUN__SHELL} ./otest && \
 	echo tests ok
 clean:
 	RUN__SHELL=$(SHELL) . ./shl && cd csrc && make clean && cd ../tests && \
--- actionswf-1.orig/cln
+++ actionswf-1/cln
@@ -3,4 +3,20 @@ cd example && make clean && cd ../csrc &
 #if [ -n "${general}" ]; then
 #	cd tests/as3 && ./cf
 #fi &&
-git status
+~/test/git/sts
+
+#trace(1,2) is error, use this.trace only
+#breakpoint at web? add opcode (trace opcode, change .x or change .as file), rebuild, restart. or find a solution to change avm1.output_json_code at runtime
+#a=eval('b').length;
+
+#is
+#"a=1; //dsfdsffsd
+#b=2"
+
+#isn't
+#"a=function(){}+1"
+#"new Array()"
+#"a"
+
+#part isn't
+#a=a[3[2]]
--- actionswf-1.orig/csrc/Makefile
+++ actionswf-1/csrc/Makefile
@@ -60,15 +60,17 @@ all: headers ${proj}
 ${proj}: ${exte} ${eobs}
 	${OLINK} ${logs}
 	$(CC) ${model} ${linkerflags} -shared ${eobs} -o $@ `pkg-config --libs zlib` -L. -l:${exte} -Wl,--exclude-libs=${exte}
+# | headers
 ${exte}: ${obs}
 	$(AR) cr ${exte} $^
+# | headers
 # -e DllMain
 
 headers:
 	$(MAKE) -C ../include
 	$(MAKE) -C ../dev flags.h action_swf.h
 
-%.o: ${backsrc}%.oc
+%.o: ${backsrc}%.oc | headers
 	${OCOMP} $< ${OFLAGS} include_sec 1
 	${OCONV} ${OCONVFLAGS} $<.x import
 	$(CC) ${model} -c -w -fPIC ${compilerflags} ${EXTRA_CFLAGS} ${backsrc}$*.c -o $@
--- actionswf-1.orig/csrc/md
+++ actionswf-1/csrc/md
@@ -1,3 +1,3 @@
 
 if [ -z "${linkerflags}" ]; then linkerflags='-g -fsanitize=address'; fi
-make linkerflags="${linkerflags}" $@
+make linkerflags="${linkerflags}" -j4 $@
