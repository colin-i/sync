+	<tr><td class="blue" colspan=2 rowspan=2>v <span class="green">or</span> V</td>       <td class="com">var <span class="blue">name</span>=new <span class="blue">class</span>(<span class="blue">a</span>,<span class="blue">10</span>,<span class="blue">True</span>);<span class="green">[[</span><span class="blue">parent/stage.</span><span class="green">]</span>addChild(<span class="blue">name</span>);<span class="green">]</span></td><td class="com"><span class="green">[</span><span class="blue">parent.</span><span class="green">]</span>attachMovie(<span class="yellow">'</span><span class="blue">class</span><span class="yellow">'</span>,<span class="yellow">'</span><span class="blue">name</span><span class="yellow">'</span>,getNextHighestDepth())<span class="yellow">;</span>...name.a<span class="yellow">=</span><span class="blue">a</span><span class="yellow">;</span>...name.b<span class="yellow">=</span><span class="blue">10</span><span class="yellow">;</span>...name.c<span class="yellow">=</span><span class="blue">True</span><span class="yellow">;</span></td></tr>
+	<tr>                                                                                  <td class="com">var <span class="blue">name</span>=new flash.display.DisplayObjectContainer();...</td><td class="com">...createEmptyMovieClip(<span class="yellow">'</span><span class="blue">name</span><span class="yellow">'</span>,getNextHighestDepth());</td></tr>
+	<tr><td class="blue">v <span class="green">or</span> V</td><td class="red">class</td> <td class="com">var <span class="blue">name</span>=new <span class="red">class</span>();...</td><td class="com">...</td></tr>
 	<tr><td class="blue" colspan=2>w <span class="green">or</span> W</td>                 <td class="com">...</td><td class="com">...</td></tr>
-	<tr><td class="blue">w<span class="green">or</span>W</td><td class="red">name</td>    <td class="com">...<span class="red">name</span>.name=<span class="red">name</span><span class="blue">+extra+1</span>;</td><td class="com">...<span class="blue">+extra+1</span><span class="yellow">,</span>...</td></tr>
-	<tr><td colspan=2>x</td>             <td class="com">static</td></tr>
-	<tr><td class="blue">z</td>          <td class="red"><table><tr><td>p1</td><td>p2</td></tr></table></td><td class="com"><span class="blue">var a=new <span class="red">p1</span><span class="red">p2</span>();</span></td><td class="com"><span class="blue">var a=new <span class="red">p2</span>();</span></td></tr>
+	<tr><td class="blue">w <span class="green">or</span> W</td><td class="red">class</td> <td class="com">...<span class="blue">name</span>.name=<span class="blue">name</span><span class="blue">+extra+1</span>;</td><td class="com">...<span class="blue">+extra+1</span><span class="yellow">,</span>...</td></tr>
+	<tr><td class="blue" colspan=2>x</td><td class="com">static <span class="blue">...</span></td></tr>
+	<tr><td class="blue">z</td>          <td class="red"><table><tr><td>p1</td><td>p2</td></tr></table></td><td class="com"><span class="blue">var a=new <span class="red">p1p2</span>();</span><span class="red">p1p2</span></td><td class="com"><span class="blue">var a=new <span class="red">p2</span>();</span><span class="red">p2</span></td></tr>
 </table>
 Other recognized notations:
 <table>
-	<tr><td>}</td></tr>
+	<tr><td>});</td><td class="com">at least one. they will be appended.</td></tr>
 </table>
-<p>At solver. 'V' or 'W' decision is based on ', '.</p>
+<p>At solver. 'V' or 'W' decision is based on ' ,'.</p>
 </body>
 </html>
--- actionswf-1.orig/oaas/Makefile
+++ actionswf-1/oaas/Makefile
@@ -13,7 +13,7 @@ endif
