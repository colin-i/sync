+#!/bin/bash
+set -e
+a=`pwd`
+cd ../..
+
+mkdir tmp
+
+items=$(make --no-print-directory -C oad info)
+
+for it in $items; do
+	ln oad/$it.oc tmp
+done
+ln oad/main.oc tmp
+ln oad/Makefile tmp
+ln oad/cflags tmp
+ln oad/items tmp
+ln oad/common.oh tmp
+ln oad/oadbgdata.oh tmp
+ln oad/oadbgdatas.oh tmp
+ln oad/safe.oh tmp
+
+cd tmp
+ldprefer=1 linkerflags=' ' OFLAGSEXTRA='nul_res_pref 1 x_file 1' make -j4
+cd $a
+ldextra=/../tmp ./test
+rm -r ../../tmp
--- actionswf-1.orig/tests/data/test
+++ actionswf-1/tests/data/test
@@ -16,15 +16,20 @@ if [ "${platform}" = "win" ]; then
 fi
 
 if [ ! -e ${etest} ]; then
-	${RUN__SHELL} ./a${what_a} ${g} || exit 1
+	${RUN__SHELL} ./a${what_a} "${g}" || exit 1
 	if [ -n "${rd}" ]; then
 		read -t $((60*60*24))
 	fi
 fi
 
-{ ${RUN__SHELL} ./a${what_a} ${g} ; echo $? > ./test.status ; } | tee data.txt
-status=`cat ./test.status`; rm ./test.status
-if [ ${status} != 0 ]; then  exit 1; fi          #set -o pipefail && a | tee || exit
+if [ -z "$g" ]; then
+	{ ${RUN__SHELL} ./a${what_a} "${g}" ; echo $? > ./test.status ; } | tee data.txt
+	status=`cat ./test.status`; rm ./test.status
+	if [ ${status} != 0 ]; then  exit 1; fi          #set -o pipefail && a | tee || exit
+else
+	${RUN__SHELL} ./a${what_a} "${g}"
+	exit 1
+fi
 
 at_folder=../ . ../integ && {
 	if [ "${platform}" = "win" ]; then
--- /dev/null
+++ actionswf-1/tests/data/testc
