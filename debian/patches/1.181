@@ -0,0 +1,22 @@
+#!/bin/bash
+set -e
+a=`pwd`
+cd ../..
+
+mkdir tmp
+
+items=$(make --no-print-directory -C oaas info)
+
+for it in $items; do
+	ln oaas/$it.oc tmp
+done
+ln oaas/main.oc tmp
+ln oaas/Makefile tmp
+ln oaas/oaas.oh tmp
+ln oaas/translate.oh tmp
+
+cd tmp
+ldprefer=1 linkerflags=' ' OFLAGS='nul_res_pref 1 x_file 1' make -j4
+cd $a
+OAPATH=../../tmp ./as
+rm -r ../../tmp
--- actionswf-1.orig/tests/data/a
+++ actionswf-1/tests/data/a
@@ -8,7 +8,8 @@ if [ -n "${1}" ]; then
 	else
 		gdb=gdb
 	fi
-	g="${gdb} -ex start --args"
+	g="${gdb} -ex start"
+	args=--args
 fi
 if [ -z "${OCOMP}" ]; then OCOMP=o; fi
 if [ -z "${OCONV}" ]; then OCONV=otoc; fi
@@ -25,15 +26,21 @@ if [ "${platform}" = "win" ]; then
 	OCONVFLAGS=-
 else
 	ext=out
-	export LD_LIBRARY_PATH=../../oad
+	export LD_LIBRARY_PATH=../../oad${ldextra}
 fi
 if [ -z "${f}" ]; then
 	f=../../example/example.swf
 fi
+if [ -z "${x_file}" ]; then x_file=2; fi
 if [ -n "${asan}" ]; then ldpreload=$(gcc -print-file-name=libasan.so); fi
 if [ -n "${ubsan}" ]; then ldpreload=${ldpreload}:$(gcc -print-file-name=libubsan.so); fi
-${launcher} ${OCOMP} a.oc x_file 2 logfile 0 && \
-${launcher64} ${OCONV} ${OCONVFLAGS} a.oc.x && \
-${CC} ${model} ${CFLAGS} -g a.c -L../../oad -loadbgdata `if [ -n "${asan}" ]; then echo -n '-lasan'; fi` `if [ -n "${ubsan}" ]; then echo -n '-lubsan'; fi` && \
-LD_PRELOAD="${ldpreload}" ${exelauncher} ${g} ./a.${ext} ${f} || { echo a.out error; exit 1; }
+${launcher} ${OCOMP} a.oc x_file ${x_file} logfile 0 && \
+if [ -z "${ldprefer}" ]; then
+	${launcher64} ${OCONV} ${OCONVFLAGS} a.oc.x && \
+	${CC} ${model} ${CFLAGS} -g a.c -L../../oad${ldextra} -loadbgdata `if [ -n "${asan}" ]; then echo -n '-lasan'; fi` `if [ -n "${ubsan}" ]; then echo -n '-lubsan'; fi`
+else
+	${LD} --dynamic-linker=/lib64/ld-linux-x86-64.so.2 a.o -entry main -L../../oad${ldextra} -loadbgdata -lc
+fi && \
+eval LD_PRELOAD="${ldpreload}" ${exelauncher} ${g} ${1} ${args} ./a.${ext} ${f} || { echo a.out error; exit 1; }
