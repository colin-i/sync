+
+#one
+Const Atsymbol=0x40
 Const c_low=0x63
 Const d_low=0x64
-Const f_low=0x66
 Const g_low=0x67
-Const h_low=0x68
 Const i_low=0x69
-Const j_low=0x6A
-Const m_low=0x6D
-Const v_low=0x76
-Const w_low=0x77
+Const p_low=0x70
+
+#util
+Const Dollar=0x24
+
+#main translate util
+const switch_char=Plus
+
+#translate one
+const a_page_size=0x1000
 const func_char=f_low
 const nvar_char=w_low
 const var_char=v_low
 
+#translate one solve
+const arrconstr_char=u_low
+
 #translate solve
-Const Dollar=0x24
-Const e_low=0x65
-Const k_low=0x6B
-Const n_low=0x6E
-Const o_low=0x6F
-Const p_low=0x70
-Const r_low=0x72
-Const t_low=0x74
-const align_char=j_low
+Const m_low=0x6D
 const alpha_char=h_low
-const arrconstr_char=a_low
+const align_char=j_low
+const arracc_char=d_low
 const bitmap_char=m_low
+const childcast_char=i_low
 const compare_char=k_low
 const evfunc_char=e_low
 const fill_char=l_low
