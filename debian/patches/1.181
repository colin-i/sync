-	# -flto=auto #that is not valid at jammy
+	# -flto=auto #that is not valid at jammy or since functions like var_advance
 	ifeq ($(findstring mingw,$(CC)),)
 		linkerflags += -march=native
 	endif
@@ -30,6 +30,9 @@ endif
