+			set rem cursor#
+			set cursor# (Nullchar)
+			inc cursor
+			set pointer# (Nullchar)
+			inc pointer
+			sd ?len
+			set len snprintf(globalt.a_page_switch,(a_page_size),"%scast(%c%s,flash.display.DisplayObjectContainer).%s",indents,rem,cursor,pointer)
