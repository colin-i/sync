--- /dev/null
+++ actionswf-1/oaas/mdo
@@ -0,0 +1,2 @@
+
+linkerflags='-g -fsanitize=undefined -O3 -march=native' make
--- actionswf-1.orig/oaas/translate.oc
+++ actionswf-1/oaas/translate.oc
@@ -849,6 +849,7 @@ function translate_search_base(ss start,
 	set t 2
 	and t ptypes#
 	if t!=0
+		set pointer start
 		if cursor!=start
 			set pointer strdup(start) #else will be a collision
 		end
@@ -865,6 +866,7 @@ function translate_search_base(ss start,
 	set t 4
 	and t ptypes#
 	if t!=0
+		set pointer start
 		if cursor!=start
 			set pointer strdup(start)
 		end
--- actionswf-1.orig/tests/as
+++ actionswf-1/tests/as
@@ -1,3 +1,3 @@
 #!/bin/sh
 if [ -z "${LD_LIBRARY_PATH}" ]; then LD_LIBRARY_PATH=../${inter}src; fi
-${RUN__SHELL} ./${inter}asv && LD_LIBRARY_PATH=${LD_LIBRARY_PATH} ./a.out x
+${RUN__SHELL} ./${inter}asv && LD_LIBRARY_PATH=${LD_LIBRARY_PATH} ${launcher} ./a.out x
--- actionswf-1.orig/tests/asv
+++ actionswf-1/tests/asv
@@ -20,14 +20,14 @@ o a${interext}.oc logfile 0 conv_64 ${co
 		if [ -z "${LD_LIBRARY_PATH}" ]; then
 			#local cc has -lz? bionic i386 cc has no -lz? who cares
 			echo cc a${interext}.o ${l_z} -L${_L}../${inter}src -lactionswf
-			cc a${interext}.o ${l_z} -L${_L}../${inter}src -lactionswf
+			cc a${interext}.o -L${_L}../${inter}src -lactionswf ${l_z}
 		else
 			echo cc a.o ${l_z} -L${LD_LIBRARY_PATH} -lactionswf
 			cc a.o ${l_z} -L${LD_LIBRARY_PATH} -lactionswf
 		fi
 	fi && {
 		if [ -z "${LD_LIBRARY_PATH}" ]; then LD_LIBRARY_PATH=${_L}../${inter}src; fi
-		echo LD_LIBRARY_PATH=${LD_LIBRARY_PATH} ./a.out ${extra}
-		LD_LIBRARY_PATH=${LD_LIBRARY_PATH} ./a.out ${extra}
+		echo LD_LIBRARY_PATH=${LD_LIBRARY_PATH} ${launcher} ./a.out ${extra}
+		LD_LIBRARY_PATH=${LD_LIBRARY_PATH} ${launcher} ./a.out ${extra}
 	}
 }
