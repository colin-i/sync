--- actionswf-1.orig/tests/as3/otest
+++ actionswf-1/tests/as3/otest
@@ -19,5 +19,5 @@ ln oaas/translate.oh tmp
 cd tmp
 ldprefer=1 linkerflags=' ' OFLAGS='nul_res_pref 1 x_file 1' make -j4
 cd $a
-OAPATH=../../tmp ./as
+OAPATH=../../tmp ${RUN__SHELL} ./as
 rm -r ../../tmp
--- actionswf-1.orig/tests/data/otest
+++ actionswf-1/tests/data/otest
@@ -26,5 +26,5 @@ ln oad/safe.oh tmp
 cd tmp
 ldprefer=1 linkerflags=' ' OFLAGSEXTRA='nul_res_pref 1 x_file 1' make -j4
 cd $a
-ldextra=/../tmp ./test
+ldextra=/../tmp ${RUN__SHELL} ./test
 rm -r ../../tmp
