--- actionswf-1.orig/.github/workflows/deb.yml
+++ actionswf-1/.github/workflows/deb.yml
@@ -4,7 +4,7 @@ on:
 
 jobs:
  dbuild:
-  runs-on: ubuntu-18.04
+  runs-on: ubuntu-22.04
   steps:
    - uses: actions/checkout@v3
      with:
--- actionswf-1.orig/.github/workflows/upgenactionswf.yml
+++ actionswf-1/.github/workflows/upgenactionswf.yml
@@ -4,7 +4,7 @@ on:
 
 jobs:
  ubuildgen:
-  runs-on: ubuntu-18.04 #latest is ok but it must be downloaded first
+  runs-on: ubuntu-22.04 #latest is ok but it must be downloaded first
   steps:
    - name: Run a multi-line script
      run: |
--- actionswf-1.orig/oad/Makefile
+++ actionswf-1/oad/Makefile
@@ -65,7 +65,7 @@ ${libname}: main.o ${exte}
 
 %.o: %.oc
 	${OCOMP} $< ${OFLAGS}
-	${OCONV} $<.x
+	${OCONV} $<.x import
 	$(CC) ${model} -c -w -fPIC ${compilerflags} ${EXTRA_CFLAGS} $*.c
 #-Wno are a must at pkgbuild
 #-fPIC since launchpad bionic build
--- actionswf-1.orig/oad/cflags
+++ actionswf-1/oad/cflags
@@ -1,2 +1,2 @@
 
-EXTRA_CFLAGS=-Wno-int-conversion -Wno-incompatible-pointer-types
+EXTRA_CFLAGS=-Wno-int-conversion -Wno-incompatible-pointer-types -Wno-implicit-function-declaration
--- actionswf-1.orig/oad/string.oc
+++ actionswf-1/oad/string.oc
@@ -96,7 +96,7 @@ function indent()
 end
 
 importx "fputs" fputs
-importx "stdout" stdout
+^importx "stdout" stdout
 importx "fputc" fputc
 
 function printn(sv s)
@@ -165,7 +165,7 @@ function print_text(ss a,valueu c)
 	end
 end
 
-importx "stderr" stderr
+^importx "stderr" stderr
 function printe(ss er)
 	sv se^stderr
 	set se se#
