+function variadic_wrap(sd outfile,ss name,sd sz,ss fnname,sd fnsz)
+	char va_list="va_list "^
+	call write(outfile,#va_list,\.va_list)
+	call write(outfile,name,sz)
+	call writet(outfile)
+	call write(outfile,fnname,fnsz)
+	call writel(outfile)
+end
