--- ocompiler-2.orig/Makefile
+++ ocompiler-2/Makefile
@@ -3,13 +3,16 @@ TOPTARGETS := install-proj clean distcle
 
 #NOOCONV ? is at debian/ocompiler.install , will install here but not in the final deb
 
-#this at pkgbuild, must set because is not found dpkg-architecture, and that is making ifeq i386 not same as ifneq amd64
-ifeq ($(shell dpkg-architecture -qDEB_HOST_ARCH), i386)
-conv_64=1
+#                                                             || arch/fedora/suse
+ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH 2>/dev/null || uname -m)
+ARCH := $(patsubst i586,i386,$(ARCH))
+
+ifeq ($(ARCH),i386)
+	conv_64=1
 else
-ifndef conv_64
-conv_64=0
-endif
+	ifndef conv_64
+		conv_64=0
+	endif
 endif
 
 ifeq ($(conv_64),1)
--- ocompiler-2.orig/localtest
+++ ocompiler-2/localtest
@@ -1 +1 @@
-2-5+248
+2-5+249
--- ocompiler-2.orig/o.html
+++ ocompiler-2/o.html
@@ -982,7 +982,7 @@ format elfobj64<br>
 <p>First long(4 bytes) is null or offset of entry which will be at the end.</p>
 <p>Xfile_noignore at ocompiler is '^' sign before the command, and at otoc will noignore a tagIgnore argument.
 Xfile_yesignore at compiler is '!' sign before the command and at otoc will ignore the command.
-Xfile_variadic at ocompiler is '%' sign at start, followed by '&lt;argument' for va_start at otoc, '|variable' for va_arg, '&gt;' for va_end.
+Xfile_variadic at ocompiler is '%' sign at start, followed by '&lt;argument' for va_start at otoc, '&variable' for va_copy, '|variable' for va_arg, '&gt;' for va_end. <i>va_copy</i> will also replace 'the_va_list' with <i>variable</i> until <i>va_end</i>.
 </p>
 <p>Another option specific to otoc is Xfile_c_volatile, to use stack variables at o for recursion but not pointers at c (example: sdu ?attr). And Xfile_c_variadic to work with va_list arguments.</p>
 <table id="selection_table">
@@ -1069,9 +1069,10 @@ Xfile_variadic at ocompiler is '%' sign
 	<tr><td>Xfile_iend</td></tr>
 </table>
 <table id="selection_table">
-	<tr><td rowspan=3>Xfile_variadic</td><td>Xfile_variadic_begin</td>        <td class="red" rowspan=2>var</td></tr>
+	<tr><td rowspan=4>Xfile_variadic</td><td>Xfile_variadic_begin</td>        <td class="red" rowspan=3>var</td></tr>
+	<tr>                                 <td>Xfile_variadic_copy</td></tr>
 	<tr>                                 <td>Xfile_variadic_get</td></tr>
-	<tr>                                 <td colspan=2>Xfile_variadic_end</td></tr>
+	<tr>                                 <td rowspan=2>Xfile_variadic_end</td></tr>
 </table>
 <table id="selection_table">
 	<tr><td>Xfile_noignore</td></tr>
--- ocompiler-2.orig/otoc/Makefile
+++ ocompiler-2/otoc/Makefile
@@ -26,6 +26,8 @@ FULLOBJLOG = ${FULLOBJS}.log
 number=number.oh
 tags=tags.oh
 
+ver=version.oh
+vers=../${ver}
 
 ifneq (${platform},win)
 
@@ -70,7 +72,7 @@ endif
 %.oh: %.pre
 	${launcher} ./$<
 
-${OBJ}: ${FULLOBJS} ${tags} ${number}
+${OBJ}: ${FULLOBJS} ${tags} ${number} ${vers}
 	${OCOMP} $< ${OFLAGS}
 ${fullprog}: ${OBJ}
 	${OLINK} ${FULLOBJLOG}
@@ -80,6 +82,9 @@ ${fullprog}: ${OBJ}
 		${ATLDCOM} ${prog} ${FULLOBJO} ${AFTERLDCOM}; \
 	fi
 
+${vers}:
+	cd .. && $(MAKE) -f ./Makefile ${ver}
+
 install:
 	$(MAKE) all
 	$(MAKE) install-proj
@@ -89,9 +94,7 @@ install-proj:
 #is at debian/ocompiler.install , will install here but not in the final deb
 
 clean:
-	-rm -f ${FULLOBJO}
-	-rm -f ${FULLOBJLOG}
-	-rm -f ${fullprog}
+	-rm -f ${FULLOBJO} ${FULLOBJLOG} ${fullprog} ${vers}
 	-rm -f ${number} number.pre number.pre.o number.pre.oc.log
 	-rm -f ${tags} tags.pre tags.pre.o tags.pre.oc.log
 distclean: clean
