--- ocompiler-2.orig/tests/a.out.oc
+++ ocompiler-2/tests/a.out.oc
@@ -35,6 +35,10 @@ function intern(data a,sd b,sv c,svu d,s
 	decst c
 	neg c
 	not recursion
+	%|pointing
+	%&test
+	%|pointing
+	%>
 	!value the_jmp_buf#1
 	base the_jmp_buf
 	leave the_jmp_buf
@@ -52,10 +56,13 @@ functionv f(sd dummy) #void f(...) was w
 	!sd the_va_list^dummy
 	valuex a#1
 	value b=\main.c2
+	%|a
+	%&test
 	call intern(1,"0\n1\r2\t3\04\\5\"6\x3g\x307",main.a:a,main.a,the_va_list)
 	%|a
 	set a #b
 	%>
+	%>
 	set b a#
 	set b a#s
 	set b a#w
--- ocompiler-2.orig/tests/d
+++ ocompiler-2/tests/d
@@ -1,9 +1,6 @@
 set -e
 if [ -z "${OCONV}" ]; then OCONV="${launcher} ../otoc/otoc"; fi
 . ./x ${1}
-${launcher} ${OCONV} ${1}.oc.x import
-cat ${1}.c
-z=`cat ~/s/actionswf-1/oad/cflags`
-cc -w ${z:14} ${1}.c
+./d_ $1
 mv ${1}.c .expected
 
--- /dev/null
+++ ocompiler-2/tests/d_
@@ -0,0 +1,4 @@
+${launcher} ${OCONV} ${1}.oc.x import
+cat ${1}.c
+z=`cat ~/s/actionswf-1/oad/cflags`
+cc -w ${z:14} ${1}.c
--- ocompiler-2.orig/tests/db
+++ ocompiler-2/tests/db
@@ -6,7 +6,11 @@ shift
 if [ -n "${winlauncher}" ]; then launcher=${winlauncher}; fi
 ${launcher} ${OCONV} $a.oc.x import $@
 ./c1 $a || {
-	echo enter to write, ctrl c to exit
-	read -t $((60*60*24))
-	./d $a
+	echo t enter for arm test, else write, ctrl c to exit
+	read -t $((60*60*24)) ans
+	if [ "${ans}" = t ]; then
+		./d_ $a
+	else
+		./d $a
+	fi
 }
