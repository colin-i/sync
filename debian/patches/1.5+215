+					set rem (FALSE)
+					set xlog (Xfile_action2_mults)
 				else
 					sd is_signed
 					if subtype=(cDIV)
@@ -377,6 +380,8 @@ Function twoargs_ex(sv ptrcontent,sd ptr
 
