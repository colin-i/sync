--- ocompiler-1.orig/otoc/decl.oc
+++ ocompiler-1/otoc/decl.oc
@@ -2,9 +2,9 @@
 #aftercalli
 
 function functiondef_varargs(sd outfile,sd args,sd vargs)
-	if vargs=(Xfile_function_v_no)
+	if vargs=(Xfile_function_va_no)
 		call writer(outfile)
-	else #varargs
+	else # Xfile_function_va_yes varargs
 		if args!=0
 			call writec(outfile)
 		endif
--- ocompiler-1.orig/otoc/loop.oc
+++ ocompiler-1/otoc/loop.oc
@@ -406,6 +406,9 @@ function action2(sd outfile,sv pbuffer)
 			set a2 (Xfile_action2_rem)
 			call write_longcast_uns(outfile,#replay)
 		else
+			if a2=(Xfile_action2_mults)
+				set a2 (Xfile_action2_mult)
+			end
 			call write_longcast(outfile,#replay)
 		end
 		call write(outfile,#a2,1)
