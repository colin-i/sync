--- ocompiler-1.orig/localtest
+++ ocompiler-1/localtest
@@ -1 +1 @@
-1-5+214
+1-5+215
--- ocompiler-1.orig/o.html
+++ ocompiler-1/o.html
@@ -75,7 +75,7 @@
 <p>
 	The O language use constants, variables, pointers that are octal/decimal/hexadecimal numbers.
 	<br>
-	Elf object/executable files for Linux-based systems and Exe files for Windows and can be created.
+	Elf object/executable files for Linux-based systems and Exe files for Windows and can be created. And C files with otoc.
 	<br>
 	Object files that have elf relocatable format can be created.
 	<br>
@@ -99,7 +99,7 @@
 	<br>
 	The commands are from i386 with extension for x86-64 (but with the HEX macro anything can be wrote to code section).
 	<br>
-	4 bytes variables are sign extended to 8. 1 byte variables are zero extended to 4/8 bytes when needed.
+	4 bytes variables are sign extended to 8 by default(must add unsigned notation to zero extend). 1 byte variables are zero extended to 4/8 bytes when needed(otherwise must add signed notation).
 	<a class="code">
 	o[.exe] filename [options]
 	<br>
@@ -509,7 +509,7 @@ format elfobj64<br>
 	<p>
 	3. Multiplication
 	<br>
-	Language command: <b>Mult</b>
+	Language command: <b>Mult</b> <b>MultS</b>
 	<br>
 	Example:
 	<br>
@@ -517,7 +517,8 @@ format elfobj64<br>
         Data valueA=20<br>
         Data valueB=30<br>
         Mult valueA valueB<br>
-        #the valueA will be 600</a>
+        #the valueA will be 600<br>
+        #imul at mults</a>
 	</p>
 	<p>
 	4. Division
@@ -991,7 +992,7 @@ format elfobj64<br>
 	<tr>                                                                                                                                                 <td>Xfile_include_alternative_yes</td>         <td class="red">file<sup-r>s</sup-r></td></tr>
 </table>
 <table id="selection_table">
-	<tr><td rowspan=2>Xfile_functiondef</td><td>Xfile_function_t*</td><td rowspan=2>Xfile_function_v*</td><td class="red" rowspan=2>name</td><td>Xfile_function_t_*</td><td class="blue" rowspan=2>nr_of_args</td><td class="green" rowspan=2>{D}</td></tr>
+	<tr><td rowspan=2>Xfile_functiondef</td><td>Xfile_function_t*</td><td rowspan=2>Xfile_function_va_*</td><td class="red" rowspan=2>name</td><td>Xfile_function_t_*</td><td class="blue" rowspan=2>nr_of_args</td><td class="green" rowspan=2>{D}</td></tr>
 	<tr>                                    <td>Xfile_function_e*</td></tr>
 </table>
