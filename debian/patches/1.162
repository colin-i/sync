+function get_a_swap()
+	#will be blocked by topmost size (too many function arguments). information an a() from a(a(...)) is 0x2c(44) at .x
+	if globalp.swapsdata_index<(swapsdata_max)
+		sd a;set a malloc(:*swapdata_max)
+		if a!=(NULL)
+			sv pointer=:
+			mult pointer globalp.swapsdata_index
+			add pointer #globalp.swapdsdata
+			set pointer# a
+			inc globalp.swapsdata_index
+			return a
+		end
+	end
+	call error("error at function call arguments swap")
+end
