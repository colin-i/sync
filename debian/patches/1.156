+import "error" error
+
+function sprintf_manual(ss string,ss format,sv elements)
+	ss pointer;set pointer format
+	ss cursor;set cursor string
+	sd has_element=FALSE
+	sd escaped=0
+	valueu writable_size=1
+	ss writable;set writable malloc(1)
+	vstr er="malloc error at manual sprintf"
+	if writable=(NULL)
+		call error(er)
+	end
+	while pointer#!=(Nullchar)
+		if pointer#=(Percent)
+			xor escaped 1
+		elseif escaped=1
+			set escaped 0
+			#this is not working nowadays, printf is searching for floats on xmm registers. extract floats
+			#char l="l";if pointer#=l;char f="f";ss double_test=1;add double_test pointer;if double_test#=f;inc nr;endif;endif
+
+			if has_element=(FALSE)
+				set has_element (TRUE)
+			else
+				valueu size#1;set size pointer;sub size format
+				if size>^writable_size
+					ss mem;set mem realloc(writable,size)
+					if mem=(NULL)
+						call free(writable)
+						call error(er)
+					end
+					set writable mem
+				end
+
+				dec pointer
+				#c is giving no write access to strings #set pointer# (Nullchar)
+				dec size
+				call memcpy(writable,format,size)
+				ss marker;set marker writable;add marker size;set marker# (Nullchar)
+
+				add string sprintf(string,writable,elements#)
+
+				set format pointer;incst elements
+				#set pointer# (Percent)
+				inc pointer ##not adding 2 here and continue? or let for a pointer# >= unicode start condition?
+			end
+		endelseif
+		inc pointer
+	endwhile
+	call free(writable)
+	if has_element=(TRUE)
+		call sprintf(string,format,elements#)
+	else
+		call sprintf(string,format)
 	end
 endfunction
+
