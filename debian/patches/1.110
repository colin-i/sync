+++ actionswf-1/oad/frame.oc
@@ -159,6 +159,7 @@ function preframe_free(sv pf,charx ainit
 	call free(pf)
 end
 
+const frame_text_allocpart=0x100
 function frame_init(valueu total)
 	sv f;set f malloc((\frame\))
 	if f!=(NULL)
@@ -166,10 +167,15 @@ function frame_init(valueu total)
 		mult size total
 		sv lines;set lines malloc(size)
 		if lines!=(NULL)
-			set f#:frame.lines lines
-			set f#:frame.total 0
-			#this is at end because can be truncated on last blank lines: set f#:frame.total total
-			return f
+			sv text;set text malloc((frame_text_allocpart))
+			if text!=(NULL)
+				set f#:frame.lines lines
+				set f#:frame.total 0
+				set f#:frame.text text
+				set f#:frame.size 0
+				return f
+			end
+			call free(lines)
 		end
 		call free(f)
 	end
@@ -177,6 +183,12 @@ function frame_init(valueu total)
 end
 
 import "print_inline2" print_inline2
+import "prints" prints
+import "memnl" memnl
+import "indent" indent
+
+importx "stdout" stdout
+importx "fwrite" fwrite
 
 function frame_free(sv f,charx ainit,datax log_index)
 	valueu end#1;set end f#:frame.total
@@ -211,13 +223,30 @@ function frame_free(sv f,charx ainit,dat
 	if log_index!=(no_index)
 		call print_inline2("%u,%u",n,nr_actions)
 		call print_inline_done()
+		call print("text: size=%lu <<<",f#:frame.size)
+		sv so^stdout
+
+		ss a#1;set a f#:frame.text;ss b
+		valueu c#1;set c f#:frame.size
+		valueu d#1
+		add c a
+		while a!=c
+			set d memnl(a,#b) #more in the function, \r\n example
+			sub d a
+			call indent()
+			call fwrite(a,d,1,so#)
+			call print_inline_done()
+			set a b
+		end
+
+		call prints("<<<")
 		call print_unindent()
 	end
 	call free(lines)
+	call free(f#:frame.text)
 	call free(f)
 end
 
