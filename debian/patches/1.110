 					return (EXIT_FAILURE)
 				end
 
-				while linesnr>^0
-					set p memnl(log,#next)
-					set log next
-					dec linesnr
-				end
+				valueu text#1;set text log
+				set log text_after_nlines(log,linesnr)
 
 				sv pf;sv f;set f get_nframe(ppresprites#,psprites#,preid,ainit,#pf) #and from sprites since total lines sum, but will be needed at more, anyway
 
@@ -293,7 +303,7 @@ function loop(ss log,sv x,sd xx,sd logsi
 					set p memnl(log,#next)
 					if log#=(xlog_actions)
 						inc log
-						set ok actionrow(log,p,#xcode,#xx,pf,f,strings_base,data)
+						set ok actionrow(log,p,#xcode,#xx,pf,f,strings_base,data,#text)
 						if ok!=(EXIT_SUCCESS)
