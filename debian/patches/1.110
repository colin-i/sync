 	whiletrue # break} is still with / (also resolves are there) but it is a row with \n end anyway
@@ -146,7 +146,7 @@ function actionrow(ss log,sd end,sv px,s
 	end
 	valueu number_of_lines#1;set number_of_lines memdec(start,log)
 	charx ok#1
-	set ok frame_actions(fr,number_of_lines,log,end)
+	set ok frame_actions(fr,number_of_lines,log,end,_text)
 	if ok=(EXIT_SUCCESS)
 		datax recalculation#1 #int? 16 to 8 can be almost on full ui32. a push inside an action is limited by maxuint16 totalvalues
 			#not outside actionrow? 'a','a' on multiple rows is still on same row
@@ -187,6 +187,9 @@ function actionrow(ss log,sd end,sv px,s
 			elseif log#=(xlog_branch) #branch start
 				call newbranch(px,pxx)
 				inc log
+			elseif log#=(xlog_innerbranch)
+				call newbranch(px,pxx)
+				inc log
 			elseif log#=(xlog_innerbranchend) #innerbranch end
 				call newbranch(px,pxx)
 				inc log
@@ -207,6 +210,16 @@ function actionrow(ss log,sd end,sv px,s
 	return (EXIT_FAILURE)
 end
 
+function text_after_nlines(ss inlog,valueu linesnr)
+	ss next
+	while linesnr>^0
+		call memnl(inlog,#next)
+		set inlog next
+		dec linesnr
+	end
+	return inlog
+end
+
 import "presprite_init" presprite_init
 import "presprite_done" presprite_done
 import "get_nframe" get_nframe
