 		sd xfileloc;set xfileloc destloc
+		sd is_multiline=Xfile_string_multiline_no
 	endif
 
 	add end pcontent#
 	While pcontent#!=end
 		Char byte#1
 		SetCall byte quotescaped(pcontent,psize)
+		if write_to_xfile=(TRUE)
+			if is_multiline=(FALSE)
+				whiletrue
+					if byte!=(asciireturn)
+						if byte!=(asciicarriage)
+							break
+						endif
+					endif
+					set is_multiline (Xfile_string_multiline_yes)
+					break
+				endwhile
+			endif
+		endif
 		Set destloc# byte
 		Inc destloc
 		Call stepcursors(pcontent,psize)
