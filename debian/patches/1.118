--- actionswf-1.orig/oad/Makefile
+++ actionswf-1/oad/Makefile
@@ -12,9 +12,11 @@ ifndef linkerflags
 linkerflags=-O3 -s
 endif
 ifeq (${conv_64},1) #to cross compile
-	model=-m32
-else
-	model=
+	ifneq ($(CC),arm-linux-gnueabihf-gcc)
+		model=-m32
+	endif
+#else
+#	model=
 endif
 
 OFLAGS=x_file 2
--- actionswf-1.orig/oad/frame.oc
+++ actionswf-1/oad/frame.oc
@@ -75,15 +75,15 @@ function preframe_init()
 					set pf#:preframe.log_recalculation 0
 					call tree_frame_init(pf)
 					set pf#:preframe.log_xsize 0
-					set pf#:preframe.log_branchid -1  #will inc to 0
+					set pf#:preframe.log_branchid -1  #will inc to 0 at branch_init
 				end
+				set pf#:preframe.size 0  #used at branch_init
 				set pf#:preframe.abranch branch_init(pf) #,suprabranch is not important since this is on root level and } can't happen
 				if pf#:preframe.abranch!=(NULL)
 					set pf#:preframe.ustrings ustrings
 					set pf#:preframe.ussize 0
 					set pf#:preframe.strings strings
 					set pf#:preframe.ssize 0
-					set pf#:preframe.size 0
 					return pf
 				end
 				call free(strings)
--- /dev/null
+++ actionswf-1/oad/m32dr
@@ -0,0 +1 @@
+CC=arm-linux-gnueabihf-gcc ./m32d
--- actionswf-1.orig/s32
+++ actionswf-1/s32
@@ -1,6 +1,16 @@
 
+#deb pack can make ln to normal
+reln () {
+	here=tests/.expected/${1}
+	if [ "$(stat -c %h -- "${here}")" -eq 1 ]; then
+		echo reln ${1}
+		rm tests/.expected/${1}
+		ln ../actionswf-1/tests/.expected/${1} ${here}
+	fi
+}
+reln data32.txt
+reln a.swf.x32.txt
+
 if [ -n "${mirror}" ]; then git pull local master; fi && \
 if [ -z "${1}" ]; then make clean && cd src && ./mr32d && cd ../example && ./mr32d && cd ..; fi && \
 cd ./tests/data && CC=arm-linux-gnueabihf-gcc test=32r ./b
-# and once: ln ../../actionswf-1/tests/.expected/data32.txt .expected/data32.txt
-#     and   ln ../../actionswf-1/tests/.expected/a.swf.x32.txt .expected/a.swf.x32.txt
--- actionswf-1.orig/tests/.expected/data32.txt
+++ actionswf-1/tests/.expected/data32.txt
@@ -48,7 +48,7 @@ presprites:
 			ustrings:
 			strings: _root=0x1,0 tog=0x7,0
 			asize=0x2C fasize=0x2C size=0x40
-			branch: id=0 size=0x40 aoffset=0xEC000000 code:
+			branch: id=0 size=0x40 aoffset=0x0 code:
 				........ 4F000000 01000000 07000000 00000000 BBBBBBFB 07000000 00000000 FFFFFFFF FFFFFFFF
 				........ 4F000000 01000000 07000000 00000000 BBBBBBFB 50000000 FFFFFFFF
 		frames=2
@@ -56,7 +56,7 @@ presprites:
 			ustrings:
 			strings: move=0x5,0,4,8 width=0x11,0 height=0x1F,0 lat=0x2E,0 left=0x39,2 top=0x47,6 right=0x54,0 bottom=0x6D,4 this=0x4,2,4,6,8 _x=0x9,2,4 _root=0x13,1,3,4,5,7,8 x_coef=0x19,1,3,4 _y=0x8D,6,8 y_coef=0x9E,5,7,8
 			asize=0x1A0 fasize=0x1A0 size=0x340
-			branch: id=0 size=0x104 aoffset=0x9D code:
+			branch: id=0 size=0x104 aoffset=0x0 code:
 				........ 3C000000 05000000 07000000 14000000 FFFFFFFF 3C000000 11000000 07000000 80020000 FFFFFFFF 3C000000
 				1F000000 07000000 E0010000 FFFFFFFF 3C000000 2E000000 07000000 28000000 FFFFFFFF 3C000000 39000000 1C000000
 				3E000000 FFFFFFFF 3C000000 47000000 1C000000 4B000000 FFFFFFFF 3C000000 54000000 1C000000 5A000000 0B000000
--- /dev/null
+++ actionswf-1/tests/data/a32
@@ -0,0 +1 @@
+conv_64=1 ./a $@
--- /dev/null
+++ actionswf-1/tests/data/a32r
@@ -0,0 +1 @@
+CC=arm-linux-gnueabihf-gcc ./a32 $@
