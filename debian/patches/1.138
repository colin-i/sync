 #define StateMoveTo 1
 #define StateFillStyle0 2*StateMoveTo
 #define StateFillStyle1 2*StateFillStyle0
@@ -58,7 +65,7 @@ typedef struct ButtonData_str{
 #define WasStatic 0x400
 #define HTML 0x200
