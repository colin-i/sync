+function translate_give(ss indents,ss name)
+	if name#!=(Nullchar)
+		ss cursor
+		set cursor semicolon(indents)
+		if cursor!=indents
+			set cursor# (Nullchar)
+			inc cursor
+			char ar="Array"
+			sd ?c
+			set c strcmp(name,#ar,\.ar)
+			sd ?len
+			ss type
+			if c=0
+				set type "<Dynamic>"
+			else
+				set type #globalt.blank
+			end
+			set len snprintf(globalt.a_page_switch,(a_page_size),"%s:%s%s%c%s",indents,name,type,(Semicolon),cursor)
+			if len>0
+				if len<(a_page_size)
+					call translated("Give")
+					return globalt.a_page_switch
+				end
+			end
+		end
+	end
+	return name
+end
+
+function translate_alpha(ss indents)
+	ss cursor;set cursor spcfull(indents)
+	set cursor# (Nullchar)
+	inc cursor
+	sd ?c
+	ss sizer=6
+	char against="alpha="^
+	set c strncmp(cursor,#against,sizer)
+	if c=0
+		add sizer cursor
+		ss pointer
+		set pointer semicolon(sizer)
+		if pointer!=sizer
+			set pointer# (Nullchar)
+			inc pointer
+			sd ?len
+			set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s/100;%s",indents,cursor,pointer)
+			if len>0
+				if len<(a_page_size)
+					call translated("Alpha")
+					return globalt.a_page_switch
+				end
+			end
+		end
+	end
+	return indents
+end
+
+function translate_compare(ss start)
+	ss cursor
+	set cursor pareoafter(start)
+	if cursor!=start
+		ss end
+		set end strchr(cursor,(Nullchar))
+		whiletrue
+			dec end
+			if end=cursor
+				break
+			end
+			if end#=(Closeparenthesis)
+				set end# (Nullchar)
+				inc end
+				sd ?len
+				if cursor#=(Exclamationmark)
+					set cursor# (Nullchar)
+					inc cursor
+					set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s==0%c%s",start,cursor,(Closeparenthesis),end)
+				else
+					set len snprintf(globalt.a_page_switch,(a_page_size),"%s!=0%c%s",start,(Closeparenthesis),end)
+				end
+				if len>0
+					if len<(a_page_size)
+						call translated("Compare")
+						return globalt.a_page_switch
+					end
+				end
+				break
+			end
+		end
+	end
+	return start
+end
