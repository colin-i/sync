+function translate_var_arguments(ss start,ss out,sd p_len)
+	ss cursor
+	ss first;set first out
+	sd ?len
+	sd ?size=a_page_size
+	ss pointer
+	set pointer start
+	whiletrue
+		set cursor equalafter(pointer)
+		if cursor!=pointer
+			set pointer semicolon(cursor)
+			if pointer!=cursor
+				set pointer# (Nullchar)
+				ss c
+				if out=first
+					add out p_len#
+					sub size p_len#
+					set c #globalt.blank
+				else
+					add out len
+					sub size len
+					set c ","
 				end
-			else #going on createEmptyMovieClip
-				set cursor translate_leftright(#globalt.var_translate,indents,#globalt.blank,cls,"flash.display.Shape",globalt.a_page_switch) #,pointer)
-				if cursor!=#globalt.blank
-					call translated("VarCreate")
-					return cursor
+				set len snprintf(out,p_len#,globalt.double_s,c,cursor)
+				if len>0
+					if len<size
+						add p_len# len
+						inc pointer
+						continue
+					end
 				end
+				return start
 			end
 		end
+		break
 	end
-	return indents
+	return out
+end
+function translate_var_named(ss cursor,sd ?len,ss oa,ss pointer,ss ok,ss bad_return)
+	ss end
+	set end commaon(pointer)
+	set end# (Nullchar)
+	ss extra;set extra cursor
+	add extra len
+	sd ?size=a_page_size
+	sub size len
+	set len snprintf(extra,size,"%s.name='%s'%s;",oa,oa,pointer)
+	if len>0
+		if len<size
+			call translated(ok)
+			return cursor
+		end
+	end
+	return bad_return
 end
 
