+function translate_new(ss start)
+	ss cursor
+	set cursor spcfull(start)
+	ss ?reminder
+	set reminder cursor#
+	char a#2;ss b^a
+	if reminder!=(Nullchar)
+		set cursor# (Nullchar)
+		inc cursor
+		set b# reminder
+		inc b
+	end
+	set b# (Nullchar)
+	sd ?len;set len snprintf(globalt.a_page_switch,(a_page_size),"%s%s %s%s",start,#globalt.nw,#a,cursor)
+	if len>0
+		if len<(a_page_size)
+			call translated("New")
+			return globalt.a_page_switch
+		end
+	end
+	return start
+end
