--- actionswf-1.orig/csrc/Makefile
+++ actionswf-1/csrc/Makefile
@@ -2,9 +2,6 @@
 ifndef platform
 platform=lin
 endif
-ifndef OCOMP
-OCOMP=o
-endif
 ifndef OCONV
 OCONV=otoc
 endif
@@ -20,6 +17,8 @@ endif
 
 items_prefix=../src/
 include ../src/items
+exte=libexte.a
+proj=libactionswf.so
 
 $(eval xfiles = )
 $(foreach var,$(expitems),$(eval xfiles += ${items_prefix}${var}.e.oc.x))
@@ -32,17 +31,21 @@ ifeq (${conv_64},1) #to cross compile
 	ifneq ($(CC),arm-linux-gnueabihf-gcc)
 		model=-m32
 	endif
-else
-	ifeq (${platform},win) #to long long
-		OCONVFLAGS=-
-	endif
+#else
+#	ifeq (${platform},win) #to long long
+#		OCONVFLAGS=-
+#	endif
 endif
 
 OFLAGS=x_file 2
 
-all: libactionswf.so
-
-libactionswf.so: headers ${obs} ${eobs}
+all: headers ${proj}
+#can't put headers at proj, will phony libactionswf.so
+${proj}: ${exte} ${eobs}
+	${OLINK} ${logs}
+	$(CC) ${model} ${linkerflags} -shared ${eobs} -o $@ -L. -l:${exte} -e DllMain -Wl,--exclude-libs=${exte}
+${exte}: ${obs}
+	$(AR) cr ${exte} $^
 
 headers:
 	$(MAKE) -C ../include
@@ -56,7 +59,7 @@ headers:
 clean:
 	$(MAKE) -C ../include clean
 	$(MAKE) -C ../dev clean-csrc
-	-rm -f ${obs} ${eobs} ${logs}
+	-rm -f ${obs} ${eobs} ${logs} ${exte} ${proj}
 	-rm -f ${xfiles} ${cfiles}
 distclean: clean
 
